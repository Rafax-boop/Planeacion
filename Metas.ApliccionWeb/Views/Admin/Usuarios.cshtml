@using Metas.AplicacionWeb.Models.ViewModels
@model List<VMUsuario>
@{
    ViewData["Title"] = "Creación de Usuarios";
}

<div class="titulo-vista-wrap">
    <h1 class="titulo-vista">Creación de Usuarios</h1>
    <span class="subtitulo-vista">- Administra los usuarios que tienen acceso al sistema.</span>
</div>

@{
    var areasDisponibles = (Model ?? new List<VMUsuario>())
        .Select(u => u.Area)
        .Where(a => !string.IsNullOrWhiteSpace(a))
        .Distinct()
        .OrderBy(a => a)
        .ToList();
}

<div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-3">
    <div class="filtros-container mb-0">
        <div class="filtro-grupo" style="flex: 0 0 550px; min-width: 550px; max-width: 550px;">
            <label for="selectAreaFiltro">Área</label>
            <select id="selectAreaFiltro" class="select2-simple">
                <option value="">Todas</option>
                @foreach (var area in areasDisponibles)
                {
                    <option value="@area">@area</option>
                }
            </select>
        </div>
    </div>
    <button class="btn-app-rosa" type="button" data-bs-toggle="modal" data-bs-target="#ModalUsuario">
        <i class="fa-solid fa-user-plus"></i> Crear Usuario
    </button>
</div>

@if (Model == null || !Model.Any())
{
    <div class="sin-registros">
        <i class="bi bi-clipboard2-x"></i><br>
        <span>Sin usuarios registrados.</span>
    </div>
}
else
{
    <div class="tabla-datos-wrap">
        <table class="tabla-datos" id="tablaDatos">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Usuario</th>
                    <th>Contraseña</th>
                    <th>Área</th>
                    <th class="text-center">Rol</th>
                    <th class="text-center">Activo</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody id="tablaUsuarios">
                @foreach (var usuario in Model)
                {
                    <tr data-area="@usuario.Area">
                        <td>@usuario.IdUsuario</td>
                        <td>@usuario.Usuario1</td>
                        <td>@usuario.Pass</td>
                        <td>@usuario.Area</td>
                        <td class="text-center">@usuario.Definicion</td>
                        <td class="text-center">
                            @if (usuario.Activo == true)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactivo</span>
                            }
                        </td>
                        <td>
                            <div class="acciones-grupo">
                                <button type="button" class="btn-accion btn-accion-editar" title="Editar" data-bs-toggle="tooltip" data-bs-placement="top"
                                        onclick="cargarDatosUsuario(@usuario.IdUsuario, '@usuario.Usuario1', '@usuario.Pass', '@usuario.Definicion', '@usuario.Area', @((usuario.Activo ?? true).ToString().ToLower()))">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div id="tablaDatos-paginacion" class="tabla-paginacion"></div>
}

<div class="modal fade" id="ModalUsuario" tabindex="-1" aria-labelledby="miModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="miModalLabel">Creación de usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formCrearUsuario">
                <div class="modal-body">
                    <label class="form-label fw-semibold">Nombre</label>
                    <input type="text" class="form-control mb-3" id="txtUsuario" name="Usuario1" />

                    <label class="form-label fw-semibold">Contraseña</label>
                    <input type="text" class="form-control mb-3" id="txtPassword" name="Pass" />

                    <label class="form-label fw-semibold">Tipo</label>
                    <select class="form-select mb-3" id="selectTipo" name="Definicion">
                        <option value="">Seleccione Tipo de Usuario</option>
                        <option value="Dirección">Dirección</option>
                        <option value="Unidad">Unidad</option>
                        <option value="Departamento">Departamento</option>
                    </select>

                    <label class="form-label fw-semibold">Área</label>
                    <select class="form-select mb-3" id="selectArea" name="Area">
                        <option value="">Seleccione Área</option>
                    </select>

                    <div class="form-check form-switch">
                        <input type="hidden" id="hiddenActivo" name="Activo" value="true">
                        <input class="form-check-input" type="checkbox" role="switch" id="chkActivo" checked>
                        <label class="form-check-label fw-semibold" for="chkActivo">Activo</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-app-gris" data-bs-dismiss="modal">Cerrar</button>
                    <button type="submit" class="btn-app-rosa" id="btnGuardar">Crear Usuario</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="ModalEditarUsuario" tabindex="-1" aria-labelledby="miModalEditarLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="miModalEditarLabel">Editar usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formEditarUsuario">
                <div class="modal-body">
                    <input type="hidden" id="txtIdUsuarioEditar" name="IdUsuario" />

                    <label class="form-label fw-semibold">Nombre</label>
                    <input type="text" class="form-control mb-3" id="txtUsuarioEditar" name="Usuario1" />

                    <label class="form-label fw-semibold">Contraseña</label>
                    <input type="text" class="form-control mb-3" id="txtPasswordEditar" name="Pass" />

                    <label class="form-label fw-semibold">Tipo</label>
                    <select class="form-select mb-3" id="selectTipoEditar" name="Definicion">
                        <option value="">Seleccione Tipo de Usuario</option>
                        <option value="Dirección">Dirección</option>
                        <option value="Unidad">Unidad</option>
                        <option value="Departamento">Departamento</option>
                    </select>

                    <label class="form-label fw-semibold">Área</label>
                    <select class="form-select mb-3" id="selectAreaEditar" name="Area">
                        <option value="">Seleccione Área</option>
                    </select>

                    <div class="form-check form-switch">
                        <input type="hidden" id="hiddenActivoEditar" name="Activo" value="true">
                        <input class="form-check-input" type="checkbox" role="switch" id="chkActivoEditar" checked>
                        <label class="form-check-label fw-semibold" for="chkActivoEditar">Activo</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-app-gris" data-bs-dismiss="modal">Cerrar</button>
                    <button type="submit" class="btn-app-rosa" id="btnGuardarEditar">Guardar cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Cargar áreas según el tipo (reutilizable para crear y editar)
        function cargarAreasPorTipo($selectArea, tipo, areaAPreseleccionar) {
            $selectArea.empty().append('<option value="">Seleccione Area</option>');
            if (!tipo) return;

            $.ajax({
                type: 'POST',
                url: '/Admin/GetTipo',
                data: { id: tipo },
                dataType: 'json',
                success: function (states) {
                    $.each(states, function (i, state) {
                        $selectArea.append('<option value="' + state.value + '">' +
                            state.text + '</option>');
                    });
                    if (areaAPreseleccionar) {
                        $selectArea.val(areaAPreseleccionar);
                    }
                },
                error: function (xhr) {
                    console.error('Error:', xhr);
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Error al cargar las áreas',
                        confirmButtonText: 'Entendido'
                    });
                }
            });
        }

        // Abre la modal de edición y precarga los datos del usuario
        function cargarDatosUsuario(id, usuario, pass, definicion, area, activo) {
            $('#txtIdUsuarioEditar').val(id);
            $('#txtUsuarioEditar').val(usuario);
            $('#txtPasswordEditar').val(pass);
            $('#selectTipoEditar').val(definicion);
            cargarAreasPorTipo($('#selectAreaEditar'), definicion, area);

            var esActivo = activo === undefined ? true : activo;
            $('#hiddenActivoEditar').val(esActivo);
            $('#chkActivoEditar').prop('checked', esActivo);

            var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('ModalEditarUsuario'));
            modal.show();
        }

        // Filtro por Área
        function filtrarPorArea() {
            var tabla = document.getElementById('tablaDatos');
            if (!tabla) return;

            var areaFiltro = $('#selectAreaFiltro').val() || '';

            var filas = tabla.querySelectorAll('tbody tr');
            filas.forEach(function (fila) {
                var pasaArea = !areaFiltro || fila.getAttribute('data-area') === areaFiltro;
                fila.style.display = pasaArea ? '' : 'none';
            });

            TablaPaginada.actualizar('tablaDatos');
        }

        $(document).ready(function() {
            $('[data-bs-toggle="tooltip"]').each(function () {
                bootstrap.Tooltip.getOrCreateInstance(this);
            });

            $('.select2-simple').select2({ width: '100%', language: 'es', minimumResultsForSearch: 8 });

            TablaPaginada.iniciar('tablaDatos', { pageSize: 10 });

            $('#selectAreaFiltro').on('change', filtrarPorArea);

            $("#selectTipo").change(function () {
                cargarAreasPorTipo($('#selectArea'), $(this).val(), null);
            });

            $("#selectTipoEditar").change(function () {
                cargarAreasPorTipo($('#selectAreaEditar'), $(this).val(), null);
            });

            // Sincronizar checkbox de Activo con su campo oculto
            $('#chkActivo').on('change', function () {
                $('#hiddenActivo').val($(this).is(':checked'));
            });

            $('#chkActivoEditar').on('change', function () {
                $('#hiddenActivoEditar').val($(this).is(':checked'));
            });

            // Crear usuario con AJAX
            $("#formCrearUsuario").submit(function (e) {
                e.preventDefault();

                $('#hiddenActivo').val($('#chkActivo').is(':checked'));

                var camposValidos = validarCamposRequeridos([
                    { label: 'Nombre de usuario', campoId: 'txtUsuario', valido: !!$('#txtUsuario').val().trim() },
                    { label: 'Contraseña', campoId: 'txtPassword', valido: !!$('#txtPassword').val().trim() },
                    { label: 'Tipo de usuario', campoId: 'selectTipo', valido: !!$('#selectTipo').val() },
                    { label: 'Área', campoId: 'selectArea', valido: !!$('#selectArea').val() }
                ]);
                if (!camposValidos) return;

                confirmarGuardado('Se creará el nuevo usuario con los datos capturados.').then(function (confirmado) {
                    if (!confirmado) return;

                    var formData = $('#formCrearUsuario').serialize();
                    $("#btnGuardar").prop('disabled', true).text('Guardando...');

                    $.ajax({
                        type: 'POST',
                        url: '/Admin/Crear',
                        data: formData,
                        dataType: 'json',
                        success: function (response) {
                            $("#ModalUsuario").modal('hide');
                            $("#formCrearUsuario")[0].reset();
                            Toast.fire({ icon: 'success', title: response.mensaje || 'Usuario creado' }).then(() => location.reload());
                        },
                        error: function (xhr) {
                            var error = xhr.responseJSON;
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: error?.mensaje || 'Error al crear usuario',
                                confirmButtonText: 'Entendido'
                            });
                        },
                        complete: function() {
                            $("#btnGuardar").prop('disabled', false).text('Crear Usuario');
                        }
                    });
                });
            });

            // Editar usuario con AJAX
            $("#formEditarUsuario").submit(function (e) {
                e.preventDefault();

                $('#hiddenActivoEditar').val($('#chkActivoEditar').is(':checked'));

                var camposValidos = validarCamposRequeridos([
                    { label: 'Nombre de usuario', campoId: 'txtUsuarioEditar', valido: !!$('#txtUsuarioEditar').val().trim() },
                    { label: 'Contraseña', campoId: 'txtPasswordEditar', valido: !!$('#txtPasswordEditar').val().trim() },
                    { label: 'Tipo de usuario', campoId: 'selectTipoEditar', valido: !!$('#selectTipoEditar').val() },
                    { label: 'Área', campoId: 'selectAreaEditar', valido: !!$('#selectAreaEditar').val() }
                ]);
                if (!camposValidos) return;

                confirmarGuardado('Se actualizarán los datos de este usuario.').then(function (confirmado) {
                    if (!confirmado) return;

                    var formData = $('#formEditarUsuario').serialize();
                    $("#btnGuardarEditar").prop('disabled', true).text('Guardando...');

                    $.ajax({
                        type: 'PUT',
                        url: '/Admin/EditarUsuario',
                        data: formData,
                        dataType: 'json',
                        success: function (response) {
                            $("#ModalEditarUsuario").modal('hide');
                            Toast.fire({ icon: 'success', title: response.mensaje || 'Usuario editado' }).then(() => location.reload());
                        },
                        error: function (xhr) {
                            var error = xhr.responseJSON;
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: error?.mensaje || 'Error al editar usuario',
                                confirmButtonText: 'Entendido'
                            });
                        },
                        complete: function() {
                            $("#btnGuardarEditar").prop('disabled', false).text('Guardar cambios');
                        }
                    });
                });
            });
        });

    </script>
}
