@using Metas.AplicacionWeb.Models.ViewModels
@model List<VMFechas>
@{
    ViewData["Title"] = "Fecha Captura";
}

<div class="titulo-vista-wrap">
    <h1 class="titulo-vista">Fecha de Captura</h1>
    <span class="subtitulo-vista">- Administra el periodo de captura habilitado para cada mes.</span>
</div>

@if (Model == null || !Model.Any())
{
    <div class="sin-registros">
        <i class="bi bi-clipboard2-x"></i><br>
        <span>Sin fechas registradas.</span>
    </div>
}
else
{
    <div class="tabla-datos-wrap">
        <table class="tabla-datos" id="tablaDatos">
            <thead>
                <tr>
                    <th>Fecha Inicio</th>
                    <th>Fecha Término</th>
                    <th>Mes</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fecha in Model)
                {
                    <tr>
                        <td>@fecha.FechaInicio</td>
                        <td>@fecha.FechaFin</td>
                        <td>@fecha.Mes</td>
                        <td>
                            <div class="acciones-grupo">
                                <button type="button" class="btn-accion btn-accion-editar" title="Editar" data-bs-toggle="tooltip" data-bs-placement="top"
                                        onclick="cargarDatosFecha('@fecha.IdFechaCaptura', '@fecha.FechaInicio.ToString("yyyy-MM-dd")', '@fecha.FechaFin.ToString("yyyy-MM-dd")')">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div id="tablaDatos-paginacion" class="tabla-paginacion"></div>
}

<div class="modal fade" id="ModalFecha" tabindex="-1" aria-labelledby="miModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="miModalLabel">Editar Fechas</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formEditar">
                <div class="modal-body">
                    <input type="hidden" id="txtIdFechaCaptura" name="IdFechaCaptura" />

                    <label class="form-label fw-semibold">Fecha Inicio</label>
                    <input type="date" class="form-control mb-3" id="txtFechaInicio" name="FechaInicio" required />

                    <label class="form-label fw-semibold">Fecha Término</label>
                    <input type="date" class="form-control" id="txtFechaFin" name="FechaFin" required />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-app-gris" data-bs-dismiss="modal">Cerrar</button>
                    <button type="submit" class="btn-app-rosa" id="btnEditar">Editar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function cargarDatosFecha(id, fechaInicio, fechaFin, ano) {
            document.getElementById('txtIdFechaCaptura').value = id;
            document.getElementById('txtFechaInicio').value = fechaInicio;
            document.getElementById('txtFechaFin').value = fechaFin;

            var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('ModalFecha'));
            modal.show();
        }

        $(document).ready(function () {
            $('[data-bs-toggle="tooltip"]').each(function () {
                bootstrap.Tooltip.getOrCreateInstance(this);
            });

            TablaPaginada.iniciar('tablaDatos', { pageSize: 10 });
        });

        // Limpiar el formulario cuando se cierra el modal
        document.getElementById('ModalFecha').addEventListener('hidden.bs.modal', function () {
            document.getElementById('formEditar').reset();
        });

        $("#formEditar").submit(function (e) {
            e.preventDefault();
            var formData = $(this).serialize();
            $("#btnEditar").prop('disabled', true).text('Editando...');

            $.ajax({
                type: 'PUT',
                url: '/Admin/Editar',
                data: formData,
                dataType: 'json',
                success: function (response) {
                    Swal.fire({
                        icon: 'success',
                        title: '¡Éxito!',
                        text: response.mensaje,
                        confirmButtonText: 'Aceptar'
                    }).then(() => {
                        $("#ModalFecha").modal('hide');
                        $("#formEditar")[0].reset();
                        location.reload();
                    });
                },
                error: function (xhr) {
                    var error = xhr.responseJSON;
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: error?.mensaje || 'Error al editar fechas',
                        confirmButtonText: 'Entendido'
                    });
                },
                complete: function() {
                    $("#btnEditar").prop('disabled', false).text('Editar');
                }
            });
        });
    </script>
}
