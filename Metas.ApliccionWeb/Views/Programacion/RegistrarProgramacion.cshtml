@model Metas.AplicacionWeb.Models.ViewModels.VMProgramacion

@{
    ViewData["Title"] = "Registrar Programación";
}

<div class="container-fluid mt-4">
    <div class="titulo-vista-wrap ficha-titulo-wrap">
        <h1 class="titulo-vista">Ficha Técnica de Actividades</h1>
    </div>

    @* Datos del solicitante *@
    <div class="ficha-solicitante">
        <div class="ficha-solicitante-tab">
            <h2>Datos del solicitante</h2>
        </div>

        <div class="ficha-solicitante-body">
            <div class="campo-ficha">
                <div class="campo-ficha-label campo-ficha-label-corta">1. FECHA DE ELABORACIÓN</div>
                <div class="campo-ficha-control fw-semibold">@DateTime.Now.ToString("dd/MM/yyyy")</div>
            </div>

            <div class="campo-ficha">
                <div class="campo-ficha-label campo-ficha-label-corta">2. NOMBRE DEL ÁREA OPERATIVA RESPONSABLE (AOR)</div>
                <div class="campo-ficha-control">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small text-muted mb-1">Área</label>
                            <textarea disabled class="form-control fw-semibold" rows="2" id="inputArea">@Model.AreaNombre</textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted mb-1">Departamento</label>
                            <textarea disabled class="form-control fw-semibold" rows="2" id="inputDepartamento">@Model.DepartamentoNombre</textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="campo-ficha" style="border-bottom:none;">
                <div class="campo-ficha-label campo-ficha-label-corta">3. CORREO ELECTRÓNICO</div>
                <div class="campo-ficha-control">
                    <input type="email" class="form-control" placeholder="ejemplo@correo.com" id="inputCorreo" value="@Model.CorreoContacto">
                </div>
            </div>
        </div>
    </div>

    @* Datos de la solicitud *@
    <div class="ficha-seccion">
        <h5 class="ficha-seccion-titulo">Datos de la solicitud</h5>

        <div class="campo-ficha">
            <div class="campo-ficha-label">4. PROGRAMA PRESUPUESTARIO / AGENDA INSTITUCIONAL</div>
            <div class="campo-ficha-control">
                <select class="form-control select2-simple" required id="selectPrograma" name="selectPrograma">
                    <option value="">Seleccione Programa</option>
                    @foreach (var act in Model.ListaProgramas)
                    {
                        <option value="@act.Value">@act.Text</option>
                    }
                </select>
            </div>
        </div>

        <div class="campo-ficha">
            <div class="campo-ficha-label">5. NÚMERO DE COMPONENTE</div>
            <div class="campo-ficha-control">
                <select class="form-control select2-simple" id="selectComponente" name="selectComponente" disabled>
                    <option value="">-- Selecciona componente --</option>
                    @foreach (var componente in Model.ListaComponentes)
                    {
                        <option value="@componente.Value" data-programa="@componente.Group.Name">
                            @componente.Text
                        </option>
                    }
                </select>
            </div>
        </div>

        <div class="campo-ficha">
            <div class="campo-ficha-label">6. NÚMERO DE ACTIVIDAD</div>
            <div class="campo-ficha-control">
                <input type="number" required class="form-control" id="inputActividad">
            </div>
        </div>

        @* Justificacion *@
        <div class="campo-ficha">
            <div class="campo-ficha-label">7. JUSTIFICACIÓN</div>
            <div class="campo-ficha-control">
                <textarea required class="form-control" rows="2" id="inputJustificacion"></textarea>
            </div>
        </div>

        @* Documentacion soporte de la justificacion *@
        <div class="campo-ficha">
            <div class="campo-ficha-label">8. DOCUMENTACIÓN SOPORTE DE LA JUSTIFICACIÓN</div>
            <div class="campo-ficha-control">
                <textarea required class="form-control" rows="2" id="inputDocumentacion"></textarea>
            </div>
        </div>

        @* Origen de recursos *@
        <div class="campo-ficha" style="border-bottom:none;">
            <div class="campo-ficha-label">9. ORIGEN DE RECURSOS</div>
            <div class="campo-ficha-control">
                <div class="row g-3">
                    <div class="col-6">
                        <label class="form-label small text-muted mb-1">Recurso Federal</label>
                        <select required class="form-control select2-simple" id="selectFederal">
                            <option value="">Seleccione</option>
                            <option value="Si">Sí</option>
                            <option value="No">No</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label small text-muted mb-1">Recurso Estatal</label>
                        <select required class="form-control select2-simple" id="selectEstatal">
                            <option value="">Seleccione</option>
                            <option value="Si">Sí</option>
                            <option value="No">No</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Datos generales *@
    <div class="titulo-vista-wrap ficha-titulo-wrap">
        <h2 class="titulo-vista" style="font-size:1.1rem;">Datos Generales</h2>
    </div>

    <div class="ficha-seccion">
        <div class="campo-ficha">
            <div class="campo-ficha-label">10. PROGRAMA SOCIAL, SERVICIO Y/O PROYECTO</div>
            <div class="campo-ficha-control">
                <textarea required id="inputPrograma" class="form-control" rows="2"></textarea>
            </div>
        </div>
        <div class="campo-ficha">
            <div class="campo-ficha-label">11. DESCRIPCIÓN DE LA ACTIVIDAD</div>
            <div class="campo-ficha-control">
                <textarea required id="inputDescripcion" class="form-control" rows="2"></textarea>
            </div>
        </div>
        <div class="campo-ficha">
            <div class="campo-ficha-label">12. NOMBRE DEL INDICADOR</div>
            <div class="campo-ficha-control">
                <textarea required id="inputIndicador" class="form-control" rows="2"></textarea>
            </div>
        </div>
        <div class="campo-ficha">
            <div class="campo-ficha-label">13. DEFINICIÓN DEL INDICADOR</div>
            <div class="campo-ficha-control">
                <textarea required id="inputDefinicion" class="form-control" rows="2"></textarea>
            </div>
        </div>

        @* Calendarización *@
        <div class="campo-ficha">
            <div class="campo-ficha-label">14. CALENDARIZACIÓN</div>
        </div>

        <div class="row mb-2">
            <div class="col-md-3"></div>
            <div class="col-md-2"><div class="ficha-trimestre-header">1ER TRIMESTRE</div></div>
            <div class="col-md-2"><div class="ficha-trimestre-header">2DO. TRIMESTRE</div></div>
            <div class="col-md-2"><div class="ficha-trimestre-header">3ER. TRIMESTRE</div></div>
            <div class="col-md-2"><div class="ficha-trimestre-header">4TO. TRIMESTRE</div></div>
        </div>

        @* Fila para SERVICIOS *@
        <div class="row align-items-center pb-2 mb-2">
            <div class="col-md-3 text-center">
                <label class="fw-light">SERVICIOS</label>
            </div>
            <div class="col-md-2">
                <input type="text" disabled id="primerServicio" class="form-control text-center" value="0" min="0">
            </div>
            <div class="col-md-2">
                <input type="text" disabled id="segundoServicio" class="form-control text-center" value="0" min="0">
            </div>
            <div class="col-md-2">
                <input type="text" disabled id="tercerServicio" class="form-control text-center" value="0" min="0">
            </div>
            <div class="col-md-2">
                <input type="text" disabled id="cuartoServicio" class="form-control text-center" value="0" min="0">
            </div>
        </div>

        @* Fila para PERSONAS *@
        <div class="row align-items-center mb-3">
            <div class="col-md-3 text-center">
                <label class="fw-light">PERSONAS</label>
            </div>
            <div class="col-md-2">
                <input type="text" disabled id="primerPersona" class="form-control text-center formato-miles" value="0" min="0">
            </div>
            <div class="col-md-2">
                <input type="text" disabled id="segundoPersona" class="form-control text-center formato-miles" value="0" min="0">
            </div>
            <div class="col-md-2">
                <input type="text" disabled id="tercerPersona" class="form-control text-center formato-miles" value="0" min="0">
            </div>
            <div class="col-md-2">
                <input type="text" disabled id="cuartoPersona" class="form-control text-center formato-miles" value="0" min="0">
            </div>
        </div>

        <div class="campo-ficha">
            <div class="campo-ficha-label">15. UNIDAD DE MEDIDA</div>
            <div class="campo-ficha-control">
                <select required class="form-control select2-simple" id="selectMedida">
                    <option value="">Seleccione opción</option>
                    @foreach (var act in Model.ListaMedidas)
                    {
                        <option value="@act.Value">@act.Text</option>
                    }
                </select>
            </div>
        </div>

        <div class="campo-ficha">
            <div class="campo-ficha-label">16. MEDIOS DE VERIFICACIÓN</div>
            <div class="campo-ficha-control">
                <textarea required id="inputMedios" class="form-control" rows="2"></textarea>
            </div>
        </div>

        <div class="campo-ficha">
            <div class="campo-ficha-label">17. SERIE DE INFORMACIÓN DISPONIBLE</div>
            <div class="campo-ficha-control">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small text-muted mb-1">Desde</label>
                        <select required class="form-control select2-simple" id="selectDesde">
                            <option value="">Seleccione Desde</option>
                            @{
                                var anoActual = DateTime.Now.Year;
                                var anoMinimo = anoActual - 5;

                                for (int ano = anoActual; ano >= anoMinimo; ano--)
                                {
                                    <option value="@ano">@ano</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small text-muted mb-1">Hasta</label>
                        <select class="form-control select2-simple" id="selectHasta">
                            <option value="">Seleccione Hasta</option>
                            @{
                                for (int ano = anoActual; ano >= anoMinimo; ano--)
                                {
                                    <option value="@ano">@ano</option>
                                }
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="campo-ficha">
            <div class="campo-ficha-label">18. FUENTES DE INFORMACIÓN</div>
            <div class="campo-ficha-control">
                <textarea required id="inputFuentes" class="form-control" rows="2"></textarea>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 border-end">
                <div class="campo-ficha" style="border-bottom:none;">
                    <div class="campo-ficha-label campo-ficha-label-corta">19. INTERVIENEN DELEGACIONES REGIONALES</div>
                    <div class="campo-ficha-control">
                        <select id="selectDelegaciones" class="form-control select2-simple">
                            <option value="">Seleccione</option>
                            <option value="Si">Sí</option>
                            <option value="No">No</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="campo-ficha" style="border-bottom:none;">
                    <div class="campo-ficha-label campo-ficha-label-corta">20. ¿DE QUÉ MANERA?</div>
                    <div class="campo-ficha-control">
                        <textarea id="inputDelegaciones" class="form-control" rows="2"></textarea>
                    </div>
                </div>
            </div>
        </div>
    </div>


    @* Determinación de Metas *@
    <div class="ficha-seccion">
        <h5 class="ficha-seccion-titulo">Determinación de Metas</h5>

        <div class="row">
            <div class="col-md-6 border-end">
                <div class="ficha-seccion-subtitulo">Línea Base</div>

                <div class="campo-ficha">
                    <div class="campo-ficha-label campo-ficha-label-corta">21. AÑO</div>
                    <div class="campo-ficha-control">
                        <select class="form-control select2-simple" id="selectAnoBase">
                            <option value="">Seleccione Año</option>
                            @{
                                for (int ano = anoActual; ano >= anoMinimo; ano--)
                                {
                                    <option value="@ano">@ano</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="campo-ficha">
                    <div class="campo-ficha-label campo-ficha-label-corta">22. PORCENTAJE DE CUMPLIMIENTO</div>
                    <div class="campo-ficha-control">
                        <input id="inputPorcentajeBase" type="number" class="form-control text-center" value="0" min="0" max="100">
                    </div>
                </div>

                <div class="campo-ficha">
                    <div class="campo-ficha-label campo-ficha-label-corta">23. NO. DE BIEN O SERVICIO ENTREGADO</div>
                    <div class="campo-ficha-control">
                        <input id="inputServicioBase" type="text" class="form-control text-center formato-miles" value="0" min="0">
                    </div>
                </div>

                <div class="campo-ficha" style="border-bottom:none;">
                    <div class="campo-ficha-label campo-ficha-label-corta">24. NO. DE PERSONAS ATENDIDAS</div>
                    <div class="campo-ficha-control">
                        <input id="inputPersonasBase" type="text" class="form-control text-center formato-miles" value="0" min="0">
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="ficha-seccion-subtitulo">Meta y Periodo de Cumplimiento</div>

                <div class="campo-ficha">
                    <div class="campo-ficha-label campo-ficha-label-corta">25. AÑO</div>
                    <div class="campo-ficha-control">
                        <input id="inputAnoMeta" type="text" class="form-control text-center fw-semibold" value="@Model.AnoFiscal" disabled readonly>
                    </div>
                </div>

                <div class="campo-ficha">
                    <div class="campo-ficha-label campo-ficha-label-corta">26. PORCENTAJE DE CUMPLIMIENTO</div>
                    <div class="campo-ficha-control">
                        <input id="inputPorcentajeMeta" disabled type="number" class="form-control text-center" value="0" min="0" max="100">
                    </div>
                </div>

                <div class="campo-ficha">
                    <div class="campo-ficha-label campo-ficha-label-corta">27. NO. DE BIEN O SERVICIO A ENTREGAR</div>
                    <div class="campo-ficha-control">
                        <input id="inputServicioMeta" disabled type="text" class="form-control text-center formato-miles" value="0" min="0">
                    </div>
                </div>

                <div class="campo-ficha" style="border-bottom:none;">
                    <div class="campo-ficha-label campo-ficha-label-corta">28. NO. DE PERSONAS POR ATENDER</div>
                    <div class="campo-ficha-control">
                        <input id="inputServicioMetas" disabled type="text" class="form-control text-center formato-miles" value="0" min="0">
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Meta Anual *@
    <div class="ficha-seccion" id="metaAnualForm">
        <h5 class="ficha-seccion-titulo">Meta Anual</h5>

        @* Sección Bien/Servicio y Personas *@
        <div class="row border-bottom pb-3 mb-3">
            <div class="col-md-6 border-end">
                <div class="campo-ficha" style="border-bottom:none; padding-top:0;">
                    <div class="campo-ficha-label campo-ficha-label-corta">29. BIEN O SERVICIO</div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="campo-ficha" style="padding-top:0;">
                    <div class="campo-ficha-label campo-ficha-label-corta">30. PERSONAS</div>
                    <div class="campo-ficha-control">
                        <select class="form-control select2-simple" id="selectPersonas">
                            <option value="">Seleccione Personas / Instituciones</option>
                            <option value="Personas">Personas</option>
                            <option value="Instituciones">Instituciones</option>
                        </select>
                    </div>
                </div>
                <div class="campo-ficha" style="border-bottom:none;">
                    <div class="campo-ficha-label campo-ficha-label-corta">Acumulable</div>
                    <div class="campo-ficha-control">
                        <select class="form-control select2-simple" id="selectAcumulable">
                            <option value="">Seleccione opción</option>
                            <option value="no">No</option>
                            <option value="si">Sí</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        @* Sección Meses *@
        <div>
            @{
                var mesesPrimerSemestre = new[] { "ENE", "FEB", "MAR", "ABR", "MAY", "JUN" };
                var mesesSegundoSemestre = new[] { "JUL", "AGO", "SEP", "OCT", "NOV", "DIC" };
            }

            <div class="row">
                <div class="col-md-6 border-end">
                    <div class="row text-center g-1">
                        @foreach (var mes in mesesPrimerSemestre)
                        {
                            <div class="col-2"><div class="ficha-mes-header">@mes</div></div>
                        }
                    </div>
                    <div class="row text-center mt-2">
                        @foreach (var mes in mesesPrimerSemestre)
                        {
                            <div class="col-2 p-1">
                                <input type="text" class="form-control text-center mes-grupo1 formato-miles"
                                       value="0" min="0" data-mes="@mes">
                            </div>
                        }
                    </div>

                    <div class="row text-center mt-3 g-1">
                        @foreach (var mes in mesesSegundoSemestre)
                        {
                            <div class="col-2"><div class="ficha-mes-header">@mes</div></div>
                        }
                    </div>
                    <div class="row text-center mt-2">
                        @foreach (var mes in mesesSegundoSemestre)
                        {
                            <div class="col-2 p-1">
                                <input type="text" class="form-control text-center mes-grupo1 formato-miles"
                                       value="0" min="0" data-mes="@mes">
                            </div>
                        }
                    </div>
                </div>

                @* Grupo 2 - Derecha *@
                <div class="col-md-6">
                    <div class="row text-center g-1">
                        @foreach (var mes in mesesPrimerSemestre)
                        {
                            <div class="col-2"><div class="ficha-mes-header">@mes</div></div>
                        }
                    </div>
                    <div class="row text-center mt-2">
                        @foreach (var mes in mesesPrimerSemestre)
                        {
                            <div class="col-2 p-1">
                                <input type="text" class="form-control text-center mes-grupo2 formato-miles"
                                       value="0" min="0" disabled data-mes="@mes">
                            </div>
                        }
                    </div>

                    <div class="row text-center mt-3 g-1">
                        @foreach (var mes in mesesSegundoSemestre)
                        {
                            <div class="col-2"><div class="ficha-mes-header">@mes</div></div>
                        }
                    </div>
                    <div class="row text-center mt-2">
                        @foreach (var mes in mesesSegundoSemestre)
                        {
                            <div class="col-2 p-1">
                                <input type="text" class="form-control text-center mes-grupo2 formato-miles"
                                       value="0" min="0" disabled data-mes="@mes">
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        @* Sección Valores y Resultados *@
        <div class="row mt-4 border-top pt-3">
            <div class="col-md-6 border-end pe-3">
                <div class="campo-ficha">
                    <div class="campo-ficha-label campo-ficha-label-corta">Valor de servicios</div>
                    <div class="campo-ficha-control">
                        <input class="form-control text-center fw-bold formato-miles"
                               id="valorServicios" value="0" disabled>
                    </div>
                </div>

                <div class="campo-ficha">
                    <div class="campo-ficha-label campo-ficha-label-corta">Valor de servicios por municipio</div>
                    <div class="campo-ficha-control">
                        <input class="form-control text-center formato-miles"
                               id="valorServiciosMunicipio" disabled value="0">
                    </div>
                </div>

                @* Sección Grupo 1 - Personas atendidas *@
                <div class="mt-4">
                    <div class="row align-items-center g-2">
                        <div class="col-md-8">
                            <select class="form-control select2-simple" id="selectEstadoGrupo1">
                                <option value="">Seleccione un municipio</option>
                                @foreach (var act in Model.ListaMunicipios)
                                {
                                    <option value="@act.Value">@act.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <input type="text" class="form-control text-center formato-miles"
                                   id="personasAtendidasGrupo1" value="0" min="0" placeholder="Número">
                        </div>
                    </div>

                    <div class="text-center mt-3">
                        <button class="btn-app-gris" id="btnAgregarGrupo1" type="button">
                            <i class="fas fa-plus"></i> Agregar
                        </button>
                    </div>

                    @* Tabla Grupo 1 *@
                    <div class="mt-3" id="tablaGrupo1" style="display: none;">
                        <div class="tabla-modal-wrap">
                            <table class="tabla-modal">
                                <thead>
                                    <tr>
                                        <th>Personas Atendidas</th>
                                        <th>Municipio</th>
                                        <th>Región</th>
                                        <th>Número de región</th>
                                        <th>Clave del municipio</th>
                                        <th>Acción</th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyGrupo1">
                                </tbody>
                                <tfoot>
                                    <tr class="fila-total">
                                        <td id="totalGrupo1">0</td>
                                        <td colspan="5" class="text-end">Total Grupo Principal</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 ps-3">
                <div class="campo-ficha">
                    <div class="campo-ficha-label campo-ficha-label-corta">Valor de personas</div>
                    <div class="campo-ficha-control">
                        <input class="form-control text-center fw-bold formato-miles"
                               id="valorPersonas" disabled value="0">
                    </div>
                </div>

                <div class="campo-ficha">
                    <div class="campo-ficha-label campo-ficha-label-corta">Valor de personas por municipio</div>
                    <div class="campo-ficha-control">
                        <input class="form-control text-center formato-miles"
                               id="valorPersonasMunicipio" disabled value="0">
                    </div>
                </div>

                @* Sección Grupo 2 *@
                <div class="mt-4">
