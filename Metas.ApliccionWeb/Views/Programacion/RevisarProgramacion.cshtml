        // ========================================
        // CONFIGURACIÓN DE SELECTS (CORREGIDAS)
        // ========================================
        function configurarSelectPersonas() {
            const selectPersonas = document.getElementById('selectPersonas');
            const selectAcumulable = document.getElementById('selectAcumulable');
            const inputsGrupo2 = document.querySelectorAll('.mes-grupo2');

            if (!selectPersonas || !selectAcumulable) return;

            selectPersonas.addEventListener('change', function() {
                if (this.value === 'Personas' || this.value === 'Instituciones') {
                    $(selectAcumulable).prop('disabled', false);
                } else {
                    $(selectAcumulable).prop('disabled', true);
                    $(selectAcumulable).val('').trigger('change');

                    inputsGrupo2.forEach(input => {
                        input.disabled = true;
                        input.value = 0;
                    });

                    calcularSumatorias();
                }
            });
        }

        function configurarSelectAcumulable() {
            const selectAcumulable = document.getElementById('selectAcumulable');
            const selectPersonas = document.getElementById('selectPersonas');
            const inputsGrupo2 = document.querySelectorAll('.mes-grupo2');
            const selectEstadoGrupo2 = document.getElementById('selectEstadoGrupo2');
            const personasAtendidasGrupo2 = document.getElementById('personasAtendidasGrupo2');
            const btnAgregarGrupo2 = document.getElementById('btnAgregarGrupo2');

            if (!selectAcumulable) return;

            selectAcumulable.addEventListener('change', function() {
                const esAcumulable = this.value === 'si';
                const esPersonas = selectPersonas?.value === 'Personas';
                const esInstituciones = selectPersonas?.value === 'Instituciones';
                const habilitarMeses = esAcumulable || (this.value === 'no' && esPersonas);

                inputsGrupo2.forEach(input => {
                    input.disabled = !habilitarMeses;
                    if (esInstituciones && !esAcumulable) {
                        input.value = 0;
                    }
                });

                // Controles de municipio
                const habilitarMunicipios = esAcumulable || (this.value === 'no' && esPersonas);
                if (selectEstadoGrupo2) $(selectEstadoGrupo2).prop('disabled', !habilitarMunicipios);
                if (personasAtendidasGrupo2) personasAtendidasGrupo2.disabled = !habilitarMunicipios;
                if (btnAgregarGrupo2) btnAgregarGrupo2.disabled = !habilitarMunicipios;

                if (esInstituciones && !esAcumulable) {
                    if (selectEstadoGrupo2) $(selectEstadoGrupo2).val('').trigger('change');
                    if (personasAtendidasGrupo2) personasAtendidasGrupo2.value = 0;
                }

                calcularSumatorias();
            });

            if (selectAcumulable.value) {
                selectAcumulable.dispatchEvent(new Event('change'));
            }
        }

        // ========================================
        // CONFIGURAR SELECT PROGRAMA-COMPONENTE
        // ========================================
        function configurarSelectProgramaComponente() {
            const $selectPrograma = $('#selectPrograma');
            const $selectComponente = $('#selectComponente');

            if (!$selectPrograma.length || !$selectComponente.length) return;

            const componenteSeleccionadoOriginal = $selectComponente.val();
            const componenteTextoOriginal = $selectComponente.find('option:selected').text();
            const todasOpciones = $selectComponente.find('option:not(:first)').clone();
            const programaSeleccionadoInicial = $selectPrograma.find('option:selected').text();

            filtrarComponentes(programaSeleccionadoInicial, componenteSeleccionadoOriginal);

            $selectPrograma.on('change', function() {
                const programaSeleccionado = $(this).find('option:selected').text();
                filtrarComponentes(programaSeleccionado, null);
            });

            function filtrarComponentes(programaTexto, componenteASeleccionar) {
                $selectComponente.find('option:not(:first)').remove();

                if (programaTexto && programaTexto.trim() !== '' && programaTexto !== 'Seleccione Programa') {
                    todasOpciones.each(function() {
                        const opcionPrograma = $(this).data('programa');
                        if (opcionPrograma === programaTexto) {
                            $selectComponente.append($(this).clone());
                        }
                    });

                    $selectComponente.prop('disabled', false);

                    if (componenteASeleccionar) {
                        $selectComponente.val(componenteASeleccionar).trigger('change');
                        if ($selectComponente.val() !== componenteASeleccionar) {
                            $selectComponente.find('option').each(function() {
                                if ($(this).text() === componenteTextoOriginal) {
                                    $(this).prop('selected', true);
                                }
                            });
                            $selectComponente.trigger('change');
                        }
                    }
                } else {
                    $selectComponente.prop('disabled', true);
                }
            }
        }

        // ========================================
        // FUNCIONES DE CÁLCULO (CORREGIDAS)
        // ========================================
        function calcularSumatorias() {
            const selectAcumulable = document.getElementById('selectAcumulable');
            const selectPersonas = document.getElementById('selectPersonas');

            const esAcumulable = selectAcumulable?.value === 'si';
            const esPersonas = selectPersonas?.value === 'Personas';

            let sumaGrupo1 = 0;
            let sumaGrupo2 = 0;

            // Sumar servicios (Grupo 1)
            document.querySelectorAll('.mes-grupo1').forEach(input => {
                sumaGrupo1 += removerFormatoMiles(input.value);
            });

            // Sumar personas (Grupo 2) según lógica
            if (esAcumulable) {
                document.querySelectorAll('.mes-grupo2').forEach(input => {
                    sumaGrupo2 += removerFormatoMiles(input.value);
                });
            } else if (esPersonas && selectAcumulable?.value === 'no') {
                document.querySelectorAll('.mes-grupo2').forEach(input => {
                    const valor = removerFormatoMiles(input.value);
                    if (valor > sumaGrupo2) {
                        sumaGrupo2 = valor;
                    }
                });
            }

            // Actualizar campos con formato
            document.getElementById('valorServicios').value = formatearMiles(sumaGrupo1);
            document.getElementById('valorPersonas').value = formatearMiles(sumaGrupo2);

            actualizarMaximosPersonas(sumaGrupo1, sumaGrupo2);
            actualizarServiciosPorMunicipio();
            actualizarCamposMeta();
            calcularTrimestres();
        }

        function calcularTrimestres() {
            const trimestres = {
                1: ['ENE', 'FEB', 'MAR'],
                2: ['ABR', 'MAY', 'JUN'],
                3: ['JUL', 'AGO', 'SEP'],
                4: ['OCT', 'NOV', 'DIC']
            };

            const camposServicios = {
                1: 'primerServicio',
                2: 'segundoServicio',
                3: 'tercerServicio',
                4: 'cuartoServicio'
            };

            const camposPersonas = {
                1: 'primerPersona',
                2: 'segundoPersona',
                3: 'tercerPersona',
                4: 'cuartoPersona'
            };

            // Calcular trimestres de SERVICIOS
            for (let i = 1; i <= 4; i++) {
                let sumaServicios = 0;

                trimestres[i].forEach(mes => {
                    const inputServicio = document.querySelector(`.mes-grupo1[data-mes="${mes}"]`);
                    if (inputServicio) {
                        sumaServicios += removerFormatoMiles(inputServicio.value);
                    }
                });

                const campoServicio = document.getElementById(camposServicios[i]);
                if (campoServicio) {
                    campoServicio.value = formatearMiles(sumaServicios);
                }
            }

            // Calcular trimestres de PERSONAS
            for (let i = 1; i <= 4; i++) {
                let sumaPersonas = 0;

                trimestres[i].forEach(mes => {
                    const inputPersona = document.querySelector(`.mes-grupo2[data-mes="${mes}"]`);
                    if (inputPersona) {
                        sumaPersonas += removerFormatoMiles(inputPersona.value);
                    }
                });

                const campoPersona = document.getElementById(camposPersonas[i]);
                if (campoPersona) {
                    campoPersona.value = formatearMiles(sumaPersonas);
                }
            }
        }

        // ========================================
        // FUNCIONES DE FORMATO DE MILES
        // ========================================

        function formatearMiles(valor) {
            // Convertir a string y remover cualquier formato existente
            const numero = valor.toString().replace(/,/g, '');

            // Si está vacío o no es un número válido, retornar vacío
            if (numero === '' || isNaN(numero)) {
                return '';
            }

            // Formatear con separador de miles
            return parseInt(numero).toLocaleString('en-US');
        }

        function removerFormatoMiles(valorFormateado) {
            return parseInt(valorFormateado.replace(/,/g, '')) || 0;
        }

        function configurarFormatoMiles(nombreClase = 'formato-miles') {
            const inputs = document.querySelectorAll(`.${nombreClase}`);

            inputs.forEach(input => {
                // Formatear valor inicial si existe
                if (input.value && input.value !== '0') {
                    input.value = formatearMiles(input.value);
                }

                // Evento al escribir/pegar
                input.addEventListener('input', function(e) {
                    const cursorPos = this.selectionStart;
                    const valorAnterior = this.value;
                    const longitudAnterior = valorAnterior.length;

                    // Remover formato, validar y reformatear
                    const valorSinFormato = this.value.replace(/,/g, '');

                    // Solo permitir números
                    if (valorSinFormato && !/^\d+$/.test(valorSinFormato)) {
                        this.value = valorAnterior;
                        return;
                    }

                    // Aplicar formato
                    const valorFormateado = formatearMiles(valorSinFormato);
                    this.value = valorFormateado;

                    // Ajustar posición del cursor
                    const longitudNueva = valorFormateado.length;
                    const diferencia = longitudNueva - longitudAnterior;
                    const nuevaPos = cursorPos + diferencia;

                    this.setSelectionRange(nuevaPos, nuevaPos);
                });

                // Evento al perder foco - asegurar formato correcto
                input.addEventListener('blur', function() {
                    if (this.value === '' || this.value === '0') {
                        this.value = '0';
                    } else {
                        this.value = formatearMiles(this.value);
                    }
                });

                // Evento al obtener foco - útil para algunos casos
                input.addEventListener('focus', function() {
                    // Opcional: podrías remover el formato al hacer focus
                    // para facilitar la edición
                    // this.value = removerFormatoMiles(this.value);
                });
            });
        }

        // ========================================
        // FUNCIÓN AUXILIAR PARA OBTENER VALOR NUMÉRICO
        // ========================================
        function obtenerValorNumerico(idElemento) {
            const elemento = document.getElementById(idElemento);
            if (!elemento) return 0;

            return removerFormatoMiles(elemento.value);
        }


        // ========================================
        // INICIALIZACIÓN PRINCIPAL
        // ========================================
        document.addEventListener('DOMContentLoaded', async function() {
            $('.select2-simple').select2({ width: '100%', language: 'es', minimumResultsForSearch: 8 });

            await cargarMunicipios();

            cargarMunicipiosExistentes();

            inicializarComentarios();

            configurarSelectProgramaComponente();
            configurarSelectPersonas();
            configurarSelectAcumulable();

            configurarAgregarPersonas('Grupo1');
            configurarAgregarPersonas('Grupo2');

            configurarFormatoMiles('formato-miles');  

            document.querySelectorAll('.mes-grupo1, .mes-grupo2').forEach(input => {
                input.addEventListener('input', calcularSumatorias);
            });

            // Botones
            const btnGuardarAdmin = document.getElementById('btnGuardarAdmin');
            if (btnGuardarAdmin) {
                btnGuardarAdmin.addEventListener('click', guardarCambiosAdmin);
            }

            const btnValidar = document.getElementById('btnValidarProgramacion');
            if (btnValidar) {
                btnValidar.addEventListener('click', validarProgramacion);
            }

            const btnGuardarUsuario = document.getElementById('btnGuardarCambiosUsuario');
            if (btnGuardarUsuario) {
                btnGuardarUsuario.addEventListener('click', guardarCambiosUsuario);
            }

            // Calcular valores iniciales
            calcularSumatorias();
        });

    </script>
