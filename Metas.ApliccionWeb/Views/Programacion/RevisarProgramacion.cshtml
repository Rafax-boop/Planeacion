@model Metas.BLL.DTO.ProgramacionDTO

@{
    ViewData["Title"] = "Editar Programación";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 ficha-titulo-wrap">
        <div class="titulo-vista-wrap mb-0">
            <h1 class="titulo-vista">Editar Ficha Técnica de Actividades</h1>
        </div>
        <a asp-controller="Programacion" asp-action="Programacion" class="btn-app-gris" onclick="if (window.history.length > 1) { event.preventDefault(); window.history.back(); }">
            <i class="fa-solid fa-arrow-left"></i> Volver
        </a>
    </div>

    @if (Model.Estatus == 3)
    {
        <div class="aviso-validado aviso-validado-centrado">
            <i class="fas fa-check-circle"></i>
            <div>
                <h4>Programación Validada</h4>
                <p>Esta programación ha sido aprobada y validada.</p>
            </div>
        </div>
    }

    @* Datos del solicitante *@
    <div class="ficha-solicitante">
        <div class="ficha-solicitante-tab">
            <h2>Datos del solicitante</h2>
        </div>

        <div class="ficha-solicitante-body">
            <div class="campo-ficha">
                <div class="campo-ficha-label campo-ficha-label-corta">1. FECHA DE ELABORACIÓN</div>
                <div class="campo-ficha-control fw-semibold">@DateTime.Now.ToString("dd/MM/yyyy")</div>
            </div>

            <div class="campo-ficha">
                <div class="campo-ficha-label campo-ficha-label-corta">2. NOMBRE DEL ÁREA OPERATIVA RESPONSABLE (AOR)</div>
                <div class="campo-ficha-control">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small text-muted mb-1">Área</label>
                            <textarea disabled class="form-control fw-semibold" rows="2" id="inputArea">@Model.Area</textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted mb-1">Departamento</label>
                            <textarea disabled class="form-control fw-semibold" rows="2" id="inputDepartamento">@Model.Departamento</textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="campo-ficha">
                <div class="campo-ficha-label campo-ficha-label-corta">3. CORREO ELECTRÓNICO</div>
                <div class="campo-ficha-control">
                    <input type="email" @(!ViewBag.EsAdministrador ? "disabled" : "") class="form-control" placeholder="ejemplo@correo.com" id="inputCorreo" value="@Model.CorreoContacto">
                </div>
            </div>
        </div>
    </div>

    @* Datos de la solicitud *@
    <div class="ficha-seccion">
        <h5 class="ficha-seccion-titulo">Datos de la solicitud</h5>

        <div class="campo-ficha">
            <div class="campo-ficha-label">4. PROGRAMA PRESUPUESTARIO</div>
            <div class="campo-ficha-control">
                <select @(!ViewBag.EsAdministrador ? "disabled" : "") class="form-control select2-simple" id="selectPrograma" data-campo="4">
                    <option value="">Seleccione Programa</option>
                    @if (Model.ListaProgramas != null)
                    {
                        foreach (var programa in Model.ListaProgramas)
                        {
                            if (programa.Value == Model.Pp)
                            {
                                <option value="@programa.Value" selected>@programa.Text</option>
                            }
                            else
                            {
                                <option value="@programa.Value">@programa.Text</option>
                            }
                        }
                    }
                </select>
            </div>
            <button type="button" class="btn btn-sm btn-comentario btn-comentario-sin"
                    data-campo="4" data-bs-toggle="tooltip" title="Agregar comentario">
                <i class="fas fa-comment-medical"></i>
            </button>
        </div>

        <div class="campo-ficha">
            <div class="campo-ficha-label">5. NÚMERO DE COMPONENTE</div>
            <div class="campo-ficha-control">
                <select @(!ViewBag.EsAdministrador ? "disabled" : "")
                        class="form-control select2-simple"
                        id="selectComponente"
                        data-campo="5">
                    <option value="">Seleccione Componente</option>
                    @if (Model.ListaComponentes != null && Model.ListaComponentes.Any())
                    {
                        foreach (var componente in Model.ListaComponentes)
                        {
                            if (componente.Text == Model.NComponente)
                            {
                                <option value="@componente.Value" data-programa="@componente.Group.Name" selected>@componente.Text</option>
                            }
                            else
                            {
                                <option value="@componente.Value" data-programa="@componente.Group.Name">@componente.Text</option>
                            }
                        }
                    }
                </select>
            </div>
            <button type="button" class="btn btn-sm btn-comentario btn-comentario-sin"
                    data-campo="5" data-bs-toggle="tooltip" title="Agregar comentario">
                <i class="fas fa-comment-medical"></i>
            </button>
        </div>

        <div class="campo-ficha">
            <div class="campo-ficha-label">6. NÚMERO DE ACTIVIDAD</div>
            <div class="campo-ficha-control">
                <input type="number" @(!ViewBag.EsAdministrador ? "disabled" : "") required class="form-control" id="inputActividad" value="@Model.NActividad" data-campo="6">
            </div>
            <button type="button" class="btn btn-sm btn-comentario btn-comentario-sin"
                    data-campo="6" data-bs-toggle="tooltip" title="Agregar comentario">
                <i class="fas fa-comment-medical"></i>
            </button>
        </div>

        @* Justificacion *@
        <div class="campo-ficha">
            <div class="campo-ficha-label">7. JUSTIFICACIÓN</div>
            <div class="campo-ficha-control">
                <textarea required class="form-control" @(!ViewBag.EsAdministrador ? "disabled" : "") rows="2" id="inputJustificacion" data-campo="7">@Model.Justificacion</textarea>
            </div>
            <button type="button" class="btn btn-sm btn-comentario btn-comentario-sin"
                    data-campo="7" data-bs-toggle="tooltip" title="Agregar comentario">
                <i class="fas fa-comment-medical"></i>
            </button>
        </div>

        @* Documentacion soporte *@
        <div class="campo-ficha">
            <div class="campo-ficha-label">8. DOCUMENTACIÓN SOPORTE DE LA JUSTIFICACIÓN</div>
            <div class="campo-ficha-control">
                <textarea @(!ViewBag.EsAdministrador ? "disabled" : "") required class="form-control" rows="2" id="inputDocumentacion" data-campo="8">@Model.DescripcionDocumento</textarea>
            </div>
            <button type="button" class="btn btn-sm btn-comentario btn-comentario-sin"
                    data-campo="8" data-bs-toggle="tooltip" title="Agregar comentario">
                <i class="fas fa-comment-medical"></i>
            </button>
        </div>

        @* Origen de recursos *@
        <div class="campo-ficha">
            <div class="campo-ficha-label">9. ORIGEN DE RECURSOS</div>
            <div class="campo-ficha-control">
                <div class="row g-3">
                    <div class="col-6">
                        <label class="form-label small text-muted mb-1">Recurso Federal</label>
                        <select required @(!ViewBag.EsAdministrador ? "disabled" : "") class="form-control select2-simple" id="selectFederal" data-campo="9">
                            <option value="">Seleccione</option>
                            <option value="Si" selected="@(Model.RecursoFederal == "Si")">Sí</option>
                            <option value="No" selected="@(Model.RecursoFederal == "No")">No</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label small text-muted mb-1">Recurso Estatal</label>
                        <select required @(!ViewBag.EsAdministrador ? "disabled" : "") class="form-control select2-simple" id="selectEstatal" data-campo="9">
                            <option value="">Seleccione</option>
                            <option value="Si" selected="@(Model.RecursoEstatal == "Si")">Sí</option>
                            <option value="No" selected="@(Model.RecursoEstatal == "No")">No</option>
                        </select>
                    </div>
                </div>
            </div>
            <button type="button" class="btn btn-sm btn-comentario btn-comentario-sin"
                    data-campo="9" data-bs-toggle="tooltip" title="Agregar comentario">
                <i class="fas fa-comment-medical"></i>
            </button>
        </div>
    </div>

    @* Datos generales *@
    <div class="titulo-vista-wrap ficha-titulo-wrap">
        <h2 class="titulo-vista" style="font-size:1.1rem;">Datos Generales</h2>
    </div>

    <div class="ficha-seccion">
        <div class="campo-ficha">
            <div class="campo-ficha-label">10. PROGRAMA SOCIAL, SERVICIO Y/O PROYECTO</div>
            <div class="campo-ficha-control">
                <textarea required id="inputPrograma" @(!ViewBag.EsAdministrador ? "disabled" : "") class="form-control" rows="2">@Model.ProgramaSocial</textarea>
            </div>
            <button type="button" class="btn btn-sm btn-comentario btn-comentario-sin"
                    data-campo="10" data-bs-toggle="tooltip" title="Agregar comentario">
                <i class="fas fa-comment-medical"></i>
            </button>
        </div>
        <div class="campo-ficha">
            <div class="campo-ficha-label">11. DESCRIPCIÓN DE LA ACTIVIDAD</div>
            <div class="campo-ficha-control">
                <textarea required id="inputDescripcion" @(!ViewBag.EsAdministrador ? "disabled" : "") class="form-control" rows="2">@Model.DescripcionActividad</textarea>
            </div>
            <button type="button" class="btn btn-sm btn-comentario btn-comentario-sin"
                    data-campo="11" data-bs-toggle="tooltip" title="Agregar comentario">
                <i class="fas fa-comment-medical"></i>
            </button>
        </div>
        <div class="campo-ficha">
            <div class="campo-ficha-label">12. NOMBRE DEL INDICADOR</div>
            <div class="campo-ficha-control">
                <textarea required id="inputIndicador" @(!ViewBag.EsAdministrador ? "disabled" : "") class="form-control" rows="2">@Model.NombreIndicador</textarea>
            </div>
            <button type="button" class="btn btn-sm btn-comentario btn-comentario-sin"
                    data-campo="12" data-bs-toggle="tooltip" title="Agregar comentario">
                <i class="fas fa-comment-medical"></i>
            </button>
        </div>
        <div class="campo-ficha">
            <div class="campo-ficha-label">13. DEFINICIÓN DEL INDICADOR</div>
            <div class="campo-ficha-control">
                <textarea required id="inputDefinicion" @(!ViewBag.EsAdministrador ? "disabled" : "") class="form-control" rows="2">@Model.DefinicionIndicador</textarea>
            </div>
            <button type="button" class="btn btn-sm btn-comentario btn-comentario-sin"
                    data-campo="13" data-bs-toggle="tooltip" title="Agregar comentario">
                <i class="fas fa-comment-medical"></i>
            </button>
        </div>

        @* Calendarización *@
        <div class="campo-ficha">
            <div class="campo-ficha-label">14. CALENDARIZACIÓN</div>
        </div>

        <div class="row mb-2">
            <div class="col-md-3"></div>
            <div class="col-md-2"><div class="ficha-trimestre-header">1ER TRIMESTRE</div></div>
            <div class="col-md-2"><div class="ficha-trimestre-header">2DO. TRIMESTRE</div></div>
            <div class="col-md-2"><div class="ficha-trimestre-header">3ER. TRIMESTRE</div></div>
            <div class="col-md-2"><div class="ficha-trimestre-header">4TO. TRIMESTRE</div></div>
        </div>

        @* Fila para SERVICIOS *@
        <div class="row align-items-center pb-2 mb-2">
            <div class="col-md-3 text-center">
                <label class="fw-light">SERVICIOS</label>
            </div>
            <div class="col-md-2">
                <input type="text" disabled id="primerServicio" class="form-control text-center formato-miles" value="@Model.PrimerServicio" min="0">
            </div>
            <div class="col-md-2">
                <input type="text" disabled id="segundoServicio" class="form-control text-center formato-miles" value="@Model.SegundoServicio" min="0">
            </div>
            <div class="col-md-2">
                <input type="text" disabled id="tercerServicio" class="form-control text-center formato-miles" value="@Model.TercerServicio" min="0">
            </div>
            <div class="col-md-2">
                <input type="text" disabled id="cuartoServicio" class="form-control text-center formato-miles" value="@Model.CuartoServicio" min="0">
            </div>
        </div>

        @* Fila para PERSONAS *@
        <div class="row align-items-center mb-3">
            <div class="col-md-3 text-center">
                <label class="fw-light">PERSONAS</label>
            </div>
            <div class="col-md-2">
                <input type="text" disabled id="primerPersona" class="form-control text-center formato-miles" value="@Model.PrimerPersona" min="0">
            </div>
            <div class="col-md-2">
                <input type="text" disabled id="segundoPersona" class="form-control text-center formato-miles" value="@Model.SegundoPersona" min="0">
            </div>
            <div class="col-md-2">
                <input type="text" disabled id="tercerPersona" class="form-control text-center formato-miles" value="@Model.TercerPersona" min="0">
            </div>
            <div class="col-md-2">
                <input type="text" disabled id="cuartoPersona" class="form-control text-center formato-miles" value="@Model.CuartoPersona" min="0">
            </div>
        </div>

        <div class="campo-ficha">
            <div class="campo-ficha-label">15. UNIDAD DE MEDIDA</div>
            <div class="campo-ficha-control">
                <select required @(!ViewBag.EsAdministrador ? "disabled" : "")
                        class="form-control select2-simple"
                        id="selectMedida"
                        data-campo="15">
                    <option value="">Seleccione opción</option>
                    @if (Model.ListaMedidas != null)
                    {
                        foreach (var medida in Model.ListaMedidas)
                        {
                            if (medida.Value == Model.UnidadMedida || medida.Text == Model.UnidadMedida)
                            {
                                <option value="@medida.Value" selected>@medida.Text</option>
                            }
                            else
                            {
                                <option value="@medida.Value">@medida.Text</option>
                            }
                        }
                    }
                </select>
            </div>
            <button type="button" class="btn btn-sm btn-comentario btn-comentario-sin"
                    data-campo="15" data-bs-toggle="tooltip" title="Agregar comentario">
                <i class="fas fa-comment-medical"></i>
            </button>
        </div>

        <div class="campo-ficha">
            <div class="campo-ficha-label">16. MEDIOS DE VERIFICACIÓN</div>
            <div class="campo-ficha-control">
                <textarea required id="inputMedios" @(!ViewBag.EsAdministrador ? "disabled" : "") class="form-control" rows="2">@Model.MediosVerificacion</textarea>
            </div>
            <button type="button" class="btn btn-sm btn-comentario btn-comentario-sin"
                    data-campo="16" data-bs-toggle="tooltip" title="Agregar comentario">
                <i class="fas fa-comment-medical"></i>
            </button>
        </div>

        <div class="campo-ficha">
            <div class="campo-ficha-label">17. SERIE DE INFORMACIÓN DISPONIBLE</div>
            <div class="campo-ficha-control">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small text-muted mb-1">Desde</label>
                        <select required @(!ViewBag.EsAdministrador ? "disabled" : "")
                                class="form-control select2-simple"
                                id="selectDesde"
                                data-campo="17">
                            <option value="">Seleccione Desde</option>
                            @{
                                var anoActual = DateTime.Now.Year;
                                var anoMinimo = anoActual - 5;

                                for (int ano = anoActual; ano >= anoMinimo; ano--)
                                {
                                    <option value="@ano"
                                            selected="@(ano.ToString() == Model.SerieInformacionDesde)">
                                        @ano
                                    </option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small text-muted mb-1">Hasta</label>
                        <select @(!ViewBag.EsAdministrador ? "disabled" : "")
                                class="form-control select2-simple"
                                id="selectHasta"
                                data-campo="17">
                            <option value="">Seleccione Hasta</option>
                            @{
                                for (int ano = anoActual; ano >= anoMinimo; ano--)
                                {
                                    <option value="@ano"
                                            selected="@(ano.ToString() == Model.SerieInformacionHasta)">
                                        @ano
                                    </option>
                                }
                            }
                        </select>
                    </div>
                </div>
            </div>
            <button type="button" class="btn btn-sm btn-comentario btn-comentario-sin"
                    data-campo="17" data-bs-toggle="tooltip" title="Agregar comentario">
                <i class="fas fa-comment-medical"></i>
            </button>
        </div>

        <div class="campo-ficha">
            <div class="campo-ficha-label">18. FUENTES DE INFORMACIÓN</div>
            <div class="campo-ficha-control">
                <textarea required id="inputFuentes" @(!ViewBag.EsAdministrador ? "disabled" : "") class="form-control" rows="2">@Model.FuenteInformacion</textarea>
            </div>
            <button type="button" class="btn btn-sm btn-comentario btn-comentario-sin"
                    data-campo="18" data-bs-toggle="tooltip" title="Agregar comentario">
                <i class="fas fa-comment-medical"></i>
            </button>
        </div>

        <div class="row">
            <div class="col-md-6 border-end">
                <div class="campo-ficha" style="border-bottom:none;">
                    <div class="campo-ficha-label campo-ficha-label-corta">19. INTERVIENEN DELEGACIONES REGIONALES</div>
                    <div class="campo-ficha-control">
                        <select id="selectDelegaciones" @(!ViewBag.EsAdministrador ? "disabled" : "") class="form-control select2-simple">
                            <option value="">Seleccione</option>
                            <option value="Si" selected="@(Model.IntervienenDelegaciones == "Si")">Sí</option>
                            <option value="No" selected="@(Model.IntervienenDelegaciones == "No")">No</option>
                        </select>
                    </div>
                    <button type="button" class="btn btn-sm btn-comentario btn-comentario-sin"
                            data-campo="19" data-bs-toggle="tooltip" title="Agregar comentario">
                        <i class="fas fa-comment-medical"></i>
                    </button>
                </div>
            </div>
            <div class="col-md-6">
                <div class="campo-ficha" style="border-bottom:none;">
                    <div class="campo-ficha-label campo-ficha-label-corta">20. ¿DE QUÉ MANERA?</div>
                    <div class="campo-ficha-control">
                        <textarea @(!ViewBag.EsAdministrador ? "disabled" : "") id="inputDelegaciones" class="form-control" rows="2">@Model.IntervienenDelegacionesManera</textarea>
                    </div>
                    <button type="button" class="btn btn-sm btn-comentario btn-comentario-sin"
                            data-campo="20" data-bs-toggle="tooltip" title="Agregar comentario">
                        <i class="fas fa-comment-medical"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* Determinación de Metas *@
    <div class="ficha-seccion">
        <h5 class="ficha-seccion-titulo">Determinación de Metas</h5>

        <div class="row">
            <div class="col-md-6 border-end">
                <div class="ficha-seccion-subtitulo">Línea Base</div>

                <div class="campo-ficha">
                    <div class="campo-ficha-label campo-ficha-label-corta">21. AÑO</div>
                    <div class="campo-ficha-control">
                        <select @(!ViewBag.EsAdministrador ? "disabled" : "")
                                class="form-control select2-simple"
                                id="selectAnoBase"
                                data-campo="21">
                            <option value="">Seleccione Año</option>
                            @{
                                for (int ano = anoActual; ano >= anoMinimo; ano--)
                                {
                                    <option value="@ano"
                                            selected="@(ano == Model.AnoBase)">
                                        @ano
                                    </option>
                                }
                            }
                        </select>
                    </div>
                    <button type="button" class="btn btn-sm btn-comentario btn-comentario-sin"
                            data-campo="21" data-bs-toggle="tooltip" title="Agregar comentario">
                        <i class="fas fa-comment-medical"></i>
                    </button>
                </div>

                <div class="campo-ficha">
                    <div class="campo-ficha-label campo-ficha-label-corta">22. PORCENTAJE DE CUMPLIMIENTO</div>
                    <div class="campo-ficha-control">
                        <input id="inputPorcentajeBase" @(!ViewBag.EsAdministrador ? "disabled" : "") type="number" class="form-control text-center" value="@Model.PorcentajeBase" min="0" max="100">
                    </div>
                    <button type="button" class="btn btn-sm btn-comentario btn-comentario-sin"
                            data-campo="22" data-bs-toggle="tooltip" title="Agregar comentario">
                        <i class="fas fa-comment-medical"></i>
                    </button>
                </div>

                <div class="campo-ficha">
                    <div class="campo-ficha-label campo-ficha-label-corta">23. NO. DE BIEN O SERVICIO ENTREGADO</div>
                    <div class="campo-ficha-control">
                        <input @(!ViewBag.EsAdministrador ? "disabled" : "") id="inputServicioBase" type="text" class="form-control text-center formato-miles" value="@Model.ServicioBase" min="0">
                    </div>
                    <button type="button" class="btn btn-sm btn-comentario btn-comentario-sin"
                            data-campo="23" data-bs-toggle="tooltip" title="Agregar comentario">
                        <i class="fas fa-comment-medical"></i>
                    </button>
                </div>

                <div class="campo-ficha" style="border-bottom:none;">
                    <div class="campo-ficha-label campo-ficha-label-corta">24. NO. DE PERSONAS ATENDIDAS</div>
                    <div class="campo-ficha-control">
                        <input @(!ViewBag.EsAdministrador ? "disabled" : "") id="inputPersonasBase" type="text" class="form-control text-center formato-miles" value="@Model.PersonasBase" min="0">
                    </div>
                    <button type="button" class="btn btn-sm btn-comentario btn-comentario-sin"
                            data-campo="24" data-bs-toggle="tooltip" title="Agregar comentario">
                        <i class="fas fa-comment-medical"></i>
                    </button>
                </div>
            </div>

            <div class="col-md-6">
                <div class="ficha-seccion-subtitulo">Meta y Periodo de Cumplimiento</div>

                <div class="campo-ficha">
                    <div class="campo-ficha-label campo-ficha-label-corta">25. AÑO</div>
                    <div class="campo-ficha-control">
                        <input id="inputAnoMeta" type="text" disabled class="form-control text-center fw-semibold" value="@Model.AnoMeta">
                    </div>
                </div>

                <div class="campo-ficha">
                    <div class="campo-ficha-label campo-ficha-label-corta">26. PORCENTAJE DE CUMPLIMIENTO</div>
                    <div class="campo-ficha-control">
                        <input id="inputPorcentajeMeta" disabled type="number" class="form-control text-center" value="@Model.PorcentajeMeta" min="0" max="100">
                    </div>
                </div>

                <div class="campo-ficha">
                    <div class="campo-ficha-label campo-ficha-label-corta">27. NO. DE BIEN O SERVICIO A ENTREGAR</div>
                    <div class="campo-ficha-control">
