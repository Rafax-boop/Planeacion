@model Metas.AplicacionWeb.Models.ViewModels.VMDepartamentos
@{
    ViewData["Title"] = "Iniciar Programación";
}

<div class="titulo-vista-wrap">
    <h1 class="titulo-vista">Ejercicio de Programación</h1>
    <span class="subtitulo-vista">- Selecciona un año fiscal y un departamento para ver o iniciar su programación anual.</span>
</div>

<div class="filtros-container">
    <div class="filtro-grupo">
        <label for="selectAnoFiscal">Año Fiscal</label>
        <select id="selectAnoFiscal" class="select2-simple">
            @{
                var anoActual = DateTime.Now.Year;
                var anoMaximo = anoActual + 1;
                var anoMinimo = anoActual - 5;

                for (int ano = anoMaximo; ano >= anoMinimo; ano--)
                {
                    <option value="@ano" selected="@(ano == anoActual)">@ano</option>
                }
            }
        </select>
    </div>
    <div class="filtro-grupo">
        <label for="selectDepartamento">Departamento</label>
        <select id="selectDepartamento" class="select2-simple">
            @if (User.IsInRole("Administrador") || Model.ListaDepartamentos.Count() > 1)
            {
                <option value="">-- Seleccione un departamento --</option>
            }

            @foreach (var depto in Model.ListaDepartamentos)
            {
                <option value="@depto.Value">@depto.Text</option>
            }
        </select>
    </div>
    <div class="filtro-grupo">
        <label for="selectProgramaFiltro">Programa Presupuestal</label>
        <select id="selectProgramaFiltro" class="select2-simple">
            <option value="">Todos</option>
            <option value="Agenda">Agenda</option>
            <option value="E046">E046</option>
            <option value="E047">E047</option>
        </select>
    </div>
    <div class="filtro-grupo">
        <label for="selectAreaFiltro">Área</label>
        <select id="selectAreaFiltro" class="select2-simple">
            <option value="">Todas</option>
            @foreach (var area in Model.ListaAreas)
            {
                <option value="@area.Text">@area.Text</option>
            }
        </select>
    </div>
    <div class="filtro-grupo" style="flex: 0 0 auto; min-width: auto;">
        <label>&nbsp;</label>
        <button class="btn-app-rosa" type="button" id="btnBuscar">
            <i class="fa-solid fa-magnifying-glass"></i> Buscar
        </button>
    </div>
</div>

<!-- Sección que se mostrará después de buscar -->
<div id="seccionResultados" style="display: none;">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
        <div>
            <h2 class="titulo-vista mb-1" style="font-size: 1.1rem;" id="ano">Ejercicio Fiscal</h2>
            <p class="subtitulo-vista mb-0" id="tituloDepartamento">Departamento:</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button class="btn-app-rosa" type="button" id="btnIniciarProgramacion">
                <i class="fa-solid fa-play"></i> Iniciar Programación
            </button>
            @if (User.IsInRole("Administrador"))
            {
                <button class="btn-app-azul" type="button" onclick="irATableroProgramacion()">
                    <i class="fa-solid fa-table"></i> Tablero Completo de Programación
                </button>
            }
        </div>
    </div>

    <div class="tabla-datos-wrap">
        <table class="tabla-datos" id="tablaDatos">
            <thead>
                <tr>
                    <th>Pp</th>
                    <th>Componente</th>
                    <th>Actividad</th>
                    <th>Descripción de la Actividad</th>
                    <th>Programa o servicio de asistencia social</th>
                    <th>Área</th>
                    <th>Departamento</th>
                    <th class="text-center">Estatus</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody id="tbodyDatos">
                <!-- Los datos se cargarán aquí dinámicamente -->
            </tbody>
        </table>
    </div>
    <div id="tablaDatos-paginacion" class="tabla-paginacion"></div>

    <!-- Mensaje de carga -->
    <div id="mensajeCarga" class="text-center mt-3" style="display: none;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <p class="mt-2">Cargando datos...</p>
    </div>

    <!-- Mensaje cuando no hay datos -->
    <div id="mensajeSinDatos" class="sin-registros mt-3" style="display: none;">
        <i class="bi bi-clipboard2-x"></i><br>
        <span>No se encontraron datos para los criterios seleccionados.</span>
    </div>
</div>

@section Scripts {
    <script>
    (function () {
        $('.select2-simple').select2({ width: '100%', language: 'es', minimumResultsForSearch: 8 });

        function irATableroProgramacion() {
            var anoFiscal = $('#selectAnoFiscal').val();

            window.location.href = '@Url.Action("TableroCompletoProgramacion", "Programacion")' +
                                  '?anoFiscal=' + anoFiscal;
        }
        window.irATableroProgramacion = irATableroProgramacion;

        function filtrarTabla() {
            var tabla = document.getElementById('tablaDatos');
            if (!tabla) return;

            var ppFiltro = ($('#selectProgramaFiltro').val() || '').toLowerCase();
            var areaFiltro = $('#selectAreaFiltro').val() || '';

            var filas = tabla.querySelectorAll('tbody tr');
            filas.forEach(function (fila) {
                var ppCelda = fila.cells[0] ? fila.cells[0].textContent.trim().toLowerCase() : '';
                var areaCelda = fila.cells[5] ? fila.cells[5].textContent.trim() : '';

                var pasaPp = !ppFiltro || ppCelda === ppFiltro;
                var pasaArea = !areaFiltro || areaCelda === areaFiltro;

                fila.style.display = (pasaPp && pasaArea) ? '' : 'none';
            });

            TablaPaginada.actualizar('tablaDatos');
        }

        $('#selectProgramaFiltro, #selectAreaFiltro').on('change', filtrarTabla);

        $(document).ready(function() {

            // ========================================
            // BUSCAR REGISTROS
            // ========================================
            $('#btnBuscar').click(function() {
                var anoFiscal = $('#selectAnoFiscal').val();
                var departamento = $('#selectDepartamento').val();
                var departamentoTexto = $('#selectDepartamento option:selected').text();

                // Validar que se haya seleccionado un departamento
                if (!departamento) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Selecciona un departamento',
                        text: 'Por favor, selecciona un departamento para continuar.',
                        confirmButtonText: 'Entendido'
                    });
                    return;
                }

                // Mostrar la sección de resultados
                $('#seccionResultados').slideDown();

                // Cambiar los títulos dinámicamente
                $('#ano').text('Ejercicio Fiscal: ' + anoFiscal);
                $('#tituloDepartamento').text('Departamento: ' + departamentoTexto);

                // Mostrar mensaje de carga
                $('#mensajeCarga').show();
                $('#tablaDatos').hide();
                $('#mensajeSinDatos').hide();

                // Llamada AJAX para obtener los datos
                $.ajax({
                    url: '@Url.Action("ObtenerDatos", "Programacion")',
                    type: 'GET',
                    data: {
                        anoFiscal: anoFiscal,
                        departamento: departamento
                    },
                    success: function(response) {
                        $('#mensajeCarga').hide();

                        // Mostrar/Ocultar el botón "Iniciar Programación" según fecha habilitada
                        if (response.fechaHabilitada) {
                            $('#btnIniciarProgramacion').show();
                        } else {
                            $('#btnIniciarProgramacion').hide().prop('disabled', true);
                        }

                        // Verificar si hay datos
                        if (response.success && response.datos && response.datos.length > 0) {
                            $('#tbodyDatos').empty();

                            var esAdmin = response.esAdmin;

                         // Llenar la tabla con los datos
                        $.each(response.datos, function(index, item) {
                            // Construir nombre de actividad
                            var prefijoActividad = '';
                            if (item.pp && item.pp.toLowerCase() === 'agenda') {
                                prefijoActividad = 'T';
                            }
                            var actividadCompleta = prefijoActividad + (item.componente || '') + '.' + (item.actividad || '');

                            // ========================================
                            // LÓGICA DE BOTONES SEGÚN ROL Y ESTATUS
                            // ========================================
                            var acciones = '';

                            // Para ADMINISTRADOR
                            if (esAdmin) {
                                acciones += '<button type="button" class="btn-accion btn-accion-editar btn-editar" data-id="' + item.idProceso + '" title="Editar" data-bs-toggle="tooltip" data-bs-placement="top"><i class="fa-solid fa-pen-to-square"></i></button>';
                                acciones += '<button type="button" class="btn-accion btn-accion-eliminar btn-eliminar" data-id="' + item.idProceso + '" title="Eliminar" data-bs-toggle="tooltip" data-bs-placement="top"><i class="fa-solid fa-trash"></i></button>';
                            }
                            else {
                                acciones = '<button type="button" class="btn-accion btn-accion-ver btn-ver" data-id="' + item.idProceso + '" title="Ver formulario" data-bs-toggle="tooltip" data-bs-placement="top"><i class="fa-solid fa-eye"></i></button>';
                            }

                            var claseBadge = 'badge-estatus-neutral';
                            var iconoBadge = 'bi-question-circle';
                            var textoBadge = item.nombreEstatus || 'Sin estatus';
                            switch(item.idEstatus) {
                                case 1:
                                    claseBadge = 'badge-estatus-info';
                                    iconoBadge = 'bi-clock-history';
                                    textoBadge = 'En Revisión';
                                    break;
                                case 2:
                                    claseBadge = 'badge-estatus-warning';
                                    iconoBadge = 'bi-chat-dots';
                                    textoBadge = 'Con Comentarios';
                                    break;
                                case 3:
                                    claseBadge = 'badge-estatus-success';
                                    iconoBadge = 'bi-check-circle';
                                    textoBadge = 'Validado';
                                    break;
                            }
                            var badgeEstatus = '<span class="badge-estatus ' + claseBadge + '"><i class="bi ' + iconoBadge + '"></i> ' + textoBadge + '</span>';

                            // Construir la fila de la tabla
                            var fila = '<tr>' +
                                '<td>' + item.pp + '</td>' +
                                '<td>' + item.componente + '</td>' +
                                '<td>' + actividadCompleta + '</td>' +
                                '<td>' + item.descripcionActividad + '</td>' +
                                '<td>' + item.programaSocial + '</td>' +
                                '<td>' + item.area + '</td>' +
                                '<td>' + item.departamento + '</td>' +
                                '<td class="text-center">' + badgeEstatus + '</td>' +
                                '<td><div class="acciones-grupo">' + acciones + '</div></td>' +
                            '</tr>';

                            $('#tbodyDatos').append(fila);
                        });
                            $('#tablaDatos').show();
                            TablaPaginada.iniciar('tablaDatos', { pageSize: 8 });
                            filtrarTabla();

                            // Tooltips de los botones de acciones (se reconstruyen en cada búsqueda)
                            $('#tbodyDatos [data-bs-toggle="tooltip"]').each(function () {
                                bootstrap.Tooltip.getOrCreateInstance(this);
                            });

                        } else {
                            $('#tablaDatos').show();
                            $('#mensajeSinDatos').show();
                        }
                    },
                    error: function(xhr, status, error) {
                        $('#mensajeCarga').hide();
                        Swal.fire({
                            icon: 'error',
                            title: 'Error al cargar los datos',
                            text: error,
                            confirmButtonText: 'Entendido'
                        });
                    }
                });
            });


            // ========================================
            // ELIMINAR REGISTRO (Solo Admin)
            // ========================================
            $(document).on('click', '.btn-eliminar', function() {
                var idProceso = $(this).data('id');

                // Confirmación antes de eliminar
                Swal.fire({
                    icon: 'warning',
                    title: '¿Eliminar este registro?',
                    text: 'Esta acción es irreversible y eliminará datos en 4 tablas.',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, eliminar',
                    cancelButtonText: 'Cancelar'
                }).then(function (resultado) {
                    if (!resultado.isConfirmed) return;

                    $.ajax({
                        url: '@Url.Action("EliminarRegistro", "Programacion")',
                        type: 'POST',
                        data: { id: idProceso },
                        success: function(response) {
                            if (response.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Registro eliminado',
                                    text: response.mensaje,
                                    confirmButtonText: 'Aceptar'
                                }).then(function () {
                                    // Recargar la tabla
                                    $('#btnBuscar').click();
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error',
                                    text: response.mensaje,
                                    confirmButtonText: 'Entendido'
                                });
                            }
                        },
                        error: function(xhr, status, error) {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error de comunicación',
                                text: 'No se pudo contactar al servidor al intentar eliminar.',
                                confirmButtonText: 'Entendido'
                            });
                        }
                    });
                });
            });

            // ========================================
            // EDITAR REGISTRO (Admin o Usuario según estatus)
            // ========================================
            $(document).on('click', '.btn-editar', function() {
                var idProceso = $(this).data('id');
                var urlEditar = '@Url.Action("RevisarProgramacion", "Programacion")' + '?id=' + idProceso;
                window.location.href = urlEditar;
            });

            $(document).on('click', '.btn-ver', function() {
                var idProceso = $(this).data('id');
                var urlVer = '@Url.Action("RevisarProgramacion", "Programacion")' + '?id=' + idProceso;
                window.location.href = urlVer;
            });

            // ========================================
            // INICIAR NUEVA PROGRAMACIÓN
            // ========================================
            $('#btnIniciarProgramacion').click(function() {
                var anoFiscal = $('#selectAnoFiscal').val();
                var departamento = $('#selectDepartamento').val();

                var urlRedireccion = '@Url.Action("RegistrarProgramacion", "Programacion")' +
                                     '?anoFiscal=' + anoFiscal +
                                     '&departamentoId=' + departamento;

                window.location.href = urlRedireccion;
            });

            // Si se regresa con "atrás" del navegador (sin que el bfcache haya
            // restaurado la página completa), el filtro conserva el valor pero
            // la tabla queda vacía porque nunca se disparó el clic de "Buscar".
            // Se vuelve a ejecutar la búsqueda automáticamente en ese caso.
            var entradaNavegacion = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
            var esNavegacionAtras = entradaNavegacion
                ? entradaNavegacion.type === 'back_forward'
                : (performance.navigation && performance.navigation.type === 2);

            if (esNavegacionAtras && $('#selectDepartamento').val()) {
                $('#btnBuscar').click();
            }
        });
    })();
    </script>
}
