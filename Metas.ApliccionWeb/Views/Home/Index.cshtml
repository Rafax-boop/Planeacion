@{
    ViewData["Title"] = "Inicio";
}

@section Styles {
    <link rel="stylesheet" href="~/css/estilos-home.css" asp-append-version="true" />
}

<div class="home-hero">
    <div class="home-orb home-orb-1"></div>
    <div class="home-orb home-orb-2"></div>
    <div class="home-orb home-orb-3"></div>
    <div class="home-orb home-orb-4"></div>
    <div class="home-orb home-orb-5"></div>

    <div class="home-heart-wrap home-fade" style="animation-delay:0s;">
        <div class="home-heart-glow-outer"></div>
        <div class="home-heart-glow-inner"></div>
        <img src="~/img/corazon.png" alt="Control de Seguimiento de Metas" class="home-heart" />
    </div>

    <h1 class="home-title home-fade" style="animation-delay:.15s;">Control de Seguimiento de Metas</h1>

    <div class="home-greeting-block home-fade" style="animation-delay:.28s;">
        <p class="home-greeting">
            <span id="home-greeting-text">Buenos días</span>,
            <strong>@User.Identity.Name</strong>
        </p>
        <div class="home-clock">
            <span id="home-clock-hh">--</span><span class="colon">:</span><span id="home-clock-mm">--</span><span class="seconds">:<span id="home-clock-ss">--</span></span>
        </div>
        <p class="home-date" id="home-date-text"></p>
    </div>
</div>

@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}
