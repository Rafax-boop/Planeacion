@model Metas.AplicacionWeb.Models.ViewModels.VMUsuarioLogin
@{
    Layout = null;
    ViewData["Title"] = "Acceso";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Control de Seguimiento de Metas</title>
    <link rel="icon" type="image/png" href="~/img/corazon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/estilos-login.css" />
</head>
<body>
    <div class="login-page">

        <section class="login-panel-brand">
            <div class="orb orb-1"></div>
            <div class="orb orb-2"></div>
            <div class="orb orb-3"></div>
            <div class="orb orb-4"></div>
            <div class="orb orb-5"></div>

            <div class="brand-center">
                <img src="~/img/corazon.png" alt="Control de Seguimiento de Metas" class="brand-heart" />
                <h1 class="brand-title">
                    <span class="brand-title-strong">Control de Seguimiento</span>
                    <span class="brand-title-soft">de Metas</span>
                </h1>
            </div>

            <div class="brand-footer">
                <img src="~/img/familias-dif.png" alt="Familias Sistema Estatal DIF" class="brand-logo" />
                <img src="~/img/pensargrande.png" alt="Pensar en Grande" class="brand-logo" />
            </div>
        </section>

        <section class="login-panel-form">
            <div class="login-card-wrap">
                <div class="login-card">
                    <img src="~/img/corazon.png" alt="Control de Seguimiento de Metas" class="brand-heart-mobile" />

                    <div class="login-icon">
                        <i class="fa-solid fa-lock"></i>
                    </div>
                    <h2>Iniciar sesión</h2>
                    <p class="login-subtitle">Ingresa tus credenciales para acceder al sistema</p>

                    <form asp-controller="Acceso" asp-action="Login" method="post" novalidate>
                        <div class="field">
                            <input asp-for="Usuario" type="text" placeholder=" " autocomplete="username" autofocus />
                            <label asp-for="Usuario">Usuario</label>
                        </div>

                        <div class="field field-password">
                            <input asp-for="Password" type="password" placeholder=" " autocomplete="current-password" />
                            <label asp-for="Password">Contraseña</label>
                            <button type="button" class="toggle-password" data-target="Password" aria-label="Mostrar contraseña">
                                <i class="fa-regular fa-eye"></i>
                            </button>
                        </div>

                        @if (ViewData["Mensaje"] != null)
                        {
                            <p class="login-error">@ViewData["Mensaje"]</p>
                        }

                        <button type="submit" class="btn-login">Entrar</button>
                    </form>
                </div>

                <p class="login-caption">Gobierno del Estado de Puebla · Control de Seguimiento de Metas</p>
            </div>
        </section>

    </div>

    <script src="~/js/login.js"></script>
</body>
</html>
