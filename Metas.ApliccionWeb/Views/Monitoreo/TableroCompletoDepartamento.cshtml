@model Metas.AplicacionWeb.Models.ViewModels.VMDepartamentos
@{
    ViewData["Title"] = "Tablero Completo por Departamento";
}

<div class="container-fluid mt-4">

    @* Encabezado *@
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div class="titulo-vista-wrap mb-0">
            <h1 class="titulo-vista"><i class="fas fa-table me-2"></i> Tablero Completo por Departamento</h1>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Monitoreo", "Monitoreo")" class="btn-app-gris">
                <i class="fas fa-arrow-left"></i> Volver
            </a>
            <button type="button" class="btn-app-verde" id="btnExportarExcel">
                <i class="fas fa-file-excel"></i> Exportar Excel
            </button>
        </div>
    </div>

    @* Filtros *@
    <div class="card shadow-sm mb-4 rounded-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label fw-semibold small">Departamento</label>
                    <select class="form-select select2-simple" id="filtroDepartamento" asp-items="Model.ListaDepartamentos">
                        <option value="0">-- Todos los departamentos --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold small">Año Fiscal</label>
                    <select class="form-select select2-simple" id="filtroAno">
                        @{
                            var anoActual = DateTime.Now.Year;
                            var anoMaximo = anoActual + 1;
                            var anoMinimo = anoActual - 5;

                            for (int ano = anoMaximo; ano >= anoMinimo; ano--)
                            {
                                <option value="@ano" selected="@(ano == anoActual)">@ano</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="button" class="btn-app-rosa w-100 justify-content-center" id="btnFiltrar">
                        <i class="fas fa-search me-2"></i> Cargar Datos
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* Leyenda de colores *@
    <div class="mb-3 p-3 bg-white rounded-3 shadow-sm">
        <strong class="me-3">Leyenda:</strong>
        <span class="leyenda-item">
            <span class="leyenda-color" style="background-color: #c00000;"></span> Información General
        </span>
        <span class="leyenda-item">
            <span class="leyenda-color" style="background-color: #ffc107;"></span> Servicios Programados
        </span>
        <span class="leyenda-item">
            <span class="leyenda-color" style="background-color: #20c997;"></span> Servicios Realizados
        </span>
        <span class="leyenda-item">
            <span class="leyenda-color" style="background-color: #0dcaf0;"></span> Personas Programadas
        </span>
        <span class="leyenda-item">
            <span class="leyenda-color" style="background-color: #6f42c1;"></span> Personas Atendidas
        </span>
    </div>

    @* Tabla Principal *@
    <div class="contenedor-tabla bg-white">
        <table class="tabla-tablero" id="tablaTablero">
            <thead>
                @* ========================================
                   FILA 1: Títulos de sección principales
                   ======================================== *@
                <tr>
                    <th class="header-seccion-info" colspan="8" rowspan="3">INFORMACIÓN GENERAL</th>
                    <th class="header-seccion-programado" colspan="17" rowspan="3">SERVICIOS PROGRAMADOS</th>
                    <th class="header-seccion-realizado" colspan="17" rowspan="3">SERVICIOS REALIZADOS</th>
                    <th class="header-seccion-personas-prog" colspan="17" rowspan="3">PERSONAS PROGRAMADAS</th>
                    <th class="header-seccion-personas-atend" colspan="144">PERSONAS ATENDIDAS</th>
                </tr>

                @* ========================================
                   FILA 2: Meses para Personas Atendidas
                   ======================================== *@
                <tr>
                    @{
                        var meses = new[] { "ENE", "FEB", "MAR", "ABR", "MAY", "JUN", "JUL", "AGO", "SEP", "OCT", "NOV", "DIC" };
                        foreach (var mes in meses)
                        {
                            <th class="header-mes-personas-atend-sub" colspan="12">@mes</th>
                        }
                    }
                </tr>

                @* ========================================
                   FILA 3: Categorías de Personas Atendidas 
                   ======================================== *@
                <tr>
                    @for (int mes = 0; mes < 12; mes++)
                    {
                        <th class="header-detalle-personas-atend" rowspan="2">Hombre</th>
                        <th class="header-detalle-personas-atend" rowspan="2">Mujer</th>
                        <th class="header-detalle-personas-atend" rowspan="2">0-3 AÑOS</th>
                        <th class="header-detalle-personas-atend" rowspan="2">4-8 AÑOS</th>
                        <th class="header-detalle-personas-atend" rowspan="2">9-12 AÑOS</th>
                        <th class="header-detalle-personas-atend" rowspan="2">13-17 AÑOS</th>
                        <th class="header-detalle-personas-atend" rowspan="2">18-29 AÑOS</th>
                        <th class="header-detalle-personas-atend" rowspan="2">30-59 AÑOS</th>
                        <th class="header-detalle-personas-atend" rowspan="2">60+ AÑOS</th>
                        <th class="header-detalle-personas-atend" rowspan="2">No Definida</th>
                        <th class="header-detalle-personas-atend" rowspan="2">Indígenas</th>
                        <th class="header-total-mes-personas-atend" rowspan="2">TOTAL</th>
                    }
                </tr>

                @* ========================================
                   FILA 4: Subencabezados de columnas
                   - Las primeras 4 secciones: PP, COMP, ENE, FEB, etc.
                   ======================================== *@
                <tr class="fila-subencabezados">
                    <!-- Información General (8 columnas) -->
                    <th class="header-mes-info">PP</th>
                    <th class="header-mes-info">COMP</th>
                    <th class="header-mes-info">ACT</th>
                    <th class="header-mes-info col-descripcion">DESCRIPCIÓN</th>
                    <th class="header-mes-info">ÁREA</th>
                    <th class="header-mes-info">DEPTO</th>
                    <th class="header-mes-info col-programa">PROGRAMA</th>
                    <th class="header-mes-info">U.M.</th>

                    <!-- Servicios Programados (17 columnas: 12 meses + 4 trimestrales + total) -->
                    @{
                        var mesesCortos = new[] { "ENE", "FEB", "MAR", "ABR", "MAY", "JUN", "JUL", "AGO", "SEP", "OCT", "NOV", "DIC" };
                        for (int t = 0; t < 4; t++)
                        {
                            for (int m = 0; m < 3; m++)
                            {
                                <th class="header-mes-programado">@mesesCortos[t * 3 + m]</th>
                            }
                            <th class="header-mes-programado header-trim-prog">TRIM@(t + 1)</th>
                        }
                    }
                    <th class="header-mes-programado header-total-prog">TOTAL</th>

                    <!-- Servicios Realizados (17 columnas: 12 meses + 4 trimestrales + total) -->
                    @{
                        for (int t = 0; t < 4; t++)
                        {
                            for (int m = 0; m < 3; m++)
                            {
                                <th class="header-mes-realizado">@mesesCortos[t * 3 + m]</th>
                            }
                            <th class="header-mes-realizado header-trim-real">TRIM@(t + 1)</th>
                        }
                    }
                    <th class="header-mes-realizado header-total-real">TOTAL</th>

                    <!-- Personas Programadas (17 columnas: 12 meses + 4 trimestrales + total) -->
                    @{
                        for (int t = 0; t < 4; t++)
                        {
                            for (int m = 0; m < 3; m++)
                            {
                                <th class="header-mes-personas-prog">@mesesCortos[t * 3 + m]</th>
                            }
                            <th class="header-mes-personas-prog header-trim-pers-prog">TRIM@(t + 1)</th>
                        }
                    }
                    <th class="header-mes-personas-prog header-total-pers-prog">TOTAL</th>

                </tr>
            </thead>
            <tbody id="tbodyTablero">
                <tr>
                    <td colspan="203" class="text-center py-5 text-muted">
                        <i class="fas fa-filter fa-2x mb-3 d-block"></i>
                        Seleccione un año fiscal y presione "Cargar Datos" para ver la información.
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    @* Resumen General *@
    <div class="row mt-4 g-3">
        <div class="col-md-3 col-6">
            <div class="card card-resumen-small">
                <div class="card-body text-center">
                    <h6 class="text-muted">Total Registros</h6>
                    <h4 class="fw-bold text-dark" id="totalRegistros">0</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card card-resumen-small" style="border-left: 4px solid #ffc107;">
                <div class="card-body text-center">
                    <h6 class="text-muted">Total Programado</h6>
                    <h4 class="fw-bold" style="color: #d49a00;" id="totalProgramado">0</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card card-resumen-small" style="border-left: 4px solid #20c997;">
                <div class="card-body text-center">
                    <h6 class="text-muted">Total Realizado</h6>
                    <h4 class="fw-bold" style="color: #20c997;" id="totalRealizado">0</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card card-resumen-small" style="border-left: 4px solid #6f42c1;">
                <div class="card-body text-center">
                    <h6 class="text-muted">Personas Atendidas</h6>
                    <h4 class="fw-bold" style="color: #6f42c1;" id="totalPersonas">0</h4>
                </div>
            </div>
        </div>
    </div>

</div>

@* Loading Overlay *@
<div class="loading-overlay" id="loadingOverlay" style="display: none;">
    <div class="text-center">
        <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <p class="mt-3 fw-semibold text-muted">Cargando datos del tablero...</p>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/exceljs@4.4.0/dist/exceljs.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/file-saver@2.0.5/dist/FileSaver.min.js"></script>
    <script>
        // ========================================
        // VARIABLES GLOBALES
        // ========================================
        let datosTablero = [];

        // ========================================
        // FUNCIONES DE LOADING
        // ========================================
        function mostrarLoading() {
            document.getElementById('loadingOverlay').style.display = 'flex';
        }

        function ocultarLoading() {
            document.getElementById('loadingOverlay').style.display = 'none';
        }

        // ========================================
        // CARGAR DATOS
        // ========================================
        async function cargarDatosTablero() {
            const departamento = document.getElementById('filtroDepartamento').value;
            const anoFiscal = document.getElementById('filtroAno').value;
            const tbody = document.getElementById('tbodyTablero');

            mostrarLoading();

            try {
                const deptoParam = departamento ? `&departamento=${departamento}` : '&departamento=0';
                const response = await fetch(`/Monitoreo/ObtenerDatosTableroCompletoOptimizado?anoFiscal=${anoFiscal}${deptoParam}`);

                if (!response.ok) throw new Error('Error al cargar datos');

                const result = await response.json();

                if (!result.success) {
                    throw new Error(result.mensaje || 'Error desconocido');
                }

                datosTablero = result.datos;
                renderizarTabla(datosTablero);
                actualizarResumen(datosTablero);

            } catch (error) {
                console.error('Error:', error);
                tbody.innerHTML = `
                    <tr>
                        <td colspan="203" class="text-center py-5 text-danger">
                            <i class="fas fa-exclamation-triangle fa-2x mb-3 d-block"></i>
                            Error al cargar los datos: ${error.message}
                        </td>
                    </tr>
                `;
            } finally {
                ocultarLoading();
            }
        }

        // ========================================
        // RENDERIZAR TABLA
        // Estructura: 8 Info + 17 Prog + 17 Real + 17 PersProg + 144 PersAtend = 203 columnas
        // (Prog/Real/PersProg = 12 meses + 4 subtotales trimestrales + 1 total anual)
        // ========================================

        // Genera las 12 celdas de meses intercalando un subtotal trimestral cada 3 meses,
        // y agrega la celda de total anual al final.
        function generarCeldasMensualesConTrimestre(valoresMes, claseCelda, claseTrim, claseTotal, total) {
            let html = '';
            for (let t = 0; t < 4; t++) {
                let sumaTrim = 0;
                for (let m = 0; m < 3; m++) {
                    const valor = valoresMes[t * 3 + m] || 0;
                    sumaTrim += valor;
                    html += `<td class="${claseCelda}">${valor}</td>`;
                }
                html += `<td class="${claseTrim}">${sumaTrim}</td>`;
            }
            html += `<td class="${claseTotal}">${total || 0}</td>`;
            return html;
        }

        function renderizarTabla(datos) {
            const tbody = document.getElementById('tbodyTablero');

            if (!datos || datos.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="203" class="text-center py-5 text-muted">
                            <i class="fas fa-inbox fa-2x mb-3 d-block"></i>
                            No hay datos para mostrar.
                        </td>
                    </tr>
                `;
                return;
            }

            let html = '';

            datos.forEach((r) => {
                const prog = r.programado || {};
                const real = r.realizado || {};
                const persProg = r.personasProgramado || {};
                const persAtend = r.personasAtendidas || {};

                html += `<tr>`;

                // ============ INFORMACIÓN GENERAL (8 columnas) ============
                html += `
                    <td class="celda-info fw-bold">${r.pp || ''}</td>
                    <td class="celda-info">${r.componente || ''}</td>
                    <td class="celda-info">${r.actividad || ''}</td>
                    <td class="celda-info col-descripcion" title="${r.descripcionActividad || ''}">${r.descripcionActividad || ''}</td>
                    <td class="celda-info">${r.area || ''}</td>
                    <td class="celda-info">${r.departamento || ''}</td>
                    <td class="celda-info col-programa" title="${r.programaSocial || ''}">${r.programaSocial || ''}</td>
                    <td class="celda-info">${r.unidadMedida || ''}</td>
                `;

                // ============ SERVICIOS PROGRAMADOS (17 columnas) ============
                html += generarCeldasMensualesConTrimestre(
                    [prog.ene, prog.feb, prog.mar, prog.abr, prog.may, prog.jun, prog.jul, prog.ago, prog.sep, prog.oct, prog.nov, prog.dic],
                    'celda-programado', 'celda-trim-programado', 'celda-total-programado', prog.total
                );

                // ============ SERVICIOS REALIZADOS (17 columnas) ============
                html += generarCeldasMensualesConTrimestre(
                    [real.ene, real.feb, real.mar, real.abr, real.may, real.jun, real.jul, real.ago, real.sep, real.oct, real.nov, real.dic],
                    'celda-realizado', 'celda-trim-realizado', 'celda-total-realizado', real.total
                );

                // ============ PERSONAS PROGRAMADAS (17 columnas) ============
                html += generarCeldasMensualesConTrimestre(
                    [persProg.ene, persProg.feb, persProg.mar, persProg.abr, persProg.may, persProg.jun, persProg.jul, persProg.ago, persProg.sep, persProg.oct, persProg.nov, persProg.dic],
                    'celda-personas-prog', 'celda-trim-personas-prog', 'celda-total-personas-prog', persProg.total
                );

                // ============ PERSONAS ATENDIDAS (144 columnas = 12 meses × 12 categorías) ============
                // Mapeo según respuesta JSON del controlador ObtenerDatosTableroCompletoOptimizado
                for (let mes = 1; mes <= 12; mes++) {
                    const mesData = persAtend[mes] || {};

                    const hombre = mesData.hombres || 0;
                    const mujer = mesData.mujeres || 0;
                    const edad0_3 = mesData.edad0a3 || 0;
                    const edad4_8 = mesData.edad4a8 || 0;
                    const edad9_12 = mesData.edad9a12 || 0;
                    const edad13_17 = mesData.edad13a17 || 0;
                    const edad18_29 = mesData.edad18a29 || 0;
                    const edad30_59 = mesData.edad30a59 || 0;
                    const edad60_mas = mesData.edad60mas || 0;
                    const noDefinida = mesData.noEspecifica || 0;
                    const indigenas = mesData.indigenas || 0;

                    // Total del mes = Hombres + Mujeres
                    const totalMes = hombre + mujer;

                    // 12 celdas por mes
                    html += `
                        <td class="celda-personas-atend-detalle">${hombre}</td>
                        <td class="celda-personas-atend-detalle">${mujer}</td>
                        <td class="celda-personas-atend-detalle">${edad0_3}</td>
                        <td class="celda-personas-atend-detalle">${edad4_8}</td>
                        <td class="celda-personas-atend-detalle">${edad9_12}</td>
                        <td class="celda-personas-atend-detalle">${edad13_17}</td>
                        <td class="celda-personas-atend-detalle">${edad18_29}</td>
                        <td class="celda-personas-atend-detalle">${edad30_59}</td>
                        <td class="celda-personas-atend-detalle">${edad60_mas}</td>
                        <td class="celda-personas-atend-detalle">${noDefinida}</td>
                        <td class="celda-personas-atend-detalle">${indigenas}</td>
                        <td class="celda-total-mes-personas-atend">${totalMes}</td>
                    `;
                }

                html += `</tr>`;
            });

            tbody.innerHTML = html;
        }

        // ========================================
        // ACTUALIZAR RESUMEN
        // ========================================
        function actualizarResumen(datos) {
            let totalProg = 0;
            let totalReal = 0;
            let totalPers = 0;

            datos.forEach(r => {
                totalProg += r.programado?.total || 0;
                totalReal += r.realizado?.total || 0;

                const pa = r.personasAtendidas || {};
                for (let m = 1; m <= 12; m++) {
                    const mes = pa[m] || {};
                    totalPers += (mes.hombres || 0) + (mes.mujeres || 0);
                }
            });

            document.getElementById('totalRegistros').textContent = datos.length.toLocaleString();
            document.getElementById('totalProgramado').textContent = totalProg.toLocaleString();
            document.getElementById('totalRealizado').textContent = totalReal.toLocaleString();
            document.getElementById('totalPersonas').textContent = totalPers.toLocaleString();
        }

        // ========================================
        // AJUSTE AUTOMÁTICO DE ANCHO/ALTO (ExcelJS)
        // ========================================
        // Mide texto con canvas (igual que "autoajustar" de Excel) en vez de
        // aproximar por cantidad de caracteres, para que el resultado coincida
        // con lo que se ve al hacer doble clic en el borde de una columna/fila.
        function crearMedidorTexto(fontFamily = 'Calibri, "Segoe UI", Arial, sans-serif', fontSize = 11) {
            const canvas = document.createElement('canvas');
            const ctx = canvas.getContext('2d');
            ctx.font = `${fontSize}px ${fontFamily}`;
            return texto => ctx.measureText(texto === null || texto === undefined ? '' : texto.toString()).width;
        }

        // Ajusta el ancho de cada columna al contenido más largo que contiene.
        // columnasFijas permite fijar un ancho para columnas de texto largo,
        // que en su lugar usan wrapText + alto de fila automático.
        function autoAjustarColumnas(sheet, { anchoMinimo = 6, anchoMaximo = 40, columnasFijas = {} } = {}) {
            const medir = crearMedidorTexto();
            const anchoDigito = medir('0') || 7;
            sheet.columns.forEach((columna, idx) => {
                const numCol = idx + 1;
                if (columnasFijas[numCol]) {
                    columna.width = columnasFijas[numCol];
                    return;
                }
                let maxPixeles = 0;
                columna.eachCell({ includeEmpty: false }, celda => {
                    if (celda.value === null || celda.value === undefined) return;
                    celda.value.toString().split('\n').forEach(linea => {
                        const ancho = medir(linea);
                        if (ancho > maxPixeles) maxPixeles = ancho;
                    });
                });
                const anchoCaracteres = maxPixeles / anchoDigito + 1.5;
                columna.width = Math.min(Math.max(anchoCaracteres, anchoMinimo), anchoMaximo);
            });
        }

        // Calcula el alto de cada fila (desde filaInicio) simulando el mismo
        // ajuste de línea por palabras que hace Excel con wrapText, según el
        // ancho en píxeles ya asignado a cada columna.
        function autoAjustarAltoFilas(sheet, filaInicio, { alturaMinima = 18, alturaPorLinea = 14 } = {}) {
            const medir = crearMedidorTexto();
            const anchoDigito = medir('0') || 7;
            const margenCelda = 6;
            for (let numFila = filaInicio; numFila <= sheet.rowCount; numFila++) {
                const fila = sheet.getRow(numFila);
                let maxLineas = 1;
                fila.eachCell({ includeEmpty: false }, celda => {
                    if (!celda.alignment || !celda.alignment.wrapText) return;
                    if (celda.value === null || celda.value === undefined) return;
                    const anchoColumnaPx = (sheet.getColumn(celda.col).width || 8) * anchoDigito;
                    const anchoUtilPx = Math.max(anchoColumnaPx - margenCelda, anchoDigito);

                    celda.value.toString().split('\n').forEach(parrafo => {
                        const palabras = parrafo.split(' ');
                        let lineaActual = '';
                        let lineas = 1;
                        palabras.forEach(palabra => {
                            const pruebaLinea = lineaActual ? `${lineaActual} ${palabra}` : palabra;
                            if (medir(pruebaLinea) > anchoUtilPx && lineaActual) {
                                lineas++;
                                lineaActual = palabra;
                            } else {
                                lineaActual = pruebaLinea;
                            }
                        });
                        if (lineas > maxLineas) maxLineas = lineas;
                    });
                });
                fila.height = Math.max(alturaMinima, maxLineas * alturaPorLinea);
            }
        }

        // ========================================
        // EXPORTAR A EXCEL CON ESTILOS (ExcelJS)
        // ========================================
        async function exportarExcel() {
            if (!datosTablero || datosTablero.length === 0) {
                Swal.fire('Aviso', 'No hay datos para exportar', 'warning');
                return;
            }

            mostrarLoading();

            try {
                const workbook = new ExcelJS.Workbook();
                const sheet = workbook.addWorksheet('Tablero Completo');

                // ========== COLORES ==========
                const colores = {
                    info: { header: 'FFC00000', subheader: 'FFA00000', celda: 'FFFFF5F5' },
                    programado: { header: 'FFFFC107', subheader: 'FFE0A800', celda: 'FFFFFBEB', total: 'FFD49A00', trimHeader: 'FFB8860B', trim: 'FFFFE6A1' },
                    realizado: { header: 'FF20C997', subheader: 'FF1AA179', celda: 'FFE6FFF7', total: 'FF148060', trimHeader: 'FF0E6650', trim: 'FFA6EAD9' },
                    personasProg: { header: 'FF0DCAF0', subheader: 'FF0BB5D6', celda: 'FFE6FCFF', total: 'FF0891B2', trimHeader: 'FF066A80', trim: 'FFA6ECF7' },
                    personasAtend: { header: 'FF6F42C1', subheader: 'FF5A32A3', celda: 'FFF3E8FF', total: 'FF4C1D95' }
                };

                // ========== ESTILOS BASE ==========
                const estiloHeaderPrincipal = (color, textColor = 'FFFFFFFF') => ({
                    font: { bold: true, size: 12, color: { argb: textColor } },
                    fill: { type: 'pattern', pattern: 'solid', fgColor: { argb: color } },
                    alignment: { horizontal: 'center', vertical: 'middle', wrapText: true },
                    border: { top: {style:'thin'}, left: {style:'thin'}, bottom: {style:'thin'}, right: {style:'thin'} }
                });

                const estiloSubheader = (color, textColor = 'FFFFFFFF') => ({
                    font: { bold: true, size: 9, color: { argb: textColor } },
                    fill: { type: 'pattern', pattern: 'solid', fgColor: { argb: color } },
                    alignment: { horizontal: 'center', vertical: 'middle', wrapText: true },
                    border: { top: {style:'thin'}, left: {style:'thin'}, bottom: {style:'thin'}, right: {style:'thin'} }
                });

                const estiloCelda = (color) => ({
                    font: { size: 10 },
                    fill: { type: 'pattern', pattern: 'solid', fgColor: { argb: color } },
                    alignment: { horizontal: 'center', vertical: 'middle' },
                    border: { top: {style:'thin'}, left: {style:'thin'}, bottom: {style:'thin'}, right: {style:'thin'} }
                });

                // ========== ESTRUCTURA DE COLUMNAS ==========
                // Info: 1-8 | Programado: 9-25 | Realizado: 26-42 | PersProg: 43-59 | PersAtend: 60-203
                // Programado/Realizado/PersProg = 17 columnas cada uno (12 meses + 4 subtotales trimestrales + 1 total anual)
                const mesesNombres = ['ENE', 'FEB', 'MAR', 'ABR', 'MAY', 'JUN', 'JUL', 'AGO', 'SEP', 'OCT', 'NOV', 'DIC'];
                const categoriasPA = ['Hombre', 'Mujer', '0-3', '4-8', '9-12', '13-17', '18-29', '30-59', '60+', 'No Def.', 'Indíg.', 'TOTAL'];
                const COL_PROG = 9, COL_REAL = 26, COL_PERSPROG = 43, COL_PERSATEND = 60;

                // Genera las 17 etiquetas de una sección mensual: 12 meses + TRIM1..TRIM4 intercalados + TOTAL
                function headersMensualesConTrimestre() {
                    const out = [];
                    for (let t = 0; t < 4; t++) {
                        out.push(...mesesNombres.slice(t * 3, t * 3 + 3));
                        out.push(`TRIM${t + 1}`);
                    }
                    out.push('TOTAL');
                    return out;
                }
                // Posición (0-16) dentro de una sección mensual: 'trim' cada 4ta columna, 'total' la última, si no 'mes'
                function tipoColumnaMensual(pos) {
                    if (pos === 16) return 'total';
                    if ((pos + 1) % 4 === 0) return 'trim';
                    return 'mes';
                }

                // Escribe una fila de datos de una sección mensual (17 columnas), calculando
                // el subtotal de cada trimestre y dejando el total anual en la última columna.
                function escribirDatosMensualTrimestre(filaNum, colInicio, valoresMes, total, colorSet, totalFontColor) {
                    let offset = 0;
                    for (let t = 0; t < 4; t++) {
                        let sumaTrim = 0;
                        for (let m = 0; m < 3; m++) {
                            const valor = valoresMes[t * 3 + m] || 0;
                            sumaTrim += valor;
                            const celda = sheet.getCell(filaNum, colInicio + offset);
                            celda.value = valor;
                            Object.assign(celda, estiloCelda(colorSet.celda));
                            offset++;
                        }
                        const celdaTrim = sheet.getCell(filaNum, colInicio + offset);
                        celdaTrim.value = sumaTrim;
                        Object.assign(celdaTrim, estiloCelda(colorSet.trim));
                        celdaTrim.font = { bold: true, size: 10 };
                        offset++;
                    }
                    const celdaTotal = sheet.getCell(filaNum, colInicio + offset);
                    celdaTotal.value = total || 0;
                    Object.assign(celdaTotal, estiloCelda(colorSet.total));
                    celdaTotal.font = totalFontColor ? { bold: true, size: 10, color: { argb: totalFontColor } } : { bold: true, size: 10 };
                }

                // "Centrar en la selección": en vez de combinar celdas (mergeCells), se deja el
                // valor solo en la primera celda del rango y se aplica alignment centerContinuous
                // a todas las celdas del rango, que es como Excel centra visualmente sin fusionar.
                function centrarEnSeleccion(filaNum, colInicio, colFin, valor, estilo) {
                    for (let col = colInicio; col <= colFin; col++) {
                        const celda = sheet.getCell(filaNum, col);
                        Object.assign(celda, estilo);
                        celda.alignment = { ...celda.alignment, horizontal: 'centerContinuous' };
                    }
                    sheet.getCell(filaNum, colInicio).value = valor;
                }

                // ========== FILA 1: TÍTULOS PRINCIPALES (centrado en la selección) ==========
                const fila1 = sheet.getRow(1);
                fila1.height = 30;

                centrarEnSeleccion(1, 1, 8, 'INFORMACIÓN GENERAL', estiloHeaderPrincipal(colores.info.header));
                centrarEnSeleccion(1, COL_PROG, COL_REAL - 1, 'SERVICIOS PROGRAMADOS', estiloHeaderPrincipal(colores.programado.header, 'FF000000'));
                centrarEnSeleccion(1, COL_REAL, COL_PERSPROG - 1, 'SERVICIOS REALIZADOS', estiloHeaderPrincipal(colores.realizado.header));
                centrarEnSeleccion(1, COL_PERSPROG, COL_PERSATEND - 1, 'PERSONAS PROGRAMADAS', estiloHeaderPrincipal(colores.personasProg.header, 'FF000000'));
                centrarEnSeleccion(1, COL_PERSATEND, COL_PERSATEND + 143, 'PERSONAS ATENDIDAS', estiloHeaderPrincipal(colores.personasAtend.header));

                // ========== FILA 2: MESES / TRIMESTRES ==========
                const fila2 = sheet.getRow(2);
                fila2.height = 25;

                // Info (vacío pero con estilo)
                for (let col = 1; col <= 8; col++) {
                    const celda = sheet.getCell(2, col);
                    Object.assign(celda, estiloSubheader(colores.info.subheader));
                }

                // Prog / Real / PersProg: 12 meses + 4 TRIM + TOTAL
                const headersSeccionMensual = headersMensualesConTrimestre();
                [
                    { colInicio: COL_PROG, colorSet: colores.programado, textColor: 'FF000000' },
                    { colInicio: COL_REAL, colorSet: colores.realizado, textColor: 'FFFFFFFF' },
                    { colInicio: COL_PERSPROG, colorSet: colores.personasProg, textColor: 'FF000000' }
                ].forEach(({ colInicio, colorSet, textColor }) => {
                    for (let i = 0; i < 17; i++) {
                        const celda = sheet.getCell(2, colInicio + i);
                        celda.value = headersSeccionMensual[i];
                        const tipo = tipoColumnaMensual(i);
                        const color = tipo === 'trim' ? colorSet.trimHeader : colorSet.subheader;
                        Object.assign(celda, estiloSubheader(color, textColor));
                    }
                });

                // PersAtend - Meses centrados en la selección (cada mes = 12 columnas, sin combinar)
                for (let m = 0; m < 12; m++) {
                    const startCol = COL_PERSATEND + (m * 12);
                    const endCol = startCol + 11;
                    centrarEnSeleccion(2, startCol, endCol, mesesNombres[m], estiloSubheader(colores.personasAtend.subheader));
                }

                // ========== FILA 3: SUBENCABEZADOS ==========
                const fila3 = sheet.getRow(3);
                fila3.height = 20;

                // Info headers
                const headersInfo = ['PP', 'COMP', 'ACT', 'DESCRIPCIÓN', 'ÁREA', 'DEPTO', 'PROGRAMA', 'U.M.'];
                for (let i = 0; i < 8; i++) {
                    const celda = sheet.getCell(3, i + 1);
                    celda.value = headersInfo[i];
                    Object.assign(celda, estiloSubheader(colores.info.subheader));
                }

                // Prog / Real / PersProg (vacío, ya tienen meses/trimestres en fila 2)
                [
                    { colInicio: COL_PROG, colorSet: colores.programado, textColor: 'FF000000' },
                    { colInicio: COL_REAL, colorSet: colores.realizado, textColor: 'FFFFFFFF' },
                    { colInicio: COL_PERSPROG, colorSet: colores.personasProg, textColor: 'FF000000' }
                ].forEach(({ colInicio, colorSet, textColor }) => {
                    for (let i = 0; i < 17; i++) {
                        const celda = sheet.getCell(3, colInicio + i);
                        const tipo = tipoColumnaMensual(i);
                        const color = tipo === 'trim' ? colorSet.trimHeader : colorSet.subheader;
                        Object.assign(celda, estiloSubheader(color, textColor));
                    }
                });

                // PersAtend - Categorías para cada mes
                for (let m = 0; m < 12; m++) {
                    for (let c = 0; c < 12; c++) {
                        const col = COL_PERSATEND + (m * 12) + c;
                        const celda = sheet.getCell(3, col);
                        celda.value = categoriasPA[c];
                        Object.assign(celda, estiloSubheader(colores.personasAtend.subheader));
                    }
                }

                // ========== FILAS DE DATOS ==========
                let filaActual = 4;
                datosTablero.forEach((r, index) => {
                    const prog = r.programado || {};
                    const real = r.realizado || {};
                    const persProg = r.personasProgramado || {};
                    const persAtend = r.personasAtendidas || {};

                    const fila = sheet.getRow(filaActual);
                    fila.height = 18;

                    // Info General (8 columnas)
                    const datosInfo = [r.pp, r.componente, r.actividad, r.descripcionActividad, r.area, r.departamento, r.programaSocial, r.unidadMedida];
                    for (let i = 0; i < 8; i++) {
                        const celda = sheet.getCell(filaActual, i + 1);
                        celda.value = datosInfo[i] || '';
                        Object.assign(celda, estiloCelda(colores.info.celda));
                        if (i === 3 || i === 4 || i === 5 || i === 6) celda.alignment = { horizontal: 'left', vertical: 'middle', wrapText: true };
                    }

                    // Programado (17 columnas: 12 meses + 4 subtotales trimestrales + total anual)
                    escribirDatosMensualTrimestre(filaActual, COL_PROG,
                        [prog.ene, prog.feb, prog.mar, prog.abr, prog.may, prog.jun, prog.jul, prog.ago, prog.sep, prog.oct, prog.nov, prog.dic],
                        prog.total, colores.programado, null);

                    // Realizado (17 columnas)
                    escribirDatosMensualTrimestre(filaActual, COL_REAL,
                        [real.ene, real.feb, real.mar, real.abr, real.may, real.jun, real.jul, real.ago, real.sep, real.oct, real.nov, real.dic],
                        real.total, colores.realizado, 'FFFFFFFF');

                    // Personas Programadas (17 columnas)
                    escribirDatosMensualTrimestre(filaActual, COL_PERSPROG,
                        [persProg.ene, persProg.feb, persProg.mar, persProg.abr, persProg.may, persProg.jun, persProg.jul, persProg.ago, persProg.sep, persProg.oct, persProg.nov, persProg.dic],
                        persProg.total, colores.personasProg, null);

                    // Personas Atendidas (144 columnas = 12 meses × 12 categorías)
                    for (let mes = 1; mes <= 12; mes++) {
                        const mesData = persAtend[mes] || {};
                        const hombre = mesData.hombres || 0;
                        const mujer = mesData.mujeres || 0;
                        const datosMes = [
                            hombre, mujer,
                            mesData.edad0a3 || 0, mesData.edad4a8 || 0, mesData.edad9a12 || 0,
                            mesData.edad13a17 || 0, mesData.edad18a29 || 0, mesData.edad30a59 || 0,
                            mesData.edad60mas || 0, mesData.noEspecifica || 0, mesData.indigenas || 0,
                            hombre + mujer
                        ];

                        for (let c = 0; c < 12; c++) {
                            const col = COL_PERSATEND + ((mes - 1) * 12) + c;
                            const celda = sheet.getCell(filaActual, col);
                            celda.value = datosMes[c];
                            if (c === 11) {
                                Object.assign(celda, estiloCelda(colores.personasAtend.total));
                                celda.font = { bold: true, size: 9, color: { argb: 'FFFFFFFF' } };
                            } else {
                                Object.assign(celda, estiloCelda(colores.personasAtend.celda));
                            }
                        }
                    }

                    filaActual++;
                });

                // ========== AJUSTE AUTOMÁTICO DE ANCHO Y ALTO ==========
                autoAjustarColumnas(sheet, { columnasFijas: { 4: 35, 7: 25 } });
                autoAjustarAltoFilas(sheet, 4);

                // ========== CONGELAR PANELES ==========
                sheet.views = [{ state: 'frozen', xSplit: 4, ySplit: 3 }];

                // ========== DESCARGAR ==========
                const buffer = await workbook.xlsx.writeBuffer();
                const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });

                const fecha = new Date().toISOString().split('T')[0];
                const depto = document.getElementById('filtroDepartamento');
                const nombreDepto = depto.options[depto.selectedIndex]?.text || 'General';
                saveAs(blob, `Tablero_${nombreDepto}_${fecha}.xlsx`);

                Swal.fire('Éxito', 'Excel generado correctamente con formato', 'success');

            } catch (error) {
                console.error('Error:', error);
                Swal.fire('Error', `No se pudo generar el Excel: ${error.message}`, 'error');
            } finally {
                ocultarLoading();
            }
        }

        // ========================================
        // INICIALIZACIÓN
        // ========================================
        document.addEventListener('DOMContentLoaded', function() {
            $('.select2-simple').select2({ width: '100%', language: 'es', minimumResultsForSearch: 8 });

            document.getElementById('btnFiltrar').addEventListener('click', cargarDatosTablero);
            document.getElementById('btnExportarExcel').addEventListener('click', exportarExcel);

            $('#filtroDepartamento').on('change', function() {
                cargarDatosTablero();
            });

            @if (ViewBag.AnoFiscalSeleccionado != null)
            {
                    <text>
                    $('#filtroAno').val('@ViewBag.AnoFiscalSeleccionado').trigger('change.select2');
                    </text>
            }
            @if (ViewBag.DepartamentoSeleccionado != null)
            {
                    <text>
                    $('#filtroDepartamento').val('@ViewBag.DepartamentoSeleccionado').trigger('change.select2');
                    </text>
            }
            @if (ViewBag.AnoFiscalSeleccionado != null || ViewBag.DepartamentoSeleccionado != null)
            {
                    <text>
                    cargarDatosTablero();
                    </text>
            }
        });
    </script>
}
