@{
    ViewData["Title"] = "Tablero de Control";
    int numeroRegistros = ViewBag.NumeroRegistros ?? 0;
    int anoFiscal = ViewBag.AnoFiscal ?? DateTime.Now.Year;
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div class="titulo-vista-wrap mb-0">
            <h1 class="titulo-vista"><i class="fa-solid fa-gauge-high me-2"></i>Tablero de Control</h1>
            <span class="subtitulo-vista" id="infoEncabezado">- Ejercicio Fiscal: @anoFiscal · Cargando...</span>
        </div>
        <a asp-controller="Monitoreo" asp-action="Monitoreo" class="btn-app-gris" onclick="if (window.history.length > 1) { event.preventDefault(); window.history.back(); }">
            <i class="fa-solid fa-arrow-left"></i> Volver al Monitoreo
        </a>
    </div>

    <div id="contenedor-tableros">
        <!-- Los tableros se generarán aquí automáticamente -->
    </div>
</div>

@section Scripts {
    <script>
        let datosTablero = [];
        let llenadoInterno = {};
        const anoFiscal = @ViewBag.AnoFiscal;
        const departamento = @ViewBag.Departamento;

        const MESES = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
        const MESES_LABEL = { ene: 'Ene', feb: 'Feb', mar: 'Mar', abr: 'Abr', may: 'May', jun: 'Jun', jul: 'Jul', ago: 'Ago', sep: 'Sep', oct: 'Oct', nov: 'Nov', dic: 'Dic' };

        $(document).ready(async function () {
            const contenedor = $('#contenedor-tableros');

            contenedor.html(`
                    <div class="text-center py-5">
                        <div class="spinner-border tablero-spinner" role="status" style="width: 3rem; height: 3rem;">
                            <span class="visually-hidden">Cargando...</span>
                        </div>
                        <p class="mt-3 text-muted fw-semibold">Cargando tableros de control...</p>
                    </div>
                `);

            try {
                const response = await fetch(`/Monitoreo/ObtenerDatosTableroControl?anoFiscal=${anoFiscal}&departamento=${departamento}`);

                if (!response.ok) {
                    throw new Error('Error al cargar los datos del servidor');
                }

                const result = await response.json();

                if (!result.success) {
                    throw new Error(result.mensaje || 'Error desconocido al procesar los datos');
                }

                datosTablero = result.datos;
                llenadoInterno = result.llenadoInterno;

                $('#infoEncabezado').text(`- Ejercicio Fiscal: ${anoFiscal} · Total de Actividades: ${datosTablero.length}`);

                contenedor.empty();

                if (datosTablero.length > 0) {
                    datosTablero.forEach((item, index) => {
                        const numeroTablero = index + 1;
                        const tableroHTML = crearTablero(numeroTablero, item);
                        contenedor.append(tableroHTML);
                    });
                } else {
                    contenedor.html(`
                            <div class="sin-registros">
                                <i class="fa-solid fa-circle-info"></i><br>
                                <span>No se encontraron registros para los criterios seleccionados.</span>
                            </div>
                        `);
                }

            } catch (error) {
                console.error('Error al cargar datos:', error);
                contenedor.html(`
                        <div class="sin-registros">
                            <i class="fa-solid fa-triangle-exclamation text-tablero-error"></i><br>
                            <span>${error.message}</span><br>
                            <button class="btn-app-gris mt-3" onclick="location.reload()">
                                <i class="fa-solid fa-rotate-right"></i> Reintentar
                            </button>
                        </div>
                    `);
            }
        });

        // Clasificación semántica de un porcentaje de avance: cada nivel se mapea
        // a un sufijo compartido por badge-estatus-X, tablero-progress-bar-X y
        // text-tablero-X, para no duplicar los cortes (115/95/85/70) en dos sitios.
        function nivelPorcentaje(porcentaje) {
            if (porcentaje >= 115) return 'info';
            if (porcentaje >= 95) return 'success';
            if (porcentaje >= 85) return 'warning';
            if (porcentaje >= 70) return 'alerta';
            return 'error';
        }

        function crearTablero(numeroTablero, data) {

            if (!data || !data.programado || !data.realizado) {
                console.error("Datos inválidos para tablero:", numeroTablero, data);
                return '<div class="sin-registros">Datos incompletos para este registro</div>';
            }

            const porcentajeAnual = (data.realizado.total > 0 && data.programado.total > 0) ?
                Math.round((data.realizado.total / data.programado.total) * 100) : 0;

            const calcularPorcentajeMes = (mes) => {
                const prog = (data.programado && data.programado[mes]) || 0;
                const real = (data.realizado && data.realizado[mes]) || 0;
                return prog > 0 ? Math.round((real / prog) * 100) : 0;
            };

            const calcularPorcentajeTrimestre = (m1, m2, m3) => {
                const progTotal = (data.programado[m1] || 0) + (data.programado[m2] || 0) + (data.programado[m3] || 0);
                const realTotal = (data.realizado[m1] || 0) + (data.realizado[m2] || 0) + (data.realizado[m3] || 0);
                return progTotal > 0 ? Math.round((realTotal / progTotal) * 100) : 0;
            };

            const trimestres = [
                { label: '1er Trimestre', pct: calcularPorcentajeTrimestre('ene', 'feb', 'mar') },
                { label: '2do Trimestre', pct: calcularPorcentajeTrimestre('abr', 'may', 'jun') },
                { label: '3er Trimestre', pct: calcularPorcentajeTrimestre('jul', 'ago', 'sep') },
                { label: '4to Trimestre', pct: calcularPorcentajeTrimestre('oct', 'nov', 'dic') }
            ];

            const nivelAnual = nivelPorcentaje(porcentajeAnual);

            return `
                <div class="ficha-seccion tablero-card" data-tablero="${numeroTablero}">

                    <div class="tablero-card-header">
                        <div>
                            <h4 class="tablero-card-titulo">${data.componente} / ${data.actividad}</h4>
                            <p class="tablero-card-desc">${data.descripcionActividad}</p>
                            ${data.programaSocial ? `<span class="tablero-card-meta">${data.programaSocial}</span>` : ''}
                        </div>
                        <div class="tablero-card-acciones">
                            <span class="badge-estatus badge-estatus-neutral">ID Proceso ${data.idProceso}</span>
                            <button class="btn-app-gris btn-tablero-pdf" onclick="exportarTableroComoImagen(this)">
                                <i class="fa-solid fa-file-pdf"></i> Exportar PDF
                            </button>
                        </div>
                    </div>

                    <div class="modal-seccion">
                        <h6 class="modal-seccion-titulo">Información del Programa</h6>
                        <div class="tablero-info-grid">
                            <div>
                                <span class="tablero-info-label">Componente</span>
                                <span class="tablero-info-valor">${data.componente}</span>
                            </div>
                            <div>
                                <span class="tablero-info-label">Número de Actividad</span>
                                <span class="tablero-info-valor">${data.actividad}</span>
                            </div>
                            <div>
                                <span class="tablero-info-label">Programa Social</span>
                                <span class="tablero-info-valor">${data.programaSocial || 'N/A'}</span>
                            </div>
                            <div>
                                <span class="tablero-info-label">Unidad de Medida</span>
                                <span class="tablero-info-valor">${data.unidadMedida || 'N/A'}</span>
                            </div>
                        </div>
                    </div>

                    <div class="modal-seccion">
                        <h6 class="modal-seccion-titulo">Calendarización Anual</h6>
                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="tablero-subtitulo tablero-subtitulo-rosa">Programado</div>
                                <div class="modal-meses-grid">
                                    ${MESES.map(mes => `
                                        <div class="modal-mes-col">
                                            <div class="ficha-mes-header">${MESES_LABEL[mes]}</div>
                                            <div class="tablero-valor">${data.programado[mes] || 0}</div>
                                        </div>`).join('')}
                                </div>
                                <div class="tablero-total">Total: <strong>${data.programado.total}</strong></div>
                            </div>
                            <div class="col-md-6">
                                <div class="tablero-subtitulo tablero-subtitulo-verde">Realizado</div>
                                <div class="modal-meses-grid">
                                    ${MESES.map(mes => `
                                        <div class="modal-mes-col">
                                            <div class="ficha-mes-header ficha-mes-header-verde">${MESES_LABEL[mes]}</div>
                                            <div class="tablero-valor">${data.realizado[mes] || 0}</div>
                                        </div>`).join('')}
                                </div>
                                <div class="tablero-total">Total: <strong>${data.realizado.total}</strong></div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-seccion">
                        <h6 class="modal-seccion-titulo">Avance Mensual</h6>
                        <div class="tablero-avance-grid">
                            ${MESES.map(mes => {
                                const pct = calcularPorcentajeMes(mes);
                                const nivel = nivelPorcentaje(pct);
                                return `
                                    <div class="modal-mes-col">
                                        <div class="ficha-mes-header">${MESES_LABEL[mes]}</div>
                                        <span class="badge-estatus badge-estatus-${nivel}">${pct}%</span>
                                    </div>`;
                            }).join('')}
                        </div>
                    </div>

                    <div class="modal-seccion">
                        <h6 class="modal-seccion-titulo">Desempeño Trimestral y Anual</h6>
                        <div class="row g-3">
                            <div class="col-md-8">
                                <div class="tablero-trimestres">
                                    ${trimestres.map(t => {
                                        const nivel = nivelPorcentaje(t.pct);
                                        return `
                                            <div class="tablero-trimestre-card">
                                                <span class="tablero-trimestre-label">${t.label}</span>
                                                <div class="tablero-trimestre-pct text-tablero-${nivel}">${t.pct}%</div>
                                                <div class="tablero-progress">
                                                    <div class="tablero-progress-bar tablero-progress-bar-${nivel}" style="width: ${Math.min(t.pct, 100)}%"></div>
                                                </div>
                                            </div>`;
                                    }).join('')}
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="tablero-anual">
                                    <span class="tablero-trimestre-label">Avance Anual</span>
                                    <div class="tablero-anual-pct text-tablero-${nivelAnual}">${porcentajeAnual}%</div>
                                    <div class="tablero-progress">
                                        <div class="tablero-progress-bar tablero-progress-bar-${nivelAnual}" style="width: ${Math.min(porcentajeAnual, 100)}%"></div>
                                    </div>
                                    <div class="tablero-anual-stats">
                                        <div>
                                            <span class="tablero-anual-stat-label">Programado</span>
                                            <span class="tablero-anual-stat-valor text-tablero-primary">${data.programado.total}</span>
                                        </div>
                                        <div>
                                            <span class="tablero-anual-stat-label">Realizado</span>
                                            <span class="tablero-anual-stat-valor text-tablero-success">${data.realizado.total}</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                `;
        }

        async function exportarTableroComoImagen(boton) {

            const tablero = $(boton).closest('.tablero-card');

            if (!tablero.length) {
                Swal.fire({ icon: 'error', title: 'Error', text: 'No se encontró el tablero para exportar', confirmButtonText: 'Entendido' });
                return;
            }

            const numeroTablero = tablero.data('tablero');
            const componente = tablero.find('.tablero-card-titulo').first().text().trim();
            const idProceso = tablero.find('.badge-estatus-neutral').first().text().trim();

            const botonOriginal = $(boton).html();
            $(boton).html('<i class="fa-solid fa-spinner fa-spin"></i> Generando PDF...').prop('disabled', true);

            try {
                // Clonar el tablero para no afectar el original
                const tableroClonado = tablero.clone();

                // Remover el botón de exportar y el badge de ID del clon
                tableroClonado.find('.tablero-card-acciones').remove();
                tableroClonado.css({
                    'position': 'absolute',
                    'left': '-9999px',
                    'top': '0',
                    'background': 'white',
                    'padding': '20px',
                    'width': '1200px'
                });
                $('body').append(tableroClonado);

                const canvas = await html2canvas(tableroClonado[0], {
                    scale: 1.2,
                    useCORS: true,
                    logging: false,
                    backgroundColor: '#ffffff'
                });

                tableroClonado.remove();

                const { jsPDF } = window.jspdf;
                const pdf = new jsPDF({
                    orientation: 'portrait',
                    unit: 'mm',
                    format: 'letter'
                });

                const pageWidth = pdf.internal.pageSize.getWidth();
                const pageHeight = pdf.internal.pageSize.getHeight();
                const margin = 15;

                const fechaActual = new Date().toLocaleDateString('es-MX', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                });

                const anoFiscal = (llenadoInterno && llenadoInterno.Ano) ? llenadoInterno.Ano : new Date().getFullYear();
                const alturaEncabezado = 42;

                // Fondo BLANCO del encabezado
                pdf.setFillColor(255, 255, 255);
                pdf.rect(0, 0, pageWidth, alturaEncabezado, 'F');

                // Borde inferior gris
                pdf.setDrawColor(200, 200, 200);
                pdf.setLineWidth(0.5);
                pdf.line(0, alturaEncabezado, pageWidth, alturaEncabezado);

                // Función helper para cargar imagen con promesa
                const cargarImagen = (src) => {
                    return new Promise((resolve, reject) => {
                        const img = new Image();
                        img.onload = () => resolve(img);
                        img.onerror = reject;
                        img.src = src;
                    });
                };

                // Cargar ambos logos
                try {
                    const logoIzquierdo = await cargarImagen('/img/png-gob.png');
                    const anchoLogoIzq = 24.5;
                    const aspectRatioIzq = logoIzquierdo.width / logoIzquierdo.height;
                    const altoLogoIzq = anchoLogoIzq / aspectRatioIzq;
                    const yPosLogoIzq = (alturaEncabezado - altoLogoIzq) / 2;

                    pdf.addImage(logoIzquierdo, 'PNG', 15, yPosLogoIzq, anchoLogoIzq, altoLogoIzq);
                } catch (error) {
                    console.warn('No se pudo cargar logo izquierdo:', error);
                }

                try {
                    const logoDerecho = await cargarImagen('/img/familias-dif.png');
                    const anchoLogoDer = 24.5;
                    const aspectRatioDer = logoDerecho.width / logoDerecho.height;
                    const altoLogoDer = anchoLogoDer / aspectRatioDer;
                    const yPosLogoDer = (alturaEncabezado - altoLogoDer) / 2;

                    pdf.addImage(logoDerecho, 'PNG', pageWidth - 40, yPosLogoDer, anchoLogoDer, altoLogoDer);
                } catch (error) {
                    console.warn('No se pudo cargar logo derecho:', error);
                }

                // Obtener el registro del tablero para el encabezado (ProPre, etc.)
                const idProcesoNum = parseInt(idProceso.replace('ID Proceso ', ''), 10);
                const dataEncabezado = datosTablero.find(d => d.idProceso === idProcesoNum);
                const nombrePrograma = dataEncabezado?.proPre || 'Sin programa';

                // TEXTOS DEL ENCABEZADO
                pdf.setTextColor(0, 0, 0);

                pdf.setFontSize(9);
                pdf.setFont(undefined, 'bold');
                pdf.text('SISTEMA PARA EL DESARROLLO INTEGRAL DE LA FAMILIA DEL ESTADO DE PUEBLA', pageWidth / 2, 10, { align: 'center' });

                pdf.setFontSize(8);
                pdf.setFont(undefined, 'normal');
                pdf.text('UNIDAD DE PLANEACIÓN ADMINISTRACIÓN Y FINANZAS', pageWidth / 2, 15, { align: 'center' });
                pdf.text('DIRECCIÓN DE PLANEACIÓN Y EVALUACIÓN', pageWidth / 2, 19, { align: 'center' });

                pdf.setFontSize(10);
                pdf.setFont(undefined, 'bold');
                pdf.text(`TABLERO DE CONTROL ${anoFiscal}`, pageWidth / 2, 25, { align: 'center' });

                pdf.setFontSize(8);
                pdf.setFont(undefined, 'italic');
                pdf.text(nombrePrograma, pageWidth / 2, 30, { align: 'center' });

                pdf.setFontSize(7);
                pdf.setFont(undefined, 'normal');
                pdf.setTextColor(100, 100, 100);
                pdf.text(`${idProceso} | Generado el ${fechaActual}`, pageWidth / 2, 36, { align: 'center' });

                // IMAGEN DEL TABLERO
                const imgData = canvas.toDataURL('image/png');
                const imgWidth = pageWidth - (margin * 2);
                const imgHeight = (canvas.height * imgWidth) / canvas.width;

                let yPosition = alturaEncabezado + 8;
                const maxHeight = pageHeight - 100;
                let finalImgHeight = imgHeight;
                let finalImgWidth = imgWidth;

                if (imgHeight > maxHeight) {
                    finalImgHeight = maxHeight;
                    finalImgWidth = (canvas.width * finalImgHeight) / canvas.height;
                }

                pdf.setTextColor(0, 0, 0);
                pdf.addImage(imgData, 'PNG', margin, yPosition, finalImgWidth, finalImgHeight);

                // SECCIÓN DE FIRMAS
                const firmasY = pageHeight - 65;
                const colWidth = (pageWidth - (margin * 2)) / 2;
                const firmaY = firmasY + 10;
                const anchoMaxTexto = colWidth - 40; // Ancho disponible para el texto

                pdf.setTextColor(0, 0, 0);

                // Obtener el registro específico de este tablero (idProcesoNum ya definido en encabezado)
                const dataActual = datosTablero.find(d => d.idProceso === idProcesoNum);

                const nombreReviso = dataActual?.nombreReviso || 'Sin asignar';
                const nombreValido = dataActual?.nombreValido || 'Sin asignar';
                const cargoReviso = dataActual?.cargoReviso || 'Sin asignar';
                const cargoValido = dataActual?.cargoValido || 'Sin asignar';

                // ========== PRIMERA FIRMA - REVISÓ ==========
                const xCentroReviso = margin + (colWidth / 2);

                pdf.setFont(undefined, 'bold');
                pdf.setFontSize(10);
                pdf.text('Revisó', xCentroReviso, firmaY, { align: 'center' });

                pdf.setDrawColor(0, 0, 0);
                pdf.setLineWidth(0.5);
                pdf.line(margin + 20, firmaY + 12, margin + colWidth - 20, firmaY + 12);

                // Nombre con salto de línea automático
                pdf.setFont(undefined, 'bold');
                pdf.setFontSize(9);
                const lineasNombreReviso = pdf.splitTextToSize(nombreReviso, anchoMaxTexto);
                pdf.text(lineasNombreReviso, xCentroReviso, firmaY + 18, { align: 'center' });

                // Cargo debajo del nombre (ajustar Y según las líneas del nombre)
                const offsetNombreReviso = (lineasNombreReviso.length - 1) * 4;
                pdf.setFont(undefined, 'normal');
                pdf.setFontSize(8);
                const lineasCargoReviso = pdf.splitTextToSize(cargoReviso, anchoMaxTexto);
                pdf.text(lineasCargoReviso, xCentroReviso, firmaY + 23 + offsetNombreReviso, { align: 'center' });

                // ========== SEGUNDA FIRMA - AUTORIZÓ ==========
                const xCentroAutorizo = margin + colWidth + (colWidth / 2);

                pdf.setFont(undefined, 'bold');
                pdf.setFontSize(10);
                pdf.text('Autorizó', xCentroAutorizo, firmaY, { align: 'center' });

                pdf.line(margin + colWidth + 20, firmaY + 12, pageWidth - margin - 20, firmaY + 12);

                // Nombre con salto de línea automático
                pdf.setFont(undefined, 'bold');
                pdf.setFontSize(9);
                const lineasNombreValido = pdf.splitTextToSize(nombreValido, anchoMaxTexto);
                pdf.text(lineasNombreValido, xCentroAutorizo, firmaY + 18, { align: 'center' });

                // Cargo debajo del nombre
                const offsetNombreValido = (lineasNombreValido.length - 1) * 4;
                pdf.setFont(undefined, 'normal');
                pdf.setFontSize(8);
                const lineasCargoValido = pdf.splitTextToSize(cargoValido, anchoMaxTexto);
                pdf.text(lineasCargoValido, xCentroAutorizo, firmaY + 23 + offsetNombreValido, { align: 'center' });

                // Pie de página
                pdf.setFontSize(7);
                pdf.setTextColor(128, 128, 128);
                pdf.text('Este documento es de carácter informativo y representa el avance del programa social',
                    pageWidth / 2, pageHeight - 10, { align: 'center' });

                // Guardar el PDF
                const nombreArchivo = `Tablero_${idProceso}_${new Date().getTime()}.pdf`;
                pdf.save(nombreArchivo);

                $(boton).html(botonOriginal).prop('disabled', false);
                Swal.fire({ icon: 'success', title: 'PDF generado exitosamente', confirmButtonText: 'Aceptar' });

            } catch (error) {
                console.error('Error completo:', error);
                console.error('Stack trace:', error.stack);
                $(boton).html(botonOriginal).prop('disabled', false);
                Swal.fire({ icon: 'error', title: 'Error al generar el PDF', text: error.message, confirmButtonText: 'Entendido' });
            }
        }
    </script>

    <style>
        .tablero-spinner {
            color: var(--primary) !important;
        }
    </style>
}
