@model Metas.AplicacionWeb.Models.ViewModels.VMDepartamentos
@{
    ViewData["Title"] = "Monitoreo";
}

<div class="titulo-vista-wrap">
    <h1 class="titulo-vista">Monitoreo y Seguimiento de Metas</h1>
    <span class="subtitulo-vista">- Selecciona un año fiscal y un departamento para dar seguimiento mensual a sus actividades.</span>
</div>

<div class="filtros-container">
    <div class="filtro-grupo">
        <label for="selectAnoFiscal">Año Fiscal</label>
        <select id="selectAnoFiscal" class="select2-simple">
            @{
                var anoActual = DateTime.Now.Year;
                var anoMaximo = anoActual + 1;
                var anoMinimo = anoActual - 5;

                for (int ano = anoMaximo; ano >= anoMinimo; ano--)
                {
                    <option value="@ano" selected="@(ano == anoActual)">@ano</option>
                }
            }
        </select>
    </div>
    <div class="filtro-grupo">
        <label for="selectAreaFiltro">Área</label>
        <select id="selectAreaFiltro" class="select2-simple">
            <option value="">Todas</option>
            @foreach (var area in Model.ListaAreas)
            {
                <option value="@area.Text">@area.Text</option>
            }
        </select>
    </div>
    <div class="filtro-grupo">
        <label for="selectDepartamento">Departamento</label>
        <select id="selectDepartamento" class="select2-simple">
            @if (User.IsInRole("Administrador") || Model.ListaDepartamentos.Count > 1)
            {
                <option value="">-- Seleccione un departamento --</option>
            }

            @foreach (var depto in Model.ListaDepartamentos)
            {
                <option value="@depto.Value" data-area="@depto.Group?.Name">@depto.Text</option>
            }
        </select>
    </div>
    <div class="filtro-grupo">
        <label for="selectProgramaFiltro">Programa Presupuestal</label>
        <select id="selectProgramaFiltro" class="select2-simple">
            <option value="">Todos</option>
            <option value="Agenda">Agenda</option>
            <option value="E046">E046</option>
            <option value="E047">E047</option>
        </select>
    </div>
    @if (User.IsInRole("Administrador"))
    {
        <div class="filtro-grupo" style="flex: 0 0 auto; min-width: auto;">
            <label>&nbsp;</label>
            <button class="btn-app-gris" type="button" id="btnNuevo">
                <i class="fa-solid fa-plus"></i> Agregar Nuevo
            </button>
        </div>
    }
    <div class="filtro-grupo" style="flex: 0 0 auto; min-width: auto;">
        <label>&nbsp;</label>
        <button class="btn-app-gris" type="button" id="btnLimpiarFiltros">
            <i class="fa-solid fa-broom"></i> Limpiar filtros
        </button>
    </div>
    <div class="filtro-grupo" style="flex: 0 0 auto; min-width: auto;">
        <label>&nbsp;</label>
        <button class="btn-app-rosa" type="button" id="btnBuscar">
            <i class="fa-solid fa-magnifying-glass"></i> Buscar
        </button>
    </div>
</div>

<div id="seccionResultados" style="display: none;">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
        <div>
            <h2 class="titulo-vista mb-1" style="font-size: 1.1rem;" id="ano">Ejercicio Fiscal</h2>
            <p class="subtitulo-vista mb-0" id="tituloDepartamento">Departamento:</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            @if (User.IsInRole("Administrador"))
            {
                <button class="btn-app-azul" type="button" id="btnTableroCompleto" onclick="irATableroCompleto()">
                    <i class="fa-solid fa-table"></i> Tablero Completo por Departamento
                </button>
            }
            <button class="btn-app-verde" type="button" id="btnTablero" onclick="irATablero()">
                <i class="fa-solid fa-gauge"></i> Tablero
            </button>
        </div>
    </div>

    <div class="tabla-scroll">
        <div class="tabla-datos-wrap">
            <table class="tabla-datos" id="tablaDatos">
                <thead>
                    <tr>
                        <th>Pp</th>
                        <th>Componente</th>
                        <th>Actividad</th>
                        <th>Descripción de la Actividad</th>
                        <th>Programa o servicio de asistencia social</th>
                        <th>Área</th>
                        <th>Departamento</th>
                        <th>Ene</th>
                        <th>Feb</th>
                        <th>Mar</th>
                        <th>Abr</th>
                        <th>May</th>
                        <th>Jun</th>
                        <th>Jul</th>
                        <th>Ago</th>
                        <th>Sep</th>
                        <th>Oct</th>
                        <th>Nov</th>
                        <th>Dic</th>
                        @if (User.IsInRole("Administrador"))
                        {
                            <th class="text-center">Acciones</th>
                        }
                    </tr>
                </thead>
                <tbody id="tbodyDatos">
                    <!-- Los datos se cargarán aquí dinámicamente -->
                </tbody>
            </table>
        </div>
    </div>
    <div id="tablaDatos-paginacion" class="tabla-paginacion"></div>

    <!-- Mensaje de carga -->
    <div id="mensajeCarga" class="text-center mt-3" style="display: none;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <p class="mt-2">Cargando datos...</p>
    </div>

    <!-- Mensaje cuando no hay datos -->
    <div id="mensajeSinDatos" class="sin-registros mt-3" style="display: none;">
        <i class="bi bi-clipboard2-x"></i><br>
        <span>No se encontraron datos para los criterios seleccionados.</span>
    </div>
</div>

<div class="modal fade" id="modalModificarActividad" tabindex="-1" aria-labelledby="modalModificarActividadLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-900 modal-dialog-scrollable">
        <div class="modal-content modal-fijo">
            <div class="modal-header">
                <h5 class="modal-title" id="modalModificarActividadLabel">Modificar Actividad</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formModificarActividad">
                <div class="modal-body">

                    <input type="hidden" id="IdProcesoModal" name="IdProceso" />
                    <input type="hidden" id="modoFormulario" value="editar" /> <!-- Nuevo campo para identificar el modo -->
                    <!-- CAMPOS EXTRAS SOLO PARA AGREGAR NUEVO -->
                    <div id="camposNuevoRegistro" class="modal-seccion" style="display: none;">
                        <h6 class="modal-seccion-titulo">Contexto</h6>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label for="AnoFiscalModal" class="form-label small text-muted mb-1">Año Fiscal</label>
                                <input type="number" class="form-control" id="AnoFiscalModal" name="AnoFiscal" readonly>
                            </div>
                            <div class="col-md-4">
                                <label for="AreaModal" class="form-label small text-muted mb-1">Área</label>
                                <input type="text" class="form-control" id="AreaModal" name="Area" readonly>
                            </div>
                            <div class="col-md-4">
                                <label for="selectDepartamentoModal" class="form-label small text-muted mb-1">Departamento</label>
                                <select class="form-select select2-simple" id="selectDepartamentoModal" name="IdDepartamento">
                                    <option value="">-- Seleccione un departamento --</option>
                                    @foreach (var depto in Model.ListaDepartamentos)
                                    {
                                        <option value="@depto.Value">@depto.Text</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="modal-seccion">
                        <h6 class="modal-seccion-titulo">Identificación</h6>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label for="selectProgramaPresupuestario" class="form-label small text-muted mb-1">Programa Presupuestario</label>
                                <select class="form-select select2-simple" id="selectProgramaPresupuestario" name="PP">
                                    <option value="3">Agenda</option>
                                    <option value="1">E046</option>
                                    <option value="2">E047</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label for="ComponenteModal" class="form-label small text-muted mb-1">Componente</label>
                                <input type="number" class="form-control" id="ComponenteModal" name="Componente">
                            </div>
                            <div class="col-md-4">
                                <label for="ActividadModal" class="form-label small text-muted mb-1">Actividad</label>
                                <input type="number" class="form-control" id="ActividadModal" name="Actividad">
                            </div>
                        </div>
                    </div>

                    <div class="modal-seccion">
                        <h6 class="modal-seccion-titulo">Descripción</h6>
                        <div class="mb-3">
                            <label for="DescripcionActividadModal" class="form-label small text-muted mb-1">Descripción de la actividad</label>
                            <textarea class="form-control" id="DescripcionActividadModal" name="DescripcionActividad" rows="3"></textarea>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-5">
                                <label for="selectUnidadMedida" class="form-label small text-muted mb-1">Unidad de Medida</label>
                                <select class="form-select select2-simple" id="selectUnidadMedida" name="UnidadMedida">
                                </select>
                            </div>
                            <div class="col-md-7">
                                <label for="ProgramaSocialModal" class="form-label small text-muted mb-1">Programa o servicio de asistencia social</label>
                                <input type="text" class="form-control" id="ProgramaSocialModal" name="ProgramaSocial" maxlength="255">
                            </div>
                        </div>
                    </div>

                    <div class="modal-seccion">
                        <h6 class="modal-seccion-titulo">Meta Programada</h6>
                        <div class="modal-meses-grid">
                            <div class="modal-mes-col"><div class="ficha-mes-header">Ene</div><input type="number" class="form-control form-control-sm meta-prog" name="TotalEnero" id="TotalEnero" value="0"></div>
                            <div class="modal-mes-col"><div class="ficha-mes-header">Feb</div><input type="number" class="form-control form-control-sm meta-prog" name="TotalFebrero" id="TotalFebrero" value="0"></div>
                            <div class="modal-mes-col"><div class="ficha-mes-header">Mar</div><input type="number" class="form-control form-control-sm meta-prog" name="TotalMarzo" id="TotalMarzo" value="0"></div>
                            <div class="modal-mes-col"><div class="ficha-mes-header">Abr</div><input type="number" class="form-control form-control-sm meta-prog" name="TotalAbril" id="TotalAbril" value="0"></div>
                            <div class="modal-mes-col"><div class="ficha-mes-header">May</div><input type="number" class="form-control form-control-sm meta-prog" name="TotalMayo" id="TotalMayo" value="0"></div>
                            <div class="modal-mes-col"><div class="ficha-mes-header">Jun</div><input type="number" class="form-control form-control-sm meta-prog" name="TotalJunio" id="TotalJunio" value="0"></div>
                            <div class="modal-mes-col"><div class="ficha-mes-header">Jul</div><input type="number" class="form-control form-control-sm meta-prog" name="TotalJulio" id="TotalJulio" value="0"></div>
                            <div class="modal-mes-col"><div class="ficha-mes-header">Ago</div><input type="number" class="form-control form-control-sm meta-prog" name="TotalAgosto" id="TotalAgosto" value="0"></div>
                            <div class="modal-mes-col"><div class="ficha-mes-header">Sep</div><input type="number" class="form-control form-control-sm meta-prog" name="TotalSeptiembre" id="TotalSeptiembre" value="0"></div>
                            <div class="modal-mes-col"><div class="ficha-mes-header">Oct</div><input type="number" class="form-control form-control-sm meta-prog" name="TotalOctubre" id="TotalOctubre" value="0"></div>
                            <div class="modal-mes-col"><div class="ficha-mes-header">Nov</div><input type="number" class="form-control form-control-sm meta-prog" name="TotalNoviembre" id="TotalNoviembre" value="0"></div>
                            <div class="modal-mes-col"><div class="ficha-mes-header">Dic</div><input type="number" class="form-control form-control-sm meta-prog" name="TotalDiciembre" id="TotalDiciembre" value="0"></div>
                        </div>
                    </div>

                    <div class="modal-seccion">
                        <h6 class="modal-seccion-titulo">Personas Programadas</h6>
                        <div class="modal-meses-grid">
                            <div class="modal-mes-col"><div class="ficha-mes-header ficha-mes-header-verde">Ene</div><input type="number" class="form-control form-control-sm personas-prog" name="EneroPersona" id="TotalEneroPersonas" value="0"></div>
                            <div class="modal-mes-col"><div class="ficha-mes-header ficha-mes-header-verde">Feb</div><input type="number" class="form-control form-control-sm personas-prog" name="FebreroPersona" id="TotalFebreroPersonas" value="0"></div>
                            <div class="modal-mes-col"><div class="ficha-mes-header ficha-mes-header-verde">Mar</div><input type="number" class="form-control form-control-sm personas-prog" name="MarzoPersona" id="TotalMarzoPersonas" value="0"></div>
                            <div class="modal-mes-col"><div class="ficha-mes-header ficha-mes-header-verde">Abr</div><input type="number" class="form-control form-control-sm personas-prog" name="AbrilPersona" id="TotalAbrilPersonas" value="0"></div>
                            <div class="modal-mes-col"><div class="ficha-mes-header ficha-mes-header-verde">May</div><input type="number" class="form-control form-control-sm personas-prog" name="MayoPersona" id="TotalMayoPersonas" value="0"></div>
                            <div class="modal-mes-col"><div class="ficha-mes-header ficha-mes-header-verde">Jun</div><input type="number" class="form-control form-control-sm personas-prog" name="JunioPersona" id="TotalJunioPersonas" value="0"></div>
                            <div class="modal-mes-col"><div class="ficha-mes-header ficha-mes-header-verde">Jul</div><input type="number" class="form-control form-control-sm personas-prog" name="JulioPersona" id="TotalJulioPersonas" value="0"></div>
                            <div class="modal-mes-col"><div class="ficha-mes-header ficha-mes-header-verde">Ago</div><input type="number" class="form-control form-control-sm personas-prog" name="AgostoPersona" id="TotalAgostoPersonas" value="0"></div>
                            <div class="modal-mes-col"><div class="ficha-mes-header ficha-mes-header-verde">Sep</div><input type="number" class="form-control form-control-sm personas-prog" name="SeptiembrePersona" id="TotalSeptiembrePersonas" value="0"></div>
                            <div class="modal-mes-col"><div class="ficha-mes-header ficha-mes-header-verde">Oct</div><input type="number" class="form-control form-control-sm personas-prog" name="OctubrePersona" id="TotalOctubrePersonas" value="0"></div>
                            <div class="modal-mes-col"><div class="ficha-mes-header ficha-mes-header-verde">Nov</div><input type="number" class="form-control form-control-sm personas-prog" name="NoviembrePersona" id="TotalNoviembrePersonas" value="0"></div>
                            <div class="modal-mes-col"><div class="ficha-mes-header ficha-mes-header-verde">Dic</div><input type="number" class="form-control form-control-sm personas-prog" name="DiciembrePersona" id="TotalDiciembrePersonas" value="0"></div>
                        </div>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-app-gris" data-bs-dismiss="modal">Cerrar</button>
                    <button type="submit" class="btn-app-rosa" id="btnGuardarModal">Guardar y continuar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const esAdmin = @(User.IsInRole("Administrador").ToString().ToLower())

        $('.select2-simple').select2({ width: '100%', language: 'es', minimumResultsForSearch: 8 });

        // ========================================
        // CASCADA ÁREA -> DEPARTAMENTO
        // ========================================
        // Se guarda la lista completa de departamentos (con su área) una sola
        // vez, antes de que la cascada empiece a recortar las opciones.
        var todosLosDepartamentos = $('#selectDepartamento option').map(function () {
            return { value: this.value, text: $(this).text(), area: $(this).data('area') || '' };
        }).get();

        function repoblarDepartamentos(area) {
            var valorActual = $('#selectDepartamento').val();
            var opciones = todosLosDepartamentos.filter(function (d) {
                return d.value === '' || !area || d.area === area;
            });

            var select = $('#selectDepartamento').empty();
            opciones.forEach(function (d) {
                select.append($('<option>', { value: d.value, text: d.text }).attr('data-area', d.area));
            });

            if (opciones.some(function (d) { return d.value === valorActual; })) {
                select.val(valorActual);
            }
            select.trigger('change');
        }

        $('#selectAreaFiltro').on('change', function () {
            repoblarDepartamentos($(this).val());
        });

        // ========================================
        // RECORDAR / RESTAURAR LA ÚLTIMA BÚSQUEDA
        // ========================================
        // Al volver desde Tablero, Tablero Completo o Actualización de mes con
        // el botón "Volver", se restaura la última combinación de filtros
        // buscada (incluida una búsqueda de "todos", sin departamento ni área).
        var CLAVE_ULTIMA_BUSQUEDA_MONITOREO = 'monitoreoUltimaBusqueda';

        function guardarUltimaBusquedaMonitoreo(anoFiscal, departamento, area) {
            try {
                sessionStorage.setItem(CLAVE_ULTIMA_BUSQUEDA_MONITOREO, JSON.stringify({ anoFiscal: anoFiscal, departamento: departamento, area: area }));
            } catch (e) { /* almacenamiento no disponible, se ignora */ }
        }

        function restaurarUltimaBusquedaMonitoreo() {
            var guardada;
            try {
                guardada = JSON.parse(sessionStorage.getItem(CLAVE_ULTIMA_BUSQUEDA_MONITOREO) || 'null');
            } catch (e) {
                guardada = null;
            }
            if (!guardada) return;

            $('#selectAnoFiscal').val(guardada.anoFiscal).trigger('change');
            $('#selectAreaFiltro').val(guardada.area || '').trigger('change');
            $('#selectDepartamento').val(guardada.departamento || '').trigger('change');
            $('#btnBuscar').click();
        }

        // ========================================
        // LIMPIAR FILTROS
        // ========================================
        $('#btnLimpiarFiltros').click(function () {
            var anoDefault = $('#selectAnoFiscal option[selected]').val();
            $('#selectAnoFiscal').val(anoDefault).trigger('change');
            $('#selectAreaFiltro').val('').trigger('change');
            repoblarDepartamentos('');
            $('#selectProgramaFiltro').val('').trigger('change');
            $('#seccionResultados').slideUp();
            try { sessionStorage.removeItem(CLAVE_ULTIMA_BUSQUEDA_MONITOREO); } catch (e) { /* se ignora */ }
        });

        function irATablero() {
            var anoFiscal = $('#selectAnoFiscal').val();
            var departamento = $('#selectDepartamento').val();

            if (!anoFiscal || !departamento) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Faltan datos',
                    text: 'Por favor, selecciona año fiscal y departamento primero.',
                    confirmButtonText: 'Entendido'
                });
                return;
            }

            // Redirigir a TableroControl con parámetros
            window.location.href = '@Url.Action("TableroControl", "Monitoreo")' +
                                  '?anoFiscal=' + anoFiscal +
                                  '&departamento=' + departamento;
        }

        function irATableroCompleto() {
            var anoFiscal = $('#selectAnoFiscal').val();
            var departamento = $('#selectDepartamento').val();

            if (!anoFiscal || !departamento) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Faltan datos',
                    text: 'Por favor, selecciona año fiscal y departamento primero.',
                    confirmButtonText: 'Entendido'
                });
                return;
            }

            window.location.href = '@Url.Action("TableroCompletoDepartamento", "Monitoreo")' +
                                  '?anoFiscal=' + anoFiscal +
                                  '&departamento=' + departamento;
        }

        function habilitarCaptura(element) {
            const idProceso = $(element).data('idproceso');
            const mesNumero = $(element).data('mes');

            Swal.fire({
                icon: 'warning',
                title: '¿Habilitar la fecha de captura?',
                showCancelButton: true,
                confirmButtonText: 'Sí, habilitar',
                cancelButtonText: 'Cancelar'
            }).then(function (resultado) {
                if (!resultado.isConfirmed) return;

                $.ajax({
                    url: '@Url.Action("HabilitarCaptura", "Monitoreo")',
                    type: 'POST',
                    data: {
                        idProceso: idProceso,
                        mes: mesNumero
                    },
                    success: function(response) {
                        if (response.success) {
                            Toast.fire({ icon: 'success', title: 'Captura habilitada' });
                            $('#btnBuscar').click();
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error al habilitar la captura',
                                text: response.message,
                                confirmButtonText: 'Entendido'
                            });
                        }
                    },
                    error: function(xhr, status, error) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error de comunicación',
                            text: 'No se pudo contactar al servidor.',
                            confirmButtonText: 'Entendido'
                        });
                    }
                });
            });
        }

        function eliminarCapturaMes(elemento) {
            const idProceso = $(elemento).data('idproceso');
            const mes = $(elemento).data('mes');

            const nombresMeses = ['', 'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
                                  'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];

            Swal.fire({
                icon: 'warning',
                title: '¿Eliminar la captura de ' + nombresMeses[mes] + '?',
                html: 'Esta acción:<br>- Eliminará todos los registros externos del mes<br>- Marcará el mes como no capturado<br><br>Esta acción no se puede deshacer.',
                showCancelButton: true,
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then(function (resultado) {
                if (!resultado.isConfirmed) return;

                $(elemento).removeClass('fa-trash').addClass('fa-spinner fa-spin');

                $.ajax({
                    url: '@Url.Action("EliminarCapturaMes", "Monitoreo")',
                    type: 'POST',
                    data: {
                        idProceso: idProceso,
                        mes: mes
                    },
                    success: function(response) {
                        if (response.success) {
                            Toast.fire({ icon: 'success', title: response.mensaje || 'Captura eliminada' });
                            $('#btnBuscar').click();
                        } else {
                            Swal.fire({ icon: 'error', title: 'Error', text: response.mensaje, confirmButtonText: 'Entendido' });
                            $(elemento).removeClass('fa-spinner fa-spin').addClass('fa-trash');
                        }
                    },
                    error: function(xhr, status, error) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'No se pudo eliminar la captura del mes.',
                            confirmButtonText: 'Entendido'
                        });
                        $(elemento).removeClass('fa-spinner fa-spin').addClass('fa-trash');
                    }
                });
            });
        }

        function obtenerFechaHabilitacion(item, mesNumero) {
            // Las propiedades vienen en camelCase desde el JSON
            const nombresMesesCamel = {
                1: 'fechaEnero', 2: 'fechaFebrero', 3: 'fechaMarzo', 4: 'fechaAbril',
                5: 'fechaMayo', 6: 'fechaJunio', 7: 'fechaJulio', 8: 'fechaAgosto',
                9: 'fechaSeptiembre', 10: 'fechaOctubre', 11: 'fechaNoviembre', 12: 'fechaDiciembre'
            };

            const nombrePropiedad = nombresMesesCamel[mesNumero];
            return item[nombrePropiedad];
        }

        function filtrarTabla() {
            var tabla = document.getElementById('tablaDatos');
            if (!tabla) return;

            var ppFiltro = ($('#selectProgramaFiltro').val() || '').toLowerCase();
            var areaFiltro = $('#selectAreaFiltro').val() || '';

            var filas = tabla.querySelectorAll('tbody tr');
            filas.forEach(function (fila) {
                var pasaPp = !ppFiltro || fila.getAttribute('data-pp') === ppFiltro;
                var pasaArea = !areaFiltro || fila.getAttribute('data-area') === areaFiltro;

                fila.style.display = (pasaPp && pasaArea) ? '' : 'none';
            });

            TablaPaginada.actualizar('tablaDatos');
        }

        $('#selectProgramaFiltro, #selectAreaFiltro').on('change', filtrarTabla);

        function inicializarTooltips() {
            $('#tbodyDatos [data-bs-toggle="tooltip"]').each(function () {
                bootstrap.Tooltip.getOrCreateInstance(this);
            });
        }

        $(document).ready(function() {
            $('#btnBuscar').click(function() {
                var anoFiscal = $('#selectAnoFiscal').val();
                var departamento = $('#selectDepartamento').val();
                var departamentoTexto = $('#selectDepartamento option:selected').text();
                var area = $('#selectAreaFiltro').val();

                guardarUltimaBusquedaMonitoreo(anoFiscal, departamento, area);

                $('#seccionResultados').slideDown();
                $('#ano').text('Ejercicio Fiscal: ' + anoFiscal);
                var textoDepartamento = departamento
                    ? ('Departamento: ' + departamentoTexto)
                    : (area ? ('Área: ' + area + ' (todos sus departamentos)') : 'Todos los departamentos');
                $('#tituloDepartamento').text(textoDepartamento);
                $('#mensajeCarga').show();
                $('#tablaDatos').hide();
                $('#mensajeSinDatos').hide();

                // "Tablero" y "Tablero Completo" necesitan un departamento específico;
                // al buscar por área (varios departamentos a la vez) se ocultan.
                $('#btnTablero, #btnTableroCompleto').toggle(!!departamento);

                $.ajax({
                    url: '@Url.Action("ObtenerDatos", "Monitoreo")',
                    type: 'GET',
                    data: {
                        anoFiscal: anoFiscal,
                        departamento: departamento || null,
                        area: departamento ? null : area
                    },
                    success: function(response) {
                        $('#mensajeCarga').hide();

                        if (response.success && response.datos && response.datos.length > 0) {
                            $('#tbodyDatos').empty();

                            var esAdmin = response.esAdmin;

                            $.each(response.datos, function(index, item) {
                                var prefijoActividad = '';
                                if (item.pp && item.pp.toLowerCase() === 'agenda') {
                                    prefijoActividad = 'T';
                                }

                                var actividadCompleta = prefijoActividad + (item.componente || '') + '.' + (item.actividad || '');

                                function generarIcono(valor, mesNumero, fechasCaptura, idProceso, item) {
                                    let iconoHTML = '';
                                    let claseIcono = '';
                                    let titulo = '';

                                    const botonEliminarMes = esAdmin ?
                                        `<i
                                            class="fa-solid fa-trash"
                                            title="Eliminar Captura del Mes"
                                            data-bs-toggle="tooltip"
                                            data-bs-placement="top"
                                            data-idproceso="${idProceso}"
                                            data-mes="${mesNumero}"
                                            onclick="eliminarCapturaMes(this)"
                                            style="cursor: pointer; color: #dc3545;"></i>` : '';

                                    if (valor === 1 || valor === true) {
                                        claseIcono = 'fa-circle-check';
                                        titulo = 'Completado';
                                        const url = '@Url.Action("ActualizacionMeses", "Monitoreo")' + '?idProceso=' + idProceso + '&mes=' + mesNumero + '&modo=visualizar';
                                        iconoHTML = `<a href="${url}" title="${titulo}" data-bs-toggle="tooltip" data-bs-placement="top" class="icono-mes icono-mes-completado"><i class="fa-solid ${claseIcono}"></i></a>`;
                                        if (esAdmin) {
                                            iconoHTML += `<br>${botonEliminarMes}`;
                                        }
                                    } else {
                                        // Obtener la fecha habilitada manualmente
                                        const fechaHabilitadaMes = obtenerFechaHabilitacion(item, mesNumero);

                                        let estaHabilitadoManualmente = false;
                                        if (fechaHabilitadaMes) {
                                            const partes = fechaHabilitadaMes.split('-');
                                            const fechaHabilitada = new Date(partes[0], partes[1] - 1, partes[2]);
                                            const hoy = new Date();

                                            fechaHabilitada.setHours(0, 0, 0, 0);
                                            hoy.setHours(0, 0, 0, 0);

                                            estaHabilitadoManualmente = (fechaHabilitada.getTime() === hoy.getTime());
                                        }

                                        let enPeriodoCaptura = false;
                                        if (fechasCaptura && fechasCaptura[mesNumero]) {
                                            const fechaInicio = new Date(fechasCaptura[mesNumero].fechaInicio);
                                            const fechaFin = new Date(fechasCaptura[mesNumero].fechaFin);
                                            const hoy = new Date();

                                            hoy.setHours(0, 0, 0, 0);
                                            fechaInicio.setHours(0, 0, 0, 0);
                                            fechaFin.setHours(0, 0, 0, 0);

                                            enPeriodoCaptura = (hoy >= fechaInicio && hoy <= fechaFin);
                                        }

                                        if (enPeriodoCaptura || estaHabilitadoManualmente) {
                                            claseIcono = 'fa-circle-xmark';

                                            if (estaHabilitadoManualmente && !enPeriodoCaptura) {
                                                titulo = 'Pendiente - Habilitado por administrador';
                                            } else {
                                                titulo = 'Pendiente - En periodo de captura';
                                            }

                                            const url = '@Url.Action("ActualizacionMeses", "Monitoreo")' + '?idProceso=' + idProceso + '&mes=' + mesNumero;
                                            iconoHTML = `<a href="${url}" title="${titulo}" data-bs-toggle="tooltip" data-bs-placement="top" class="icono-mes icono-mes-pendiente"><i class="fa-solid ${claseIcono}"></i></a>`;

                                        } else {
                                            claseIcono = 'fa-circle-xmark';
                                            titulo = 'Pendiente - Fuera de periodo';

                                            if (esAdmin) {
                                                const botonAdmin = `<i
                                                    class="fa-sharp fa-solid fa-check-to-slot"
                                                    title="Habilitar Captura (Admin)"
                                                    data-bs-toggle="tooltip"
                                                    data-bs-placement="top"
                                                    data-idproceso="${idProceso}"
                                                    data-mes="${mesNumero}"
                                                    onclick="habilitarCaptura(this)"
                                                    style="cursor: pointer; color: #C04116;"></i>`;

                                                iconoHTML = `<span class="icono-mes icono-mes-vencido" title="${titulo}" data-bs-toggle="tooltip" data-bs-placement="top"><i class="fa-solid ${claseIcono}"></i></span><br>${botonAdmin}<br>${botonEliminarMes}`;
                                            } else {
                                                iconoHTML = `<span class="icono-mes icono-mes-vencido" title="${titulo}" data-bs-toggle="tooltip" data-bs-placement="top"><i class="fa-solid ${claseIcono}"></i></span>`;
                                            }
                                        }
                                    }
                                    return iconoHTML;
                                }

                                var celdaAcciones = '';
                                if (esAdmin) {
                                    var acciones = '<button type="button" class="btn-accion btn-accion-editar btn-editar" data-id="' + item.idProceso + '" title="Editar" data-bs-toggle="tooltip" data-bs-placement="top"><i class="fa-solid fa-pen-to-square"></i></button>' +
                                        '<button type="button" class="btn-accion btn-accion-eliminar btn-eliminar" data-id="' + item.idProceso + '" title="Eliminar" data-bs-toggle="tooltip" data-bs-placement="top"><i class="fa-solid fa-trash"></i></button>';
                                    celdaAcciones = '<td><div class="acciones-grupo">' + acciones + '</div></td>';
                                }

                                var fila = '<tr data-pp="' + (item.pp || '').toLowerCase() + '" data-area="' + (item.area || '') + '">' +
                                    '<td>' + item.pp + '</td>' +
                                    '<td>' + item.componente + '</td>' +
                                    '<td>' + actividadCompleta + '</td>' +
                                    '<td>' + item.descripcionActividad + '</td>' +
                                    '<td>' + item.programaSocial + '</td>' +
                                    '<td>' + (item.area || '') + '</td>' +
                                    '<td>' + (item.departamento || '') + '</td>' +
                                    '<td class="text-center">' + generarIcono(item.enero, 1, item.fechasCaptura, item.idProceso, item) + '</td>' +
                                    '<td class="text-center">' + generarIcono(item.febrero, 2, item.fechasCaptura, item.idProceso, item) + '</td>' +
                                    '<td class="text-center">' + generarIcono(item.marzo, 3, item.fechasCaptura, item.idProceso, item) + '</td>' +
                                    '<td class="text-center">' + generarIcono(item.abril, 4, item.fechasCaptura, item.idProceso, item) + '</td>' +
                                    '<td class="text-center">' + generarIcono(item.mayo, 5, item.fechasCaptura, item.idProceso, item) + '</td>' +
                                    '<td class="text-center">' + generarIcono(item.junio, 6, item.fechasCaptura, item.idProceso, item) + '</td>' +
                                    '<td class="text-center">' + generarIcono(item.julio, 7, item.fechasCaptura, item.idProceso, item) + '</td>' +
                                    '<td class="text-center">' + generarIcono(item.agosto, 8, item.fechasCaptura, item.idProceso, item) + '</td>' +
                                    '<td class="text-center">' + generarIcono(item.septiembre, 9, item.fechasCaptura, item.idProceso, item) + '</td>' +
                                    '<td class="text-center">' + generarIcono(item.octubre, 10, item.fechasCaptura, item.idProceso, item) + '</td>' +
                                    '<td class="text-center">' + generarIcono(item.noviembre, 11, item.fechasCaptura, item.idProceso, item) + '</td>' +
                                    '<td class="text-center">' + generarIcono(item.diciembre, 12, item.fechasCaptura, item.idProceso, item) + '</td>' +
                                    celdaAcciones +
                                '</tr>';
                                $('#tbodyDatos').append(fila);
                            });

                            $('#tablaDatos').show();
                            TablaPaginada.iniciar('tablaDatos', { pageSize: 8 });
                            filtrarTabla();
                            inicializarTooltips();
                        } else {
                            $('#tablaDatos').show();
                            $('#mensajeSinDatos').show();
                        }
                    },
                    error: function(xhr, status, error) {
                        $('#mensajeCarga').hide();
                        Swal.fire({
                            icon: 'error',
                            title: 'Error al cargar los datos',
                            text: error,
                            confirmButtonText: 'Entendido'
                        });
                    }
                });
            });

            function limpiarFormularioModal() {
                $('#IdProcesoModal').val('');
                $('#selectProgramaPresupuestario').val('Agenda').trigger('change');
                $('#ComponenteModal').val('');
                $('#ActividadModal').val('');
                $('#DescripcionActividadModal').val('');
                $('#ProgramaSocialModal').val('');
                $('#selectDepartamentoModal').val('').trigger('change');
                $('#AreaModal').val('');

                // Limpiar las metas programadas
                $('.meta-prog').val(0);
                $('.personas-prog').val(0);
            }

            $('#tbodyDatos').on('click', '.btn-eliminar', function() {
                var idProceso = $(this).data('id');

                Swal.fire({
                    icon: 'warning',
                    title: '¿Eliminar este registro?',
                    text: 'Esta acción es irreversible y eliminará datos en 4 tablas.',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, eliminar',
                    cancelButtonText: 'Cancelar'
                }).then(function (resultado) {
                    if (!resultado.isConfirmed) return;

                    $.ajax({
                        url: '@Url.Action("EliminarRegistro", "Programacion")',
                        type: 'POST',
                        data: { id: idProceso },
                        success: function(response) {
                            if (response.success) {
                                Toast.fire({ icon: 'success', title: response.mensaje || 'Registro eliminado' });
                                $('#btnBuscar').click();
                            } else {
                                Swal.fire({ icon: 'error', title: 'Error', text: response.mensaje, confirmButtonText: 'Entendido' });
                            }
                        },
                        error: function(xhr, status, error) {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error de comunicación',
                                text: 'No se pudo contactar al servidor al intentar eliminar.',
                                confirmButtonText: 'Entendido'
                            });
                        }
                    });
                });
            });

            $('#btnNuevo').click(function() {
                var anoFiscal = $('#selectAnoFiscal').val();
                var departamento = $('#selectDepartamento').val();

                // Configurar modal en modo "nuevo"
                $('#modoFormulario').val('nuevo');
                $('#modalModificarActividadLabel').text('Agregar Nueva Actividad');
                $('#btnGuardarModal').text('Guardar');

                // Mostrar campos extras
                $('#camposNuevoRegistro').show();

                // Limpiar todos los campos del formulario PRIMERO
                limpiarFormularioModal();

                // Llenar año fiscal (siempre disponible en el filtro de la página) y,
                // si ya había un departamento elegido ahí, preseleccionarlo; si no,
                // el usuario lo elige directamente dentro de la modal.
                $('#AnoFiscalModal').val(anoFiscal);
                if (departamento) {
                    $('#selectDepartamentoModal').val(departamento).trigger('change');
                }

                // Cargar las unidades de medida
                cargarUnidadesMedida();

                // Abrir el modal
                var modal = new bootstrap.Modal(document.getElementById('modalModificarActividad'));
                modal.show();
            });

            // Al elegir departamento dentro de la modal, se carga su área.
            $('#selectDepartamentoModal').on('change', function () {
                var idDepartamento = $(this).val();
                if (idDepartamento) {
                    cargarAreaDepartamento(idDepartamento);
                } else {
                    $('#AreaModal').val('');
                }
            });


            $('#tbodyDatos').on('click', '.btn-editar', function() {
                const idProceso = $(this).data('id');
                $.ajax({
                    url: '@Url.Action("ObtenerDatosEdicion", "Monitoreo")',
                    type: 'GET',
                    data: { idProceso: idProceso },
                    success: function(data) {
                        if (data) {
                            // Configurar modal en modo "editar"
                            $('#modoFormulario').val('editar');
                            $('#modalModificarActividadLabel').text('Modificar Actividad');
                            $('#btnGuardarModal').text('Guardar y continuar');

                            // Ocultar campos extras
                            $('#camposNuevoRegistro').hide();

                            // Rellenar el modal con los datos
                            llenarModalEdicion(data);

                            // Abrir el modal
                            var modal = new bootstrap.Modal(document.getElementById('modalModificarActividad'));
                            modal.show();
                        } else {
                            Swal.fire({ icon: 'error', title: 'Error', text: 'No se encontraron datos para el ID proporcionado.', confirmButtonText: 'Entendido' });
                        }
                    },
                    error: function() {
                        Swal.fire({ icon: 'error', title: 'Error', text: 'Ocurrió un error al cargar los datos del registro.', confirmButtonText: 'Entendido' });
                    }
                });
            });

            function cargarAreaDepartamento(idDepartamento) {
                $.ajax({
                    url: '@Url.Action("ObtenerAreaPorDepartamento", "Monitoreo")',
                    type: 'GET',
                    data: { idDepartamento: idDepartamento },
                    success: function(response) {
                        if (response.success) {
                            $('#AreaModal').val(response.area);
                        } else {
                            $('#AreaModal').val('');
                            console.error('No se pudo obtener el área del departamento');
                        }
                    },
                    error: function() {
                        console.error('Error al cargar el área del departamento');
                        $('#AreaModal').val('');
                    }
                });
            }

            function cargarUnidadesMedida() {
                $.ajax({
                    url: '@Url.Action("ObtenerUnidadesMedida", "Monitoreo")', // Deberás crear esta acción
                    type: 'GET',
                    success: function(data) {
                        const selectMedida = $('#selectUnidadMedida');
                        selectMedida.empty();

                        if (data && data.length > 0) {
                            data.forEach(function(medida) {
                                selectMedida.append(
                                    $('<option>', {
                                        value: medida.value,
                                        text: medida.text
                                    })
                                );
                            });
                        }
                        selectMedida.trigger('change');
                    },
                    error: function() {
                        console.error('Error al cargar las unidades de medida');
                    }
                });
            }

            function llenarModalEdicion(data) {
                const selectMedida = $('#selectUnidadMedida');
                selectMedida.empty();

                const unidadMedidaActual = data.unidadMedida.toUpperCase();

                if (data.listaMedidas && data.listaMedidas.length > 0) {
                    data.listaMedidas.forEach(function(medida) {
                        selectMedida.append(
                            $('<option>', {
                                value: medida.value,
                                text: medida.text
                            })
                        );
                    });
                }

                // Campos principales
                $('#IdProcesoModal').val(data.idProceso);
                $('#selectProgramaPresupuestario').val(data.pp).trigger('change');
                $('#ComponenteModal').val(data.componente);
                $('#ActividadModal').val(data.actividad);
                $('#DescripcionActividadModal').val(data.descripcionActividad);
                selectMedida.val(unidadMedidaActual).trigger('change');
                $('#ProgramaSocialModal').val(data.programaSocial);

                const meses = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];

                meses.forEach(mes => {
                    const campoMeta = $(`#Total${mes}`);
                    if (campoMeta.length) {
                        campoMeta.val(data[`total${mes}`] || 0);
                    }

                    const mesMinuscula = mes.charAt(0).toLowerCase() + mes.slice(1);
                    const campoPersonas = $(`#Total${mes}Personas`);
                    if (campoPersonas.length) {
                        campoPersonas.val(data[`${mesMinuscula}Persona`] || 0);
                    }
                });
            }

            $('#formModificarActividad').submit(function(e) {
                e.preventDefault();

                const modo = $('#modoFormulario').val();

                const camposAValidar = [
                    { label: 'Programa Presupuestario', campoId: 'selectProgramaPresupuestario', valido: !!$('#selectProgramaPresupuestario').val() },
                    { label: 'Componente', campoId: 'ComponenteModal', valido: !!$('#ComponenteModal').val() },
                    { label: 'Actividad', campoId: 'ActividadModal', valido: !!$('#ActividadModal').val() },
                    { label: 'Descripción de la actividad', campoId: 'DescripcionActividadModal', valido: !!$('#DescripcionActividadModal').val().trim() },
                    { label: 'Unidad de Medida', campoId: 'selectUnidadMedida', valido: !!$('#selectUnidadMedida').val() },
                    { label: 'Programa o servicio de asistencia social', campoId: 'ProgramaSocialModal', valido: !!$('#ProgramaSocialModal').val().trim() }
                ];
                if (modo === 'nuevo') {
                    camposAValidar.unshift({ label: 'Departamento', campoId: 'selectDepartamentoModal', valido: !!$('#selectDepartamentoModal').val() });
                }

                if (!validarCamposRequeridos(camposAValidar)) return;

                confirmarGuardado('Se guardará la actividad con los datos capturados.').then(function (confirmado) {
                    if (!confirmado) return;

                    const formData = $('#formModificarActividad').serialize();

                    let urlDestino;
                    if (modo === 'nuevo') {
                        urlDestino = '@Url.Action("GuardarNuevo", "Monitoreo")';
                    } else {
                        urlDestino = '@Url.Action("GuardarEdicion", "Monitoreo")';
                    }

                    $.ajax({
                        url: urlDestino,
                        type: 'POST',
                        data: formData,
                        success: function(response) {
                            if (response.success) {
                                var modal = bootstrap.Modal.getInstance(document.getElementById('modalModificarActividad'));
                                modal.hide();
                                Toast.fire({ icon: 'success', title: response.message || 'Guardado correctamente' });
                                $('#btnBuscar').click();
                            } else {
                                Swal.fire({ icon: 'error', title: 'Error al guardar', text: response.message, confirmButtonText: 'Entendido' });
                            }
                        },
                        error: function(xhr, status, error) {
                            console.error('Error AJAX:', xhr.responseText);
                            Swal.fire({
                                icon: 'error',
                                title: 'Error de conexión',
                                text: 'No se pudo guardar la información.',
                                confirmButtonText: 'Entendido'
                            });
                        }
                    });
                });
            });
        });

        // Al volver desde Tablero / Tablero Completo / Actualización de mes con
        // el botón "Volver", se restaura la última búsqueda aplicada (año,
        // departamento y/o área), incluida una búsqueda de "todos".
        $(document).ready(function () {
            restaurarUltimaBusquedaMonitoreo();
        });
    </script>
}
