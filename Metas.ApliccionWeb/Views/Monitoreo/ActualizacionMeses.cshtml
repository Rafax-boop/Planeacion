@model Metas.AplicacionWeb.Models.ViewModels.VMGuardarActualizacion

@{
    ViewData["Title"] = "Actualización Mensual de Metas";
    bool esSoloVista = ViewBag.EsModoVisualizar ?? false;
}

@if (User.IsInRole("Administrador") && !esSoloVista)
{
    <div class="container-fluid mt-4">
        <div class="d-flex justify-content-end mb-3">
            <a asp-controller="Monitoreo" asp-action="Monitoreo" class="btn-app-gris" onclick="if (window.history.length > 1) { event.preventDefault(); window.history.back(); }">
                <i class="fa-solid fa-arrow-left"></i> Volver
            </a>
        </div>
        <div class="sin-registros">
            <i class="fa-solid fa-circle-info"></i><br>
            <span>Información no requisitada.</span>
        </div>
    </div>
}
else
{
    <div class="container-fluid mt-4">
        <form method="post" action="@Url.Action("GuardarActualizacion", "Monitoreo")" enctype="multipart/form-data">

            <input type="hidden" name="IdProceso" value="@Model.IdProceso" />
            <input type="hidden" name="Mes" value="@Model.MesNum" />
            <input type="hidden" name="RutaEvidenciaExistente" value="@Model.RutaEvidencia" />
            <input type="hidden" name="RutaJustificacionExistente" value="@Model.RutaJustificacion" />

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 ficha-titulo-wrap">
                <div class="titulo-vista-wrap mb-0">
                    <h1 class="titulo-vista">@Model.Mes</h1>
                    <span class="subtitulo-vista"><i class="fa-solid fa-calendar me-1"></i>@Model.FechaFin?.ToString("dd/MM/yyyy")</span>
                </div>
                <a asp-controller="Monitoreo" asp-action="Monitoreo" class="btn-app-gris" onclick="if (window.history.length > 1) { event.preventDefault(); window.history.back(); }">
                    <i class="fa-solid fa-arrow-left"></i> Volver
                </a>
            </div>

            @if (esSoloVista)
            {
                <div class="aviso-validado aviso-validado-centrado">
                    <i class="fa-solid fa-circle-check"></i>
                    <div>
                        <h4>Información completa</h4>
                        <p>Esta información está completa y se muestra en modo solo lectura.</p>
                    </div>
                </div>
            }

            @* Contexto de la actividad (solo lectura) *@
            <div class="ficha-seccion">
                <h5 class="ficha-seccion-titulo">Contexto de la Actividad</h5>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label for="metaProgramada" class="form-label small text-muted mb-1">Meta Programada</label>
                        <input type="text" class="form-control formato-miles" id="metaProgramada" value="@Model.Total" readonly>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small text-muted mb-1">Personas Programadas</label>
                        <input type="text" class="form-control formato-miles" value="@Model.TotalPersonas" readonly>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small text-muted mb-1">Programa Presupuestario</label>
                        <input type="text" class="form-control" readonly value="@Model.pp">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small text-muted mb-1">Componente</label>
                        <input type="text" class="form-control" readonly value="@Model.Componente">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small text-muted mb-1">Actividad</label>
                        <input type="text" class="form-control" readonly value="@Model.Actividad">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small text-muted mb-1">Unidad de Medida</label>
                        <input type="text" class="form-control" readonly value="@Model.UnidadMedida">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small text-muted mb-1">Programa o servicio de asistencia social</label>
                        <input type="text" class="form-control" readonly value="@Model.ProgramaSocial">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small text-muted mb-1">Área</label>
                        <input type="text" class="form-control" readonly value="@Model.Area">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small text-muted mb-1">Departamento</label>
                        <input type="text" class="form-control" readonly value="@Model.Departamento">
                    </div>
                </div>
                <div class="mt-3">
                    <label class="form-label small text-muted mb-1">Descripción de la Actividad</label>
                    <input type="text" class="form-control" readonly value="@Model.DescripcionActividad">
                </div>
            </div>

            @* Metas *@
            <div class="ficha-seccion">
                <h5 class="ficha-seccion-titulo">Metas</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="realizadoInput" class="form-label small text-muted mb-1">Realizado</label>
                        <input type="text" class="form-control formato-miles" id="realizadoInput" name="Realizado" value="@Model.Realizado" @(esSoloVista ? "disabled" : "")>
                    </div>
                    <div class="col-md-6">
                        <label for="totalPorcentaje" class="form-label small text-muted mb-1">Total de porcentaje</label>
                        <input type="text" class="form-control" readonly id="totalPorcentaje" value="0%">
                    </div>
                </div>
            </div>

            @* Personas *@
            <div class="ficha-seccion">
                <h5 class="ficha-seccion-titulo">Personas</h5>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label for="mujeresAtendidas" class="form-label small text-muted mb-1">Mujeres Atendidas</label>
                        <input type="text" class="form-control formato-miles personas-input" disabled id="mujeresAtendidas" name="MujeresAtendidas" value="@Model.MujeresAtendidas" @(esSoloVista ? "disabled" : "")>
                    </div>
                    <div class="col-md-4">
                        <label for="hombresAtendidos" class="form-label small text-muted mb-1">Hombres Atendidos</label>
                        <input type="text" class="form-control formato-miles personas-input" disabled id="hombresAtendidos" name="HombresAtendidos" value="@Model.HombresAtendidos" @(esSoloVista ? "disabled" : "")>
                    </div>
                    <div class="col-md-4">
                        <label for="personasAtendidas" class="form-label small text-muted mb-1">Personas Atendidas</label>
                        <input type="text" class="form-control formato-miles" readonly id="personasAtendidas" value="0">
                    </div>
                </div>
            </div>

            @* Rango de edad *@
            <div class="ficha-seccion">
                <h5 class="ficha-seccion-titulo">Rango de Edad</h5>
                <div class="row g-3">
                    <div class="col-6 col-md-3">
                        <label for="rango0a3" class="form-label small text-muted mb-1">0 - 3 años</label>
                        <input type="text" class="form-control formato-miles rango-input" disabled id="rango0a3" name="Rango0a3" value="@Model.Rango0a3" @(esSoloVista ? "disabled" : "")>
                    </div>
                    <div class="col-6 col-md-3">
                        <label for="rango4a8" class="form-label small text-muted mb-1">4 - 8 años</label>
                        <input type="text" class="form-control formato-miles rango-input" disabled id="rango4a8" name="Rango4a8" value="@Model.Rango4a8" @(esSoloVista ? "disabled" : "")>
                    </div>
                    <div class="col-6 col-md-3">
                        <label for="rango9a12" class="form-label small text-muted mb-1">9 - 12 años</label>
                        <input type="text" class="form-control formato-miles rango-input" disabled id="rango9a12" name="Rango9a12" value="@Model.Rango9a12" @(esSoloVista ? "disabled" : "")>
                    </div>
                    <div class="col-6 col-md-3">
                        <label for="rango13a17" class="form-label small text-muted mb-1">13 - 17 años</label>
                        <input type="text" class="form-control formato-miles rango-input" disabled id="rango13a17" name="Rango13a17" value="@Model.Rango13a17" @(esSoloVista ? "disabled" : "")>
                    </div>
                    <div class="col-6 col-md-3">
                        <label for="rango18a29" class="form-label small text-muted mb-1">18 - 29 años</label>
                        <input type="text" class="form-control formato-miles rango-input" disabled id="rango18a29" name="Rango18a29" value="@Model.Rango18a29" @(esSoloVista ? "disabled" : "")>
                    </div>
                    <div class="col-6 col-md-3">
                        <label for="rango30a59" class="form-label small text-muted mb-1">30 - 59 años</label>
                        <input type="text" class="form-control formato-miles rango-input" disabled id="rango30a59" name="Rango30a59" value="@Model.Rango30a59" @(esSoloVista ? "disabled" : "")>
                    </div>
                    <div class="col-6 col-md-3">
                        <label for="rango60adelante" class="form-label small text-muted mb-1">60 años en adelante</label>
                        <input type="text" class="form-control formato-miles rango-input" disabled id="rango60adelante" name="Rango60adelante" value="@Model.Rango60adelante" @(esSoloVista ? "disabled" : "")>
                    </div>
                    <div class="col-6 col-md-3">
                        <label for="rangoNoEspecifica" class="form-label small text-muted mb-1">No se especifica</label>
                        <input type="text" class="form-control formato-miles rango-input" disabled id="rangoNoEspecifica" name="RangoNoEspecifica" value="@Model.RangoNoEspecifica" @(esSoloVista ? "disabled" : "")>
                    </div>
                </div>
                <div class="mt-3 col-md-4 mx-auto">
                    <label for="totalPersonas" class="form-label small text-muted mb-1 text-center d-block">Total</label>
                    <input type="text" class="form-control formato-miles text-center fw-bold" disabled id="totalPersonas" value="0" @(esSoloVista ? "disabled" : "")>
                </div>
            </div>

            @* Tipo de población / evidencia / justificación *@
            <div class="ficha-seccion">
                <div class="row g-4">
                    <div class="col-md-4 border-end">
                        <div class="ficha-seccion-subtitulo">Tipo de Población</div>
                        <label for="indigena" class="form-label small text-muted mb-1">Indígena</label>
                        <input type="text" class="form-control formato-miles" id="indigena" name="Indigena" value="@Model.Indigena" @(esSoloVista ? "disabled" : "")>
                    </div>

                    <div class="col-md-4 border-end">
                        <div class="ficha-seccion-subtitulo">Evidencia</div>
                        @if (!esSoloVista)
                        {
                            @if (!string.IsNullOrEmpty(Model.RutaEvidencia))
                            {
                                <div class="mb-3">
                                    <label class="form-label small text-muted mb-1 d-block">Evidencia actual</label>
                                    <a target="_blank" href="@Model.RutaEvidencia" class="btn-app-verde btn-tablero-pdf">
                                        <i class="fa-solid fa-download"></i> Ver evidencia actual
                                    </a>
                                    <p class="text-muted small mt-2 mb-0">
                                        <i class="fa-solid fa-circle-info me-1"></i>
                                        Si subes un nuevo archivo, reemplazará el actual
                                    </p>
                                </div>
                            }

                            <label for="inputEvidencia" class="form-label small text-muted mb-1">
                                @(!string.IsNullOrEmpty(Model.RutaEvidencia) ? "Reemplazar evidencia (opcional)" : "Subir evidencia")
                            </label>
                            <p class="text-muted small mb-2">Favor de llenar el Formato de Evidencia y subirlo.</p>
                            <a target="_blank" href="@Url.Content("~/FormatoEvidencia/EVIDENCIA.xlsx")" download="Evidencia.xlsx" class="btn-app-verde btn-tablero-pdf mb-2">
                                <i class="fa-solid fa-file-arrow-down"></i> Descargar formato
                            </a>
                            <input type="file"
                                   class="form-control"
                                   id="inputEvidencia"
                                   name="InputEvidencia"
                                   data-tiene-archivo-existente="@(!string.IsNullOrEmpty(Model.RutaEvidencia))">
                        }
                        else
                        {
                            @if (!string.IsNullOrEmpty(Model.RutaEvidencia))
                            {
                                <label class="form-label small text-muted mb-1 d-block">Evidencia subida</label>
                                <a target="_blank" href="@Model.RutaEvidencia" class="btn-app-verde btn-tablero-pdf">
                                    <i class="fa-solid fa-download"></i> Ver evidencia
                                </a>
                            }
                            else
                            {
                                <span class="badge-estatus badge-estatus-error">No se ha cargado ninguna evidencia</span>
                            }
                        }
                    </div>

                    <div class="col-md-4">
                        <div class="ficha-seccion-subtitulo">Justificación</div>
                        <div id="justificacionDiv" style="display:none;">
                            @if (!esSoloVista)
                            {
                                @if (!string.IsNullOrEmpty(Model.RutaJustificacion))
                                {
                                    <div class="mb-3">
                                        <label class="form-label small text-muted mb-1 d-block">Justificación actual</label>
                                        <a target="_blank" href="@Model.RutaJustificacion" class="btn-app-verde btn-tablero-pdf">
                                            <i class="fa-solid fa-download"></i> Ver justificación actual
                                        </a>
                                        <p class="text-muted small mt-2 mb-0">
                                            <i class="fa-solid fa-circle-info me-1"></i>
                                            Si subes un nuevo archivo, reemplazará el actual
                                        </p>
                                    </div>
                                }

                                <label for="inputJustificacion" class="form-label small text-muted mb-1">
                                    @(!string.IsNullOrEmpty(Model.RutaJustificacion) ? "Reemplazar justificación (opcional)" : "Subir justificación")
                                </label>
                                <p class="text-muted small mb-2">Favor de descargar el Formato de Justificación y subirlo en PDF debidamente requisitado y firmado.</p>
                                <a target="_blank" href="@Url.Content("~/FormatoEvidencia/JUSTIFICACION.xlsx")" download="JUSTIFICACION.xlsx" class="btn-app-verde btn-tablero-pdf mb-2">
                                    <i class="fa-solid fa-file-arrow-down"></i> Descargar formato
                                </a>
                                <a href="#" id="btnDescargarJustPrellenada" class="btn-app-azul btn-tablero-pdf mb-2 ms-2">
                                    <i class="fa-solid fa-wand-magic-sparkles"></i> Descargar pre-llenada
                                </a>
                                <input type="file"
                                       class="form-control"
                                       id="inputJustificacion"
                                       name="InputJustificacion"
                                       accept=".pdf"
                                       data-tiene-archivo-existente="@(!string.IsNullOrEmpty(Model.RutaJustificacion))">
                            }
                            else
                            {
                                @if (!string.IsNullOrEmpty(Model.RutaJustificacion))
                                {
                                    <label class="form-label small text-muted mb-1 d-block">Justificación subida</label>
                                    <a target="_blank" href="@Model.RutaJustificacion" class="btn-app-verde btn-tablero-pdf">
                                        <i class="fa-solid fa-download"></i> Ver justificación
                                    </a>
                                }
                                else
                                {
                                    <span class="badge-estatus badge-estatus-error">No se ha cargado ninguna justificación</span>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>

            @* Realizó y autorizó *@
            <div class="ficha-seccion">
                <div class="row g-4">
                    <div class="col-md-6 border-end">
                        <div class="ficha-firma">
                            <label class="ficha-firma-label">Realizó</label>
                            <input type="text" class="form-control text-center mb-2" placeholder="Nombre de quien realiza" id="nombreRealiza" name="NombreRealizo" value="@Model.NombreRealizo" @(esSoloVista ? "disabled" : "")>
                            <input type="text" class="form-control text-center" placeholder="Puesto de quien realiza" id="cargoRealiza" name="PuestoRealizo" value="@Model.PuestoRealizo" @(esSoloVista ? "disabled" : "")>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="ficha-firma">
                            <label class="ficha-firma-label">Autorizó</label>
                            <input type="text" class="form-control text-center mb-2" placeholder="Nombre de quien autoriza" id="nombreAutorizo" name="NombreAutorizo" value="@Model.NombreAutorizo" @(esSoloVista ? "disabled" : "")>
                            <input type="text" class="form-control text-center" placeholder="Puesto de quien autoriza" id="cargoAutorizo" name="PuestoAutorizo" value="@Model.PuestoAutorizo" @(esSoloVista ? "disabled" : "")>
                        </div>
                    </div>
                </div>
            </div>

            @* Botones *@
            @if (!esSoloVista)
            {
                <div class="text-center mb-5">
                    <button type="button" class="btn-app-gris mx-2" id="btnGuardarBorrador">
                        <i class="fa-solid fa-floppy-disk"></i> Guardar
                    </button>
                    <button type="button" class="btn-app-rosa mx-2" id="btnEnviarFinal">
                        <i class="fa-solid fa-paper-plane"></i> Enviar
                    </button>
                </div>
            }

        </form>
    </div>
}
@section Scripts {
    <script>
        $(document).ready(function () {
            const formElement = $('form')[0];
            // URL única que apunta a la acción del controlador
            const urlAccion = '@Url.Action("GuardarActualizacion", "Monitoreo")';

            // =======================================================
            // FORMATO DE MILES AUTOMÁTICO CON CLASE "formato-miles"
            // =======================================================

            // Función para formatear números con comas
            function formatearConComas(numero) {
                return numero.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
            }

            // Función para remover formato (comas)
            function removerFormato(valor) {
                return valor.replace(/,/g, '');
            }

            // Aplicar formato a todos los inputs con la clase "formato-miles"
            $('.formato-miles').each(function() {
                // Formatear el valor inicial si existe
                let valorInicial = $(this).val();
                if (valorInicial && valorInicial !== '0') {
                    let numeroLimpio = removerFormato(valorInicial);
                    if (!isNaN(numeroLimpio) && numeroLimpio !== '') {
                        $(this).val(formatearConComas(numeroLimpio));
                    }
                }
            });

            // Evento al escribir en campos con formato de miles
            $('.formato-miles').on('input', function() {
                let valor = $(this).val();
                let valorLimpio = removerFormato(valor);

                // Solo permitir números
                if (!/^\d*$/.test(valorLimpio)) {
                    valorLimpio = valorLimpio.replace(/\D/g, '');
                }

                // Aplicar formato si hay un número válido
                if (valorLimpio !== '') {
                    let cursorPos = this.selectionStart;
                    let longitudAnterior = valor.length;

                    $(this).val(formatearConComas(valorLimpio));

                    // Ajustar posición del cursor
                    let longitudNueva = $(this).val().length;
                    let diferencia = longitudNueva - longitudAnterior;
                    this.setSelectionRange(cursorPos + diferencia, cursorPos + diferencia);
                } else {
                    $(this).val('');
                }

                // Guardar el valor sin formato en un atributo data
                $(this).attr('data-valor-real', valorLimpio);
            });

            // También limpiar formato antes de envíos AJAX
            function prepararFormularioParaEnvio() {
                $('.formato-miles').each(function() {
                    let valorReal = $(this).attr('data-valor-real') || removerFormato($(this).val());
                    $(this).val(valorReal);
                });
            }

            // Restaurar formato después de envío AJAX
            function restaurarFormatoVisual() {
                $('.formato-miles').each(function() {
                    let valor = $(this).val();
                    if (valor && valor !== '' && valor !== '0') {
                        $(this).val(formatearConComas(valor));
                    }
                });
            }

            // =======================================================
            // FUNCIÓN CENTRAL: ENVÍO DEL FORMULARIO VÍA AJAX
            // =======================================================
            function enviarFormulario(esBorrador) {

                // Si es envío final, validamos los campos obligatorios dinámicos (evidencia/justificación)
                if (!esBorrador) {
                    const evidenciaOk = !$('#inputEvidencia').prop('required') || $('#inputEvidencia')[0]?.files?.length > 0;
                    const justificacionOk = !$('#inputJustificacion').prop('required') || $('#inputJustificacion')[0]?.files?.length > 0;

                    const campos = [
                        { label: 'Evidencia', campoId: 'inputEvidencia', valido: evidenciaOk },
                        { label: 'Justificación', campoId: 'inputJustificacion', valido: justificacionOk }
                    ];

                    if (!validarCamposRequeridos(campos)) return;
                }

                var mensajeConfirmacion = esBorrador
                    ? 'Se guardará esta información como borrador.'
                    : 'Se enviará esta información para su revisión. Ya no podrá editarla.';

                confirmarGuardado(mensajeConfirmacion).then(function (confirmado) {
                    if (!confirmado) return;

                    prepararFormularioParaEnvio();

                    const formData = new FormData(formElement);
                    // 1. Añade el indicador de si es borrador (true) o envío final (false)
                    formData.append('EsBorrador', esBorrador);

                    // 2. Agrega el token de Anti-Forgery
                    const antiforgeryToken = $('input[name="__RequestVerificationToken"]').val();
                    if (antiforgeryToken) {
                        formData.append('__RequestVerificationToken', antiforgeryToken);
                    }

                    $.ajax({
                        url: urlAccion,
                        type: 'POST',
                        data: formData,
                        contentType: false, // Necesario para enviar archivos
                        processData: false, // Necesario para enviar archivos

                        beforeSend: function() {
                             Swal.fire({
                                title: "Procesando...",
                                text: "Por favor, espere.",
                                icon: "info",
                                showConfirmButton: false, // Oculta el botón OK
                                allowOutsideClick: false, // No permite cerrar haciendo clic fuera
                                allowEscapeKey: false // No permite cerrar con la tecla Escape
                            });
                        },
                        success: function(response) {
                            Swal.close();
                            restaurarFormatoVisual();
                            if (response.success) {
                                Toast.fire({ icon: 'success', title: response.message || 'Guardado correctamente' })
                                    .then(() => {
                                        window.location.href = response.redirectTo;
                                    });
                            } else {
                                Swal.fire("Error", response.message || "Ocurrió un error al procesar la solicitud.", "error");
                            }
                        },
                        error: function(xhr, status, error) {
                            Swal.close();
                            restaurarFormatoVisual();
                            console.error("Error AJAX:", status, error, xhr.responseText);
                            Swal.fire("Error de Conexión", "No se pudo comunicar con el servidor o el servidor devolvió un error.", "error");
                        }
                    });
                });
            }

            // =======================================================
            // MANEJADORES DE CLIC EN BOTONES
            // =======================================================

            // Botón "Guardar" (Borrador)
            $('#btnGuardarBorrador').click(function(e) {
                e.preventDefault();
                enviarFormulario(true);
            });

            // Botón "Enviar" (Final)
            $('#btnEnviarFinal').click(function(e) {
                e.preventDefault();
                enviarFormulario(false); // Es Borrador = FALSE
            });

            // =======================================================
            // LÓGICA DE VALIDACIÓN Y CÁLCULO ORIGINAL
            // =======================================================

            // --- Lógica del campo "Realizado" ---
            $('#realizadoInput').on('input', function() {
                let valorReal = removerFormato($(this).val());
                let meta = parseFloat(removerFormato($('#metaProgramada').val())) || 0;
                let realizado = parseFloat(valorReal) || 0;
                let porcentaje = 0;

                // Cálculo del Porcentaje
                if (meta === 0 && realizado > 0) {
                    $('#totalPorcentaje').val("Sobre-cumplimiento");
                } else if (meta === 0 && realizado === 0) {
                    $('#totalPorcentaje').val("0%");
                } else if (meta > 0) {
                    porcentaje = ((realizado / meta) * 100).toFixed(2);
                    $('#totalPorcentaje').val(porcentaje + '%');
                }

                const esSoloVista = @(esSoloVista.ToString().ToLower());
                // Habilitar/Deshabilitar campos Personas/Rangos
                if(!esSoloVista){
                    if (realizado > 0) {
                        $('.personas-input, .rango-input').prop('disabled', false);
                    } else {
                        $('.personas-input, .rango-input').prop('disabled', true).val('0');
                        $('#personasAtendidas, #totalPersonas').val('0');
                    }
                }
            }).on('blur', function() {
                // --- Lógica de Justificación (al salir del campo) ---
                let meta = parseFloat(removerFormato($('#metaProgramada').val())) || 0;
                let realizado = parseFloat(removerFormato($(this).val())) || 0;
                let porcentaje = 0;

                if (meta > 0 && realizado > 0) {
                    porcentaje = (realizado / meta) * 100;
                }

                // Verificar si ya existen archivos cargados
                const tieneEvidenciaExistente = $('#inputEvidencia').attr('data-tiene-archivo-existente') === 'True';
                const tieneJustificacionExistente = $('#inputJustificacion').attr('data-tiene-archivo-existente') === 'True';

                // Lógica principal de Justificación y Evidencia
                if (realizado == 0) {
                    // 1. Realizado es CERO -> Justificación OBLIGATORIA
                    if (!tieneEvidenciaExistente) {
                        $('#inputEvidencia').prop('required', false).val('');
                    } else {
                        $('#inputEvidencia').prop('required', false);
                    }

                    $('#justificacionDiv').show();

                    // Solo requerir si NO hay archivo existente
                    if (!tieneJustificacionExistente) {
                        $('#inputJustificacion').prop('required', true);
                    }

                } else if (realizado > 0) {
                    // 2. Realizado es MAYOR a CERO -> Evidencia OBLIGATORIA
                    // Solo requerir evidencia si NO hay archivo existente
                    if (!tieneEvidenciaExistente) {
                        $('#inputEvidencia').prop('required', true);
                    } else {
                        $('#inputEvidencia').prop('required', false);
                    }

                    // Si el porcentaje es <= 69.99 (incumplimiento) O >= 110 (sobre-cumplimiento extremo)
                    if (porcentaje <= 69.99 || porcentaje >= 110) {
                        // Requerir Justificación
                        $('#justificacionDiv').show();

                        // Solo requerir si NO hay archivo existente
                        if (!tieneJustificacionExistente) {
                            $('#inputJustificacion').prop('required', true);
                        } else {
                            $('#inputJustificacion').prop('required', false);
                        }
                    } else {
                        // No requerir Justificación
                        $('#justificacionDiv').hide();
                        $('#inputJustificacion').prop('required', false).val('');
                    }
                } else {
                    // 3. Campo vacío
                    $('#justificacionDiv').hide();
                    $('#inputJustificacion').prop('required', false).val('');
                    $('#inputEvidencia').prop('required', false).val('');
                }

                // Lógica de color de porcentaje
                if (porcentaje < 70 || porcentaje >= 110) {
                    $('#totalPorcentaje').removeClass('text-tablero-success').addClass('text-tablero-error');
                } else {
                    $('#totalPorcentaje').removeClass('text-tablero-error').addClass('text-tablero-success');
                }
            });

            // --- Lógica de suma y validación de Personas (Mujeres/Hombres) ---
            $('#mujeresAtendidas, #hombresAtendidos').on('input', function() {
                let mujeres = parseInt(removerFormato($('#mujeresAtendidas').val())) || 0;
                let hombres = parseInt(removerFormato($('#hombresAtendidos').val())) || 0;
                let total = mujeres + hombres;
                let realizado = parseInt(removerFormato($('#realizadoInput').val())) || 0;

                $('#personasAtendidas').val(total).trigger('input');
            });

            // --- Lógica de suma y validación de Rangos de edad ---
            $('.rango-input').on('input', function() {
                let total = 0;
                $('.rango-input').each(function() {
                    total += parseInt(removerFormato($(this).val())) || 0;
                });

                let realizado = parseInt(removerFormato($('#personasAtendidas').val())) || 0;
                $('#totalPersonas').val(total).trigger('input');

                if (total > realizado) {
                    // Mensaje de advertencia y corrección
                    Swal.fire({
                        title: "Advertencia",
                        text: 'El total de personas por edad (' + formatearConComas(total) + ') no puede exceder el realizado: ' + formatearConComas(realizado),
                        icon: "warning"
                    });
                    $(this).val('0');
                    // Recalcular
                    total = 0;
                    $('.rango-input').each(function() {
                        total += parseInt(removerFormato($(this).val())) || 0;
                    });
                    $('#totalPersonas').val(total);
                }
            });

            // --- Lógica de suma y validación de Rangos de edad ---
            $('#indigena').on('input', function() {
                let indigena = parseInt(removerFormato($(this).val())) || 0;
                let realizado = parseInt(removerFormato($('#personasAtendidas').val())) || 0;

                if (indigena > realizado) {
                    $(this).val(realizado).trigger('input');
                    Swal.fire({
                        title: "Advertencia",
                        text: 'Máximo permitido: ' + formatearConComas(realizado) + ' personas',
                        icon: "warning",
                        timer: 2000,
                        showConfirmButton: true
                    });
                }
            });

            $('#realizadoInput').trigger('input').trigger('blur');

            if (parseInt(removerFormato($('#mujeresAtendidas').val())) > 0 || parseInt(removerFormato($('#hombresAtendidos').val())) > 0) {
                $('#mujeresAtendidas').trigger('input');
            }
            if (parseInt(removerFormato($('.rango-input:first').val())) > 0) {
                $('.rango-input:first').trigger('input');
            }
            });

            // --- Descargar justificación pre-llenada (ExcelJS + FileSaver) ---
            const mesesJust = ['ENERO','FEBRERO','MARZO','ABRIL','MAYO','JUNIO','JULIO','AGOSTO','SEPTIEMBRE','OCTUBRE','NOVIEMBRE','DICIEMBRE'];
            $('#btnDescargarJustPrellenada').on('click', async function (e) {
                e.preventDefault();
                try {
                    const [respDatos, respTpl] = await Promise.all([
                        fetch('@Url.Action("ObtenerDatosJustificacion", "Monitoreo")?idProceso=@Model.IdProceso'),
                        fetch('@Url.Content("~/FormatoEvidencia/JUSTIFICACION.xlsx")')
                    ]);
                    if (!respDatos.ok) throw new Error('No se pudieron obtener los datos del registro');
                    if (!respTpl.ok) throw new Error('No se pudo cargar el formato');
                    const datos = await respDatos.json();

                    const buffer = await respTpl.arrayBuffer();
                    const wb = new ExcelJS.Workbook();
                    await wb.xlsx.load(buffer);
                    const ws = wb.getWorksheet(1);
                    const ws2 = wb.getWorksheet(2);

                    // --- Coincidencia con las listas desplegables del template ---
                    function leerOpciones(hoja, formula) {
                        const m = String(formula || '').replace(/\$/g, '').match(/^([A-Z]+)(\d+):([A-Z]+)(\d+)$/);
                        if (!m) return [];
                        const opciones = [];
                        const colA = m[1], filaA = +m[2], colB = m[3], filaB = +m[4];
                        // recorre columnas (A..Z) y filas del rango
                        let col = colA;
                        for (let i = 0; i < 26 && col <= colB; i++, col = nextCol(col)) {
                            for (let f = filaA; f <= filaB; f++) {
                                const v = hoja.getCell(col + f).value;
                                if (v != null && v !== '') opciones.push(String(v));
                            }
                        }
                        return opciones;
                    }
                    function nextCol(c) {
                        let s = c.split('');
                        let i = s.length - 1;
                        while (i >= 0 && s[i] === 'Z') { s[i] = 'A'; i--; }
                        if (i < 0) return null;
                        s[i] = String.fromCharCode(s[i].charCodeAt(0) + 1);
                        return s.join('');
                    }
                    function normalizar(s) {
                        return String(s || '').toLowerCase()
                            .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
                            .replace(/[^a-z0-9]/g, ' ').replace(/\s+/g, ' ').trim();
                    }
                    function tokens(s) { return normalizar(s).split(' ').filter(Boolean); }
                    // Programa (B12): la opción del template que coincida con la clave (E046/E047/Agenda)
                    function matchPrograma(lista, pp) {
                        const clave = normalizar(pp) === 'agenda' ? 'agenda' : normalizar(pp);
                        if (!clave) return null;
                        for (const op of lista) {
                            const n = normalizar(op);
                            if (n === clave || n.startsWith(clave) || (clave === 'agenda' && n.includes('agenda'))) return op;
                        }
                        return null;
                    }
                    // Actividad (B14): filtra por el código "X.Y"/"TX.Y" y decide por la descripción; si no hay código, por descripción
                    function matchActividad(lista, componente, actividad, desc) {
                        const codigos = [];
                        if (componente != null && actividad != null && actividad !== '') {
                            codigos.push(componente + '.' + actividad);
                            codigos.push('T' + componente + '.' + actividad);
                        }
                        const descTok = tokens(desc);
                        let mejores = new Map();
                        if (codigos.length) {
                            for (const op of lista) {
                                const n = normalizar(op);
                                for (const cd of codigos) {
                                    if (!n.startsWith(cd)) continue;
                                    const sinPref = normalizar(op).substring(normalizar(cd).length).split(' ').filter(Boolean);
                                    const comunes = descTok.filter(t => sinPref.includes(t)).length;
                                    if (!mejores.has(cd) || comunes > mejores.get(cd).score) {
                                        mejores.set(cd, { op, score: comunes });
                                    }
                                }
                            }
                            let mejorCd = null, mejorSc = -1;
                            mejores.forEach((o, cd) => { if (o.score > mejorSc) { mejorSc = o.score; mejorCd = o; } });
                            if (mejorCd) return mejorCd.op;
                        }
                        if (descTok.length) {
                            let mejor = null, mejorSc = -1;
                            for (const op of lista) {
                                const comunes = descTok.filter(t => tokens(op).includes(t)).length;
                                if (comunes > mejorSc) { mejorSc = comunes; mejor = op; }
                            }
                            if (mejorSc > 0) return mejor;
                        }
                        return null;
                    }

                    // Componente (B13): según el programa, el número de componente se ubica distinto en la lista
                    function matchComponente(lista, pp, componente) {
                        const npp = normalizar(pp);
                        if (!npp || componente == null) return null;
                        const comp = String(componente).toLowerCase();
                        for (const op of lista) {
                            const n = normalizar(op);
                            if (npp.includes('agenda')) {
                                if (n.startsWith('t' + comp + ' ')) return op;         // T1..T5
                            } else if (npp === 'e046') {
                                if (n.startsWith(comp + ' ') && !n.includes('apoyos y servicios')) return op;  // 1./2.
                            } else if (npp === 'e047') {
                                if (n.startsWith(comp + ' ') && n.includes('apoyos y servicios')) return op;   // 1..7
                            }
                        }
                        return null;
                    }

                    // Leer las opciones de Programa (B12), Componente (B13) y Actividad (B14) desde el template
                    const opProg = leerOpciones(ws, ws.getCell('B12').dataValidation && ws.getCell('B12').dataValidation.formulae[0]);
                    const opComp = leerOpciones(ws, ws.getCell('B13').dataValidation && ws.getCell('B13').dataValidation.formulae[0]);
                    const opActiv = leerOpciones(ws, ws.getCell('B14').dataValidation && ws.getCell('B14').dataValidation.formulae[0]);

                    const ppSistema = datos.pp || '';

                    // Programa (B12)
                    let progFinal = ppSistema;
                    const mProg = matchPrograma(opProg, ppSistema);
                    if (mProg) progFinal = mProg;

                    // Componente (B13)
                    let compFinal = (datos.componente != null && datos.componente !== '') ? datos.componente : '';
                    const mComp = matchComponente(opComp, ppSistema, datos.componente);
                    if (mComp) compFinal = mComp;

                    // Actividad (B14)
                    let activFinal = (datos.actividad != null && datos.actividad !== '') ? datos.actividad + ' ' + (datos.descripcionActividad || '') : (datos.descripcionActividad || '');
                    const mAct = matchActividad(opActiv, datos.componente, datos.actividad, datos.descripcionActividad);
                    if (mAct) activFinal = mAct;

                    const ahora = new Date();
                    const mesActual = mesesJust[ahora.getMonth()] || '';
                    const mesJust = mesesJust[@Model.MesNum - 1] || '';

                    const campos = {
                        'B7': ahora.getDate(),
                        'B8': mesActual,
                        'B9': ahora.getFullYear(),
                        'B11': mesJust,
                        'B12': progFinal,
                        'B13': compFinal,
                        'B14': activFinal,
                        'B16': datos.nombreRealizo,
                        'B17': datos.cargoRealizo,
                        'B18': datos.nombreValido,
                        'B19': datos.cargoValido
                    };

                    for (const ref in campos) {
                        const val = campos[ref];
                        if (val !== '' && val !== undefined && val !== null) {
                            ws.getCell(ref).value = val;
                        }
                    }

                    // --- Personalización del archivo descargado (solo el que se descarga) ---
                    ws.name = 'EDITABLE';
                    ws2.name = 'DOC. IMPRIMIR';

                    // Fila de firmas: mayor altura y ajuste de texto
                    const firmasOpt = { wrapText: true, vertical: 'middle', horizontal: 'center' };
                    for (const ref of ['B35', 'C35', 'E35', 'F35', 'B36', 'C36', 'E36', 'F36']) {
                        ws2.getCell(ref).alignment = firmasOpt;
                    }
                    ws2.getRow(35).height = 40;
                    ws2.getRow(36).height = 40;

                    // Actualizar todas las referencias de fórmula al nuevo nombre de hoja (evita aviso de reparación)
                    ws2.eachRow((fila) => {
                        fila.eachCell((celda) => {
                            const val = celda.value;
                            if (val && typeof val === 'object' && val.formula && String(val.formula).includes('Hoja1!')) {
                                const nueva = String(val.formula).replace(/Hoja1!/g, 'EDITABLE!');
                                celda.value = { formula: nueva, result: val.result };
                            }
                        });
                    });

                    // Proteger la hoja de impresión (no editable)
                    ws2.protect('', { selectLockedCells: true, selectUnlockedCells: true });

                    const out = await wb.xlsx.writeBuffer();
                    const blob = new Blob([out], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
                    saveAs(blob, 'JUSTIFICACION_prellenada.xlsx');
                } catch (err) {
                    console.error(err);
                    Swal.fire('Error', 'No se pudo generar la justificación pre-llenada.', 'error');
                }
            });
    </script>
}
